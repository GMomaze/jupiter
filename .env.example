# Server
PORT=32000
NODE_ENV=development

# Application Role (Strictly for DML: SELECT, INSERT, limited UPDATE)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jupiter_db
DB_USER=jupiter_app
DB_PASSWORD=gmo

# Admin Role (For DDL: Migrations/Schema Changes)
DB_ADMIN_USER=jupiter_admin
DB_ADMIN_PASSWORD=gmo

# Unified migration authority (operator supplied; never application credentials)
DB_MIGRATION_HOST=127.0.0.1
DB_MIGRATION_PORT=5432
DB_MIGRATION_NAME=jupiter_db
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=<operator-supplied>
# Set only for an explicitly authorised migration invocation.
ALLOW_UNIFIED_DATABASE_MIGRATION=NO
# Separate explicit approval for destructive jupiter_test preparation.
ALLOW_TEST_DATABASE_PREPARATION=NO

# Tenant switching (operator supplied; minimum 32 UTF-8 bytes, never client-exposed)
TENANT_SWITCH_TOKEN_SECRET=<operator-supplied-minimum-32-bytes>

# Service Bulletin Sync
SB_SYNC_CRON_ENABLED=false
SB_SYNC_RUN_ON_BOOT=false
# MP2-R2 production safety (use absolute roots in production)
TRUST_PROXY=1
OPERATIONAL_EVENT_HMAC_KEY=
AIRCRAFT_UPLOAD_ROOT=
MANUFACTURER_UPLOAD_ROOT=
MANUFACTURER_QUARANTINE_ROOT=
SB_IMPORT_QUARANTINE_ROOT=
SB_IMPORT_EPHEMERAL_ROOT=

# Email delivery (SMTP) — required for invitation emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Jupiter

# Public application base URL used to construct invitation acceptance links
APP_BASE_URL=http://localhost:32000

# System Owner operational notification recipient (delivery only; grants no authority)
# Optional override for onboarding-completed notifications. When unset, the
# canonical System Owner identity email is used instead.
SYSTEM_OWNER_NOTIFICATION_EMAIL=
