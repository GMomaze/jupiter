{
  "name": "jupiter",
  "version": "1.0.0",
  "description": "Jupiter Maintenance Management System",
  "type": "module",
  "main": "index.js",
  "scripts": {
  "dev": "tsx watch src/server.ts",
  "start": "tsx src/server.ts",
  "lint": "eslint . --ext .ts",
  "format:check": "prettier --check \"src/**/*.ts\"",
  "test": "cross-env NODE_ENV=test vitest run",
  "test:e2e": "playwright test",
  "build": "tsc",

  "db:migrate": "npx sequelize-cli db:migrate",
  "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
  "db:seed": "npx sequelize-cli db:seed:all",

  "ai": "aider",
  "ai:smart": "aider --model gpt-4o",
  "ai:fast": "aider --model gemini/gemini-2.5-pro",
  "ai:cheap": "aider --model gemini/gemini-2.5-flash",
  "tailwind:build": "tailwindcss -i ./src/tailwind/input.css -o ./public/css/styles.css --watch"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@types/multer": "^2.1.0",
    "argon2": "^0.44.0",
    "connect-flash": "^0.1.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.2.4",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "htmx.org": "^2.0.8",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.17.2",
    "pdfreader": "^3.0.8",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^24.37.2",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.4",
    "@types/connect-flash": "^0.0.40",
    "@types/cookie-parser": "^1.4.10",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.2.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.16.0",
    "@types/sequelize": "^6.12.0",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^9.39.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}