<div class="flex items-center justify-center gap-2">
  <% if (component.status === 'SERVICEABLE') { %>
    <form hx-post="/inventory/install/<%= component.id %>" 
          hx-target="closest main" 
          hx-swap="innerHTML"
          class="flex items-center gap-1">
      
      <select name="aircraft_id" required 
              class="text-[10px] border-slate-300 rounded p-1 bg-white focus:ring-1 focus:ring-blue-500 outline-none">
        <option value="" disabled selected>Select AC</option>
        <% aircraft.forEach(ac => { %>
          <option value="<%= ac.id %>"><%= ac.registration %></option>
        <% }) %>
      </select>

      <button type="submit" 
              class="bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-bold py-1 px-2 rounded transition-colors shadow-sm">
        ON-UNIT
      </button>
    </form>

  <% } else if (component.status === 'INSTALLED') { %>
    <button hx-post="/inventory/remove/<%= component.id %>" 
            hx-target="closest main" 
            hx-swap="innerHTML"
            hx-confirm="Are you sure you want to remove serial <%= component.serial_number %> to inventory?"
            class="bg-slate-100 hover:bg-red-100 hover:text-red-700 text-slate-600 text-[10px] font-bold py-1 px-3 rounded border border-slate-200 transition-all">
      OFF-UNIT
    </button>

  <% } else { %>
    <span class="text-[10px] text-slate-400 italic">No Actions</span>
  <% } %>
</div>