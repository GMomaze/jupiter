</footer>

<script>
let inactivityTimer;

function resetTimer() {
    clearTimeout(inactivityTimer);
    inactivityTimer = setTimeout(() => {
        window.location.href = '/logout';
    }, 30 * 60 * 1000); // 30 min
}

['click','mousemove','keydown'].forEach(evt =>
    document.addEventListener(evt, resetTimer)
);

resetTimer();
</script>

</body>
</html>
