<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jupiter Maintenance System</title>

    <!-- Tailwind CSS (LOCAL BUILD) -->
    <link rel="stylesheet" href="/css/styles.css">

    <!-- HTMX LOCAL -->
    <script src="/js/htmx.min.js"></script>

</head>

<body
    class="m-0 bg-gray-100"
    style="margin: 0; padding-top: <%= remoteTestMode ? '7rem' : '4.5rem' %>;"
    hx-headers='{"x-csrf-token":"<%= csrfToken %>"}'
>

<div
    class="z-50"
    style="position: fixed; top: 0; left: 0; right: 0; width: 100vw;"
>
    <% if (remoteTestMode) { %>
        <div class="bg-amber-500 text-slate-950 text-center text-xs font-bold uppercase tracking-[0.25em] py-2">
            Remote Test Mode
        </div>
    <% } %>

    <nav
        class="bg-slate-800 text-white p-4 shadow-lg"
        style="display: block; width: 100vw; margin: 0;"
    >
        <div class="max-w-7xl mx-auto flex justify-between items-center">

            <!-- LEFT SIDE -->
            <div class="flex items-center space-x-8">
                <a href="/" class="font-black text-xl tracking-tighter uppercase hover:text-slate-300">
                    Jupiter
                </a>

                <div class="flex items-center gap-6 text-xs font-bold uppercase tracking-widest">
                    <a href="/library" class="hover:text-slate-300">Library</a>
                    <div class="relative group">
                        <a
                            href="/compliance-maintenance-data"
                            class="uppercase tracking-widest hover:text-slate-300 focus:outline-none focus:text-slate-300"
                            aria-haspopup="true"
                        >
                            Compliance / Maintenance Data
                        </a>
                        <div
                            class="absolute left-0 top-full hidden min-w-72 pt-3 text-left normal-case tracking-normal group-hover:block group-focus-within:block"
                        >
                            <div class="rounded border border-slate-700 bg-slate-900 py-2 text-xs font-semibold uppercase tracking-widest shadow-xl">
                                <a href="/library/ads" class="block px-4 py-2 text-white hover:bg-slate-800 hover:text-slate-200">
                                    Airworthiness Directives
                                </a>
                                <a href="/library/sbs" class="block px-4 py-2 text-white hover:bg-slate-800 hover:text-slate-200">
                                    Service Bulletins / Letters / Instructions
                                </a>
                                <a href="/library/sids" class="block px-4 py-2 text-white hover:bg-slate-800 hover:text-slate-200">
                                    Supplemental Inspection Documents
                                </a>
                                <a href="/library/tasks" class="block px-4 py-2 text-white hover:bg-slate-800 hover:text-slate-200">
                                    Standard Tasks / Maintenance Requirements
                                </a>
                                <a href="/library/sbs/import-issues/unallocated-models" class="block px-4 py-2 text-white hover:bg-slate-800 hover:text-slate-200">
                                    Applicability / Allocations
                                </a>
                            </div>
                        </div>
                    </div>
                    <a href="/aircraft" class="hover:text-slate-300">Fleet</a>
                    <a href="/customers" class="hover:text-slate-300">Customers</a>
                    <a href="/workpacks" class="hover:text-slate-300">Workpacks</a>
                </div>
            </div>

            <!-- RIGHT SIDE (User + Logout) -->
            <% if (user) { %>
                <div class="flex items-center space-x-4 text-xs uppercase tracking-widest">

                    <span class="text-slate-300">
                        <%= user.full_name || user.email %>
                    </span>

                    <form method="POST" action="/auth/logout">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button
                            type="submit"
                            class="bg-slate-700 hover:bg-slate-600 text-white px-3 py-1 rounded transition duration-200"
                        >
                            Logout
                        </button>
                    </form>

                </div>
            <% } %>

        </div>
    </nav>
</div>
