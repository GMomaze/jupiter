<%
  const isMechanic = user?.roles?.some(role => role.code === 'MECHANIC');
  const isEngineer = user?.roles?.some(role => role.code === 'ENGINEER');
  const packIsExecutable = pack?.WorkpackStatus?.code === 'ISSUED' || pack?.WorkpackStatus?.code === 'IN_PROGRESS';
  const taskEditable = !['CERTIFIED_BY_ENGINEER', 'LOCKED'].includes(task.status);
  const canEditMeasurements = isMechanic && packIsExecutable && task.status === 'IN_PROGRESS';
  const escapeHtml = (value) =>
    String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  const measurementLabels = [];
  const renderedDescription = escapeHtml(task.description || '').replace(/\[([^\]]*)\]/g, (_, rawLabel) => {
    const label = String(rawLabel || '').trim() || `Value ${measurementLabels.length + 1}`;
    const fieldKey = `field_${measurementLabels.length}`;
    measurementLabels.push(label);

    if (!canEditMeasurements) {
      return `[${escapeHtml(label)}]`;
    }

    return `<span class="inline-flex items-center mx-1 align-middle">
      <span>[</span>
      <input
        type="text"
        data-task-id="${task.id}"
        data-field-key="${fieldKey}"
        data-field-label="${escapeHtml(label)}"
        class="measurement-input w-24 border-b border-slate-400 bg-transparent px-1 text-center text-sm text-slate-700 outline-none"
        placeholder="${escapeHtml(label)}"
      >
      <span>]</span>
    </span>`;
  });
%>

<div
  class="bg-white border rounded-xl p-6 shadow-sm flex justify-between items-center"
  id="task-<%= task.id %>"
>
  <div class="flex-1 pr-6">
    <div class="flex items-center gap-3 mb-1">
      <span class="text-xs font-mono px-2 py-0.5 bg-slate-100 rounded text-slate-600">
        ID: <%= task.id.slice(0, 8) %>
      </span>
      <h3 class="font-bold text-lg text-slate-800">
        <%= task.title %>
      </h3>
    </div>
    <p class="text-slate-600 text-sm whitespace-pre-wrap">
      <%- renderedDescription %>
    </p>

    <% if (task.Assignee) { %>
      <div class="mt-3 inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
        <span>Assigned To</span>
        <span><%= task.Assignee.full_name || task.Assignee.email %></span>
      </div>
    <% } %>

    <% if (task.status === 'IN_PROGRESS') { %>
      <div class="mt-3 text-xs font-bold uppercase tracking-wide text-purple-700">
        Task in progress
      </div>
    <% } %>

    <% if (task.status === 'COMPLETED_BY_MECHANIC') { %>
      <div class="mt-3 text-xs font-bold uppercase tracking-wide text-amber-700">
        Mechanic completion recorded
      </div>
    <% } %>

    <% if (task.MechanicCompleter) { %>
      <div class="mt-2 text-xs text-slate-500">
        Completed By <span class="font-semibold text-slate-700"><%= task.MechanicCompleter.full_name || task.MechanicCompleter.email %></span>
      </div>
    <% } %>

    <% if (task.EngineerCertifier) { %>
      <div class="mt-2 text-xs text-slate-500">
        Certified By <span class="font-semibold text-slate-700"><%= task.EngineerCertifier.full_name || task.EngineerCertifier.email %></span>
      </div>
    <% } %>

    <% if (isMechanic && packIsExecutable && task.status === 'IN_PROGRESS') { %>
      <form
        method="POST"
        action="/workpacks/tasks/<%= task.id %>/work-note"
        hx-post="/workpacks/tasks/<%= task.id %>/work-note"
        hx-target="#task-<%= task.id %>"
        hx-swap="outerHTML"
        hx-headers='{"x-csrf-token":"<%= csrfToken %>"}'
        hx-on::after-request="if (event.detail.successful) window.location.reload()"
        class="mt-4"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <textarea
          id="payload-<%= task.id %>"
          name="work_performed"
          class="hidden"
        ><%= task.work_performed || '' %></textarea>
        <textarea
          id="measurements-payload-<%= task.id %>"
          name="measurements_payload"
          class="hidden"
        ></textarea>
        <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">
          Work Performed
        </label>
        <textarea
          id="note-<%= task.id %>"
          rows="3"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700"
          placeholder="Record what was done on this task..."
        ><%= task.work_performed || '' %></textarea>
        <div class="mt-2">
          <button
            type="submit"
            class="bg-slate-200 text-slate-800 px-3 py-2 rounded font-bold text-sm hover:bg-slate-300"
          >
            Save Work Note
          </button>
        </div>
      </form>
    <% } else if (task.work_performed) { %>
      <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-3">
        <p class="text-xs font-bold uppercase tracking-wide text-slate-500 mb-1">
          Work Performed
        </p>
        <p class="text-sm text-slate-700 whitespace-pre-line"><%= task.work_performed %></p>
      </div>
    <% } %>
  </div>

  <div class="flex items-center gap-4">
    <div class="text-right mr-4">
      <p class="text-[10px] uppercase text-slate-400 font-bold">
        Status
      </p>

      <%- include('../partials/status-badge', { status: task.status }) %>
    </div>

    <div>
      <% if (
        packIsExecutable &&
        isMechanic &&
        task.status === 'OPEN'
      ) { %>
        <form
          method="POST"
          action="/workpacks/tasks/<%= task.id %>/start"
          hx-post="/workpacks/tasks/<%= task.id %>/start"
          hx-target="#task-<%= task.id %>"
          hx-swap="outerHTML"
          hx-confirm="Start this task?"
          hx-headers='{"x-csrf-token":"<%= csrfToken %>"}'
          hx-on::after-request="if (event.detail.successful) window.location.reload()"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button
            type="submit"
            hx-disabled-elt="this"
            class="bg-amber-600 text-white px-4 py-2 rounded font-bold hover:bg-amber-700"
          >
            Start Task
          </button>
        </form>

      <% } else if (
        packIsExecutable &&
        isMechanic &&
        task.status === 'IN_PROGRESS'
      ) { %>
        <form
          method="POST"
          action="/workpacks/tasks/<%= task.id %>/complete"
          hx-post="/workpacks/tasks/<%= task.id %>/complete"
          hx-target="#task-<%= task.id %>"
          hx-swap="outerHTML"
          hx-confirm="Mark this task completed?"
          hx-headers='{"x-csrf-token":"<%= csrfToken %>"}'
          hx-on::after-request="if (event.detail.successful) window.location.reload()"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <textarea
            id="complete-payload-<%= task.id %>"
            name="work_performed"
            class="hidden"
          ><%= task.work_performed || '' %></textarea>
          <textarea
            id="complete-measurements-payload-<%= task.id %>"
            name="measurements_payload"
            class="hidden"
          ></textarea>
          <button
            type="submit"
            hx-disabled-elt="this"
            class="bg-slate-900 text-white px-4 py-2 rounded font-bold hover:bg-black"
          >
            Complete Task
          </button>
        </form>

      <% } else if (
        packIsExecutable &&
        isEngineer &&
        task.status === 'COMPLETED_BY_MECHANIC'
      ) { %>
        <form
          method="POST"
          action="/workpacks/tasks/<%= task.id %>/sign"
          hx-post="/workpacks/tasks/<%= task.id %>/sign"
          hx-target="#task-<%= task.id %>"
          hx-swap="outerHTML"
          hx-confirm="Certify this completed task?"
          hx-headers='{"x-csrf-token":"<%= csrfToken %>"}'
          hx-on::after-request="if (event.detail.successful) window.location.reload()"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button
            type="submit"
            hx-disabled-elt="this"
            class="bg-emerald-700 text-white px-4 py-2 rounded font-bold hover:bg-emerald-800"
          >
            Certify Task
          </button>
        </form>

      <% } else if (task.status === 'COMPLETED_BY_MECHANIC') { %>
        <span class="text-xs text-amber-600 font-bold uppercase">
          Awaiting Engineer Certification
        </span>

      <% } else if (task.status === 'CERTIFIED_BY_ENGINEER' || task.status === 'LOCKED') { %>
        <div class="text-green-600">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd">
            </path>
          </svg>
        </div>

      <% } else { %>
        <span class="text-xs text-slate-400 font-bold uppercase">
          No Action Available
        </span>
      <% } %>
    </div>
  </div>
</div>

<script>
  (() => {
    if (window.__taskRowMeasurementInit) {
      return;
    }
    window.__taskRowMeasurementInit = true;

    const START_MARKER = '[Captured Values]';
    const END_MARKER = '[/Captured Values]';

    function splitWorkPerformed(rawValue) {
      const value = (rawValue || '').trim();
      const start = value.indexOf(START_MARKER);
      const end = value.indexOf(END_MARKER);

      if (start === -1 || end === -1 || end < start) {
        return { captured: '', note: value };
      }

      const captured = value.slice(start + START_MARKER.length, end).trim();
      const before = value.slice(0, start).trim();
      const after = value.slice(end + END_MARKER.length).trim();
      const note = [before, after].filter(Boolean).join('\n\n').trim();

      return { captured, note };
    }

    function buildCapturedValues(taskId) {
      return Array.from(document.querySelectorAll(`.measurement-input[data-task-id="${taskId}"]`))
        .map((input) => {
          const label = input.dataset.fieldLabel?.trim();
          const value = input.value.trim();
          if (!label || !value) return '';
          return `${label}: ${value}`;
        })
        .filter(Boolean)
        .join('\n');
    }

    function buildStructuredMeasurementPayload(taskId) {
      return Array.from(document.querySelectorAll(`.measurement-input[data-task-id="${taskId}"]`))
        .map((input, index) => {
          const fieldKey = input.dataset.fieldKey?.trim() || `field_${index}`;
          const fieldLabel = input.dataset.fieldLabel?.trim() || `Value ${index + 1}`;
          const value = input.value.trim();

          return {
            field_key: fieldKey,
            field_label: fieldLabel,
            position: index + 1,
            value: value || null,
          };
        });
    }

    function syncTaskPayload(taskId) {
      const payload = document.getElementById(`payload-${taskId}`);
      const completionPayload = document.getElementById(`complete-payload-${taskId}`);
      const measurementPayload = document.getElementById(`measurements-payload-${taskId}`);
      const completionMeasurementPayload = document.getElementById(`complete-measurements-payload-${taskId}`);
      const noteEditor = document.getElementById(`note-${taskId}`);
      if ((!payload && !completionPayload && !measurementPayload && !completionMeasurementPayload) || !noteEditor) return;

      const captured = buildCapturedValues(taskId);
      const structuredMeasurements = buildStructuredMeasurementPayload(taskId);
      const note = noteEditor.value.trim();

      const nextValue = captured
        ? `${START_MARKER}\n${captured}\n${END_MARKER}${note ? `\n\n${note}` : ''}`
        : note;

      if (payload) {
        payload.value = nextValue;
      }

      if (completionPayload) {
        completionPayload.value = nextValue;
      }

      if (measurementPayload) {
        measurementPayload.value = JSON.stringify(structuredMeasurements);
      }

      if (completionMeasurementPayload) {
        completionMeasurementPayload.value = JSON.stringify(structuredMeasurements);
      }
    }

    function initialiseTask(taskId) {
      const payload = document.getElementById(`payload-${taskId}`);
      const completionPayload = document.getElementById(`complete-payload-${taskId}`);
      const noteEditor = document.getElementById(`note-${taskId}`);
      const sourcePayload = payload || completionPayload;
      if (!sourcePayload || !noteEditor) return;

      const parsed = splitWorkPerformed(sourcePayload.value);
      if (!noteEditor.value.trim()) {
        noteEditor.value = parsed.note;
      }

      syncTaskPayload(taskId);
    }

    function initialiseAllTasks() {
      document.querySelectorAll('[id^="note-"]').forEach((noteEditor) => {
        const taskId = noteEditor.id.replace('note-', '');
        if (taskId) {
          initialiseTask(taskId);
        }
      });
    }

    initialiseAllTasks();

    document.addEventListener('input', (e) => {
      if (e.target.classList.contains('measurement-input')) {
        syncTaskPayload(e.target.dataset.taskId);
        return;
      }

      if (e.target.id?.startsWith('note-')) {
        syncTaskPayload(e.target.id.replace('note-', ''));
      }
    });

    document.body.addEventListener('htmx:afterSwap', () => {
      initialiseAllTasks();
    });
  })();
</script>
