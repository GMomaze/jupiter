<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto bg-[#0f172a] py-10 px-4 sm:px-6 lg:px-8">
    <% const safeMetrics = typeof metrics !== 'undefined' ? metrics : {}; %>
    <% const summaryCards = [
      {
        key: 'totalAircraft',
        label: 'Total Aircraft',
        helper: 'Fleet',
      },
      {
        key: 'activeAircraft',
        label: 'Active Aircraft',
        helper: 'Operational',
      },
      {
        key: 'openWorkpacks',
        label: 'Open Workpacks',
        helper: 'Control',
      },
      {
        key: 'awaitingCertification',
        label: 'Awaiting Certification',
        helper: 'Engineer Queue',
      },
      {
        key: 'openSnags',
        label: 'Open Snags',
        helper: 'Defects',
      },
      {
        key: 'serializedComponents',
        label: 'Serialized Components',
        helper: 'Component Library',
      },
      {
        key: 'activeCustomers',
        label: 'Active Customers',
        helper: 'Accounts',
      },
    ]; %>
    <% const attentionCards = [
      {
        key: 'openSnags',
        label: 'Open Snags',
        href: '/workpacks',
      },
      {
        key: 'awaitingCertification',
        label: 'Awaiting Certification',
        href: '/workpacks',
      },
      {
        key: 'openWorkpacks',
        label: 'Open Workpacks',
        href: '/workpacks/hangar',
      },
    ]; %>
    <% const coreLinks = [
      {
        href: '/aircraft',
        eyebrow: 'Fleet',
        title: 'Aircraft',
        subtitle: 'Aircraft register and technical views',
      },
      {
        href: '/workpacks',
        eyebrow: 'Workpacks',
        title: 'Operations',
        subtitle: 'Planner, execution, and audit paths',
      },
      {
        href: '/library',
        eyebrow: 'Library',
        title: 'Reference Data',
        subtitle: 'Manufacturers, models, and serialized stock',
      },
    ]; %>
    <% const supportLinks = [
      {
        href: '/service-bulletins',
        title: 'Service Bulletins',
        subtitle: 'Bulletin management and sync visibility',
      },
      {
        href: '/customers',
        title: 'Customers',
        subtitle: 'Customer master records and links',
      },
      {
        href: '/workpacks/hangar',
        title: 'Hangar Floor',
        subtitle: 'Active execution access by role',
      },
    ]; %>

    <section class="overflow-hidden rounded-2xl border border-[#334155] bg-[#1e3a8a] shadow-[0_20px_50px_rgba(0,0,0,0.35)]">
        <div class="grid gap-4 px-5 py-5 lg:grid-cols-[1.25fr_0.75fr] lg:px-6">
            <div class="min-w-0">
                <p class="text-[11px] font-black uppercase tracking-[0.35em] text-[#94a3b8]">
                    Operational Control
                </p>
                <h1 class="mt-2 text-3xl font-black tracking-tight text-[#e2e8f0]">
                    Jupiter Dashboard
                </h1>
            </div>

            <div class="grid gap-2 sm:grid-cols-3">
                <div class="rounded-xl border border-[#334155] bg-[#0f172a] px-4 py-3">
                    <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[#94a3b8]">Status</p>
                    <p class="mt-2 text-sm font-semibold text-[#e2e8f0]">Read Only</p>
                </div>
                <div class="rounded-xl border border-[#334155] bg-[#0f172a] px-4 py-3">
                    <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[#94a3b8]">Scope</p>
                    <p class="mt-2 text-sm font-semibold text-[#e2e8f0]">Fleet + Workpacks</p>
                </div>
                <div class="rounded-xl border border-[#334155] bg-[#0f172a] px-4 py-3">
                    <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[#94a3b8]">Mode</p>
                    <p class="mt-2 text-sm font-semibold text-[#e2e8f0]">Navigation</p>
                </div>
            </div>
        </div>
    </section>

    <% if (typeof metricsWarning === 'string' && metricsWarning) { %>
        <div class="mt-4 rounded-2xl border border-[#334155] bg-[#1f2937] px-4 py-3 text-sm text-[#e2e8f0] shadow-sm">
            <%= metricsWarning %>
        </div>
    <% } %>

    <section class="mt-6">
        <div class="mb-3">
            <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[#94a3b8]">Operational Summary</p>
            <h2 class="mt-1 text-xl font-black tracking-tight text-[#e2e8f0]">Live Counts</h2>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <% summaryCards.forEach((card) => { %>
                <% const rawValue = safeMetrics[card.key]; %>
                <% const hasValue = typeof rawValue === 'number'; %>
                <article class="rounded-2xl border border-[#334155] bg-[#1e293b] p-4 shadow-[0_12px_30px_rgba(0,0,0,0.25)]">
                    <div class="flex items-start justify-between gap-3">
                        <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[#94a3b8]">
                            <%= card.helper %>
                        </p>
                        <% if (!hasValue) { %>
                            <span class="rounded-full border border-[#334155] bg-[#0f172a] px-2 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-[#94a3b8] shadow-sm">
                                Missing
                            </span>
                        <% } %>
                    </div>
                    <p class="mt-3 text-xs font-bold uppercase tracking-[0.25em] text-[#94a3b8]">
                        <%= card.label %>
                    </p>
                    <p class="mt-2 text-4xl font-black tracking-tight text-[#e2e8f0]">
                        <%= hasValue ? rawValue : '-' %>
                    </p>
                </article>
            <% }) %>
        </div>
    </section>

    <section class="mt-6 grid gap-4 xl:grid-cols-[0.78fr_1.22fr]">
        <div class="space-y-4">
            <div class="rounded-2xl border border-[#334155] bg-[#1e293b] p-5 shadow-[0_16px_40px_rgba(0,0,0,0.28)]">
                <div class="mb-4">
                    <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[#94a3b8]">Requires Attention</p>
                    <h2 class="mt-1 text-xl font-black tracking-tight text-[#e2e8f0]">Operational Queue</h2>
                </div>

                <div class="space-y-3">
                    <% attentionCards.forEach((card) => { %>
                        <% const rawValue = safeMetrics[card.key]; %>
                        <% const hasValue = typeof rawValue === 'number'; %>
                        <a href="<%= card.href %>" class="block rounded-2xl border border-[#334155] bg-[#0f172a] px-4 py-4 transition hover:border-[#2563eb] hover:bg-[#152238]">
                            <div class="flex items-center justify-between gap-4">
                                <div>
                                    <p class="text-[11px] font-black uppercase tracking-[0.25em] text-[#94a3b8]"><%= card.label %></p>
                                    <p class="mt-2 text-3xl font-black tracking-tight text-[#e2e8f0]"><%= hasValue ? rawValue : '-' %></p>
                                </div>
                                <span class="text-[10px] font-black uppercase tracking-[0.25em] text-[#94a3b8]">Open</span>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </div>

            <div class="rounded-2xl border border-[#334155] bg-[#1e293b] p-5 shadow-[0_16px_40px_rgba(0,0,0,0.28)]">
                <div class="mb-4">
                    <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[#94a3b8]">System State</p>
                    <h2 class="mt-1 text-xl font-black tracking-tight text-[#e2e8f0]">Board Status</h2>
                </div>

                <div class="grid gap-3 sm:grid-cols-3">
                    <div class="rounded-xl border border-[#334155] bg-[#0f172a] px-4 py-3">
                        <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[#94a3b8]">Access</p>
                        <p class="mt-2 text-sm font-semibold text-[#e2e8f0]">Authenticated</p>
                    </div>
                    <div class="rounded-xl border border-[#334155] bg-[#0f172a] px-4 py-3">
                        <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[#94a3b8]">Behavior</p>
                        <p class="mt-2 text-sm font-semibold text-[#e2e8f0]">Read Only</p>
                    </div>
                    <div class="rounded-xl border border-[#334155] bg-[#0f172a] px-4 py-3">
                        <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[#94a3b8]">Counts</p>
                        <p class="mt-2 text-sm font-semibold text-[#e2e8f0]">Live Records</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-4">
            <div class="rounded-2xl border border-[#334155] bg-[#1e293b] p-5 shadow-[0_16px_40px_rgba(0,0,0,0.28)]">
                <div class="mb-4 flex items-center justify-between gap-4">
                    <div>
                        <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[#94a3b8]">Quick Actions</p>
                        <h2 class="mt-1 text-xl font-black tracking-tight text-[#e2e8f0]">Core Destinations</h2>
                    </div>
                    <div class="rounded-full border border-[#334155] bg-[#0f172a] px-3 py-1 text-[10px] font-black uppercase tracking-[0.25em] text-[#94a3b8]">
                        Preserved
                    </div>
                </div>

                <div class="grid gap-3 md:grid-cols-3">
                    <% coreLinks.forEach((link) => { %>
                        <a href="<%= link.href %>" class="group rounded-2xl border border-[#334155] bg-[#0f172a] p-4 transition hover:border-[#2563eb] hover:bg-[#152238]">
                            <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[#94a3b8] group-hover:text-[#e2e8f0]"><%= link.eyebrow %></p>
                            <h3 class="mt-2 text-lg font-black text-[#e2e8f0]"><%= link.title %></h3>
                            <p class="mt-2 text-sm text-[#94a3b8]"><%= link.subtitle %></p>
                        </a>
                    <% }) %>
                </div>
            </div>

            <div class="rounded-2xl border border-[#334155] bg-[#1e293b] p-5 shadow-[0_16px_40px_rgba(0,0,0,0.28)]">
                <div class="mb-4">
                    <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[#94a3b8]">System Shortcuts</p>
                    <h2 class="mt-1 text-xl font-black tracking-tight text-[#e2e8f0]">Supporting Navigation</h2>
                </div>

                <div class="grid gap-3">
                    <% supportLinks.forEach((link) => { %>
                        <a href="<%= link.href %>" class="flex items-center justify-between rounded-2xl border border-[#334155] bg-[#0f172a] px-4 py-3 transition hover:border-[#2563eb] hover:bg-[#152238]">
                            <div class="min-w-0 pr-4">
                                <p class="text-sm font-bold text-[#e2e8f0]"><%= link.title %></p>
                                <p class="mt-1 text-sm text-[#94a3b8]"><%= link.subtitle %></p>
                            </div>
                            <span class="shrink-0 text-[10px] font-black uppercase tracking-[0.25em] text-[#94a3b8]">Open</span>
                        </a>
                    <% }) %>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('../partials/footer') %>
