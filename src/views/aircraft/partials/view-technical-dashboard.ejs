<section class="mb-8 rounded-2xl border border-[#334155] bg-[#1e293b] p-6 shadow-[0_16px_40px_rgba(0,0,0,0.28)]">
    <% const safeComplianceVisibility = typeof complianceVisibility !== 'undefined' ? complianceVisibility : { summary: {}, items: [] }; %>
    <% const complianceVisibilitySummary = safeComplianceVisibility.summary || {}; %>
    <div class="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
        <div class="max-w-3xl">
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-[#94a3b8]">Aircraft Technical Dashboard</p>
            <h2 class="mt-2 text-2xl font-semibold text-[#e2e8f0]"><%= technicalDashboard.overview?.headline || 'Aircraft technical visibility dashboard' %></h2>
            <p class="mt-2 text-sm text-[#94a3b8]">
                <%= technicalDashboard.explanation || 'Aircraft technical dashboard visibility is derived downstream from aircraft technical status only.' %>
            </p>
            <p class="mt-3 text-sm text-[#94a3b8]"><%= technicalStatus.explanation || 'No technical-status explanation available.' %></p>
        </div>
        <div class="rounded-2xl border border-[#334155] bg-[#0f172a] px-4 py-3 text-sm text-[#e2e8f0]">
            <p class="text-[11px] font-bold uppercase tracking-[0.3em]">Readiness Visibility</p>
            <p class="mt-2 text-lg font-semibold"><%= dashboardSummary.readiness_label || (technicalStatusSummary.readiness_indicator || 'UNKNOWN_VISIBILITY').replace(/_/g, ' ') %></p>
            <p class="mt-2 max-w-sm text-sm leading-6"><%= dashboardSummary.readiness_explanation || technicalStatusSummary.readiness_explanation || 'No readiness explanation available.' %></p>
        </div>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% (technicalDashboard.overview?.cards || []).forEach((card) => { %>
            <article class="rounded-2xl border border-[#334155] bg-[#0f172a] p-4">
                <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-[#94a3b8]"><%= card.label %></p>
                <p class="mt-2 text-2xl font-bold text-[#e2e8f0]"><%= card.value %></p>
                <p class="mt-2 text-sm leading-6 text-[#94a3b8]"><%= card.caption %></p>
            </article>
        <% }) %>
    </div>

    <div class="mt-6 grid gap-4 xl:grid-cols-[1.1fr_0.9fr]">
        <article class="rounded-2xl border border-[#334155] bg-[#0f172a] p-5">
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-[#94a3b8]">Operational Overview</p>
            <p class="mt-3 text-sm leading-6 text-[#94a3b8]"><%= technicalDashboard.overview?.explanation || 'No dashboard overview explanation available.' %></p>
            <div class="mt-4 grid gap-3 md:grid-cols-2">
                <div class="rounded-xl border border-[#334155] bg-[#1e293b] p-4">
                    <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-[#94a3b8]">Attention Items</p>
                    <p class="mt-2 text-2xl font-bold text-[#e2e8f0]"><%= dashboardSummary.attention_count || 0 %></p>
                    <p class="mt-2 text-sm text-[#94a3b8]">Combined due, overdue, unknown, and missing-required contributors currently visible in the dashboard.</p>
                </div>
                <div class="rounded-xl border border-[#334155] bg-[#1e293b] p-4">
                    <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-[#94a3b8]">Legacy Install Rows</p>
                    <p class="mt-2 text-2xl font-bold text-[#e2e8f0]"><%= dashboardSummary.legacy_installed_count || 0 %></p>
                    <p class="mt-2 text-sm text-[#94a3b8]">Existing aircraft component rows considered alongside serialized installation visibility for configuration context.</p>
                </div>
            </div>
        </article>

        <article class="rounded-2xl border border-[#334155] bg-[#0f172a] p-5">
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-[#94a3b8]">Operational Boundary</p>
            <p class="mt-3 text-sm leading-6 text-[#94a3b8]"><%= dashboardSummary.operational_boundary_notice || 'Operational visibility only.' %></p>
            <div class="mt-4 space-y-3">
                <% (technicalDashboard.audit?.source_record_counts || []).forEach((entry) => { %>
                    <div class="flex items-center justify-between gap-4 rounded-xl border border-[#334155] bg-[#1e293b] px-4 py-3 text-sm">
                        <span class="text-[#94a3b8]"><%= entry.label %></span>
                        <span class="font-semibold text-[#e2e8f0]"><%= entry.value %></span>
                    </div>
                <% }) %>
            </div>
        </article>
    </div>

    <div class="mt-6 grid gap-4 xl:grid-cols-2">
        <article class="rounded-2xl border border-[#334155] bg-[#1e293b] p-5">
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-[#94a3b8]">Due Burden Visibility</p>
            <h3 class="mt-2 text-lg font-semibold text-[#e2e8f0]"><%= technicalDashboard.due_burden?.headline || 'Due burden visibility unavailable.' %></h3>
            <p class="mt-2 text-sm leading-6 text-[#94a3b8]"><%= technicalDashboard.due_burden?.explanation || 'No due burden explanation available.' %></p>
            <% if ((technicalDashboard.due_burden?.contributors || []).length > 0) { %>
                <div class="mt-4 space-y-3">
                    <% technicalDashboard.due_burden.contributors.forEach((item) => { %>
                        <div class="rounded-xl border border-[#334155] bg-[#0f172a] p-4">
                            <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                                <div>
                                    <p class="font-semibold text-[#e2e8f0]">
                                        <%= item.manufacturer_name || 'Unknown Manufacturer' %> <%= item.model_name %>
                                    </p>
                                    <p class="mt-1 text-xs uppercase tracking-[0.3em] text-[#94a3b8]">
                                        <%= item.asset_type_code %> | SN <%= item.serial_number %> | <%= item.position || 'Position Not Captured' %>
                                    </p>
                                </div>
                                <span class="rounded-full border border-[#334155] bg-[#1e293b] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.3em] text-[#e2e8f0]">
                                    <%= item.due_state.replace(/_/g, ' ') %>
                                </span>
                            </div>
                            <p class="mt-3 text-sm leading-6 text-[#94a3b8]"><%= item.due_explanation %></p>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="mt-4 rounded-xl border border-dashed border-[#334155] bg-[#0f172a] px-4 py-5 text-sm text-[#94a3b8]">
                    No due or overdue contributors are currently visible in the dashboard.
                </div>
            <% } %>
        </article>

        <article class="rounded-2xl border border-[#334155] bg-[#1e293b] p-5">
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-[#94a3b8]">Unknown Or Missing Visibility</p>
            <h3 class="mt-2 text-lg font-semibold text-[#e2e8f0]"><%= technicalDashboard.unknown_visibility?.headline || 'Unknown visibility unavailable.' %></h3>
            <p class="mt-2 text-sm leading-6 text-[#94a3b8]"><%= technicalDashboard.unknown_visibility?.explanation || 'No unknown-visibility explanation available.' %></p>

            <% if ((technicalDashboard.unknown_visibility?.missing_required_asset_types || []).length > 0) { %>
                <div class="mt-4 rounded-xl border border-[#334155] bg-[#0f172a] p-4">
                    <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-[#94a3b8]">Missing Required Asset-Type Visibility</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <% technicalDashboard.unknown_visibility.missing_required_asset_types.forEach((assetType) => { %>
                            <span class="rounded-full border border-[#334155] bg-[#1e293b] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.3em] text-[#e2e8f0]">
                                <%= assetType.code %> - <%= assetType.label %>
                            </span>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <% if ((technicalDashboard.unknown_visibility?.contributors || []).length > 0) { %>
                <div class="mt-4 space-y-3">
                    <% technicalDashboard.unknown_visibility.contributors.forEach((item) => { %>
                        <div class="rounded-xl border border-[#334155] bg-[#0f172a] p-4">
                            <p class="font-semibold text-[#e2e8f0]">
                                <%= item.manufacturer_name || 'Unknown Manufacturer' %> <%= item.model_name %>
                            </p>
                            <p class="mt-1 text-xs uppercase tracking-[0.3em] text-[#94a3b8]">
                                <%= item.asset_type_code %> | SN <%= item.serial_number %> | <%= item.position || 'Position Not Captured' %>
                            </p>
                            <p class="mt-3 text-sm text-[#94a3b8]">
                                <% if ((item.missing_data || []).length > 0) { %>
                                    Missing Data: <%= item.missing_data.join(', ') %>
                                <% } else { %>
                                    Missing Data: No missing-data labels captured, but the current derived view still marked this contributor as partially unknown.
                                <% } %>
                            </p>
                            <p class="mt-2 text-sm leading-6 text-[#94a3b8]"><%= item.due_explanation %></p>
                        </div>
                    <% }) %>
                </div>
            <% } else if ((technicalDashboard.unknown_visibility?.missing_required_asset_types || []).length === 0) { %>
                <div class="mt-4 rounded-xl border border-dashed border-[#334155] bg-[#0f172a] px-4 py-5 text-sm text-[#94a3b8]">
                    No unknown or missing-data contributors are currently visible in the dashboard.
                </div>
            <% } %>
        </article>
    </div>

    <div class="mt-6 grid gap-4 xl:grid-cols-[1.05fr_0.95fr]">
        <article class="rounded-2xl border border-sky-200 bg-sky-50 p-5">
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-sky-700">Compliance Visibility</p>
            <h3 class="mt-2 text-lg font-semibold text-slate-900"><%= complianceVisibilitySummary.headline || 'Aircraft-level compliance visibility unavailable.' %></h3>
            <p class="mt-2 text-sm leading-6 text-slate-700"><%= safeComplianceVisibility.explanation || 'No aircraft-level compliance visibility explanation is available.' %></p>
            <p class="mt-3 text-sm leading-6 text-slate-700"><%= complianceVisibilitySummary.distinction_notice || 'Compliance visibility remains separate from due urgency and aircraft readiness.' %></p>

            <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                <% (safeComplianceVisibility.overview?.cards || []).forEach((card) => { %>
                    <div class="rounded-xl bg-white p-4">
                        <p class="text-[11px] font-bold uppercase tracking-[0.3em] <%= card.tone === 'rose' ? 'text-rose-700' : card.tone === 'amber' ? 'text-amber-700' : card.tone === 'emerald' ? 'text-emerald-700' : 'text-slate-500' %>"><%= card.label %></p>
                        <p class="mt-2 text-2xl font-bold text-slate-900"><%= card.value %></p>
                        <p class="mt-2 text-sm leading-6 text-slate-600"><%= card.caption %></p>
                    </div>
                <% }) %>
            </div>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-slate-500">Compliance Boundary</p>
            <p class="mt-3 text-sm leading-6 text-slate-700"><%= complianceVisibilitySummary.operational_boundary_notice || 'Compliance visibility only.' %></p>
            <div class="mt-4 space-y-3">
                <% (safeComplianceVisibility.audit?.source_record_counts || []).forEach((entry) => { %>
                    <div class="flex items-center justify-between gap-4 rounded-xl bg-slate-50 px-4 py-3 text-sm">
                        <span class="text-slate-600"><%= entry.label %></span>
                        <span class="font-semibold text-slate-900"><%= entry.value %></span>
                    </div>
                <% }) %>
            </div>
        </article>
    </div>

    <article class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-[0.3em] text-slate-500">Compliance Drilldown</p>
                <h3 class="mt-2 text-lg font-semibold text-slate-900">Installed-component compliance visibility</h3>
                <p class="mt-2 text-sm leading-6 text-slate-700">
                    This drilldown remains read-only and shows bounded applicability, unknown, and unsupported compliance visibility per active serialized component.
                </p>
            </div>
        </div>

        <% if ((safeComplianceVisibility.attention_components || []).length > 0) { %>
            <div class="mt-4 grid gap-4 xl:grid-cols-2">
                <% safeComplianceVisibility.attention_components.forEach((item) => { %>
                    <div class="rounded-2xl border p-4 <%= item.tone === 'rose' ? 'border-rose-200 bg-rose-50' : item.tone === 'amber' ? 'border-amber-200 bg-amber-50' : item.tone === 'emerald' ? 'border-emerald-200 bg-emerald-50' : 'border-slate-200 bg-slate-50' %>">
                        <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                            <div>
                                <p class="font-semibold text-slate-900"><%= item.manufacturer_name || 'Unknown Manufacturer' %> <%= item.model_name %></p>
                                <p class="mt-1 text-xs uppercase tracking-[0.3em] text-slate-500"><%= item.asset_type_code %> | SN <%= item.serial_number %> | <%= item.position || 'Position Not Captured' %></p>
                            </div>
                            <span class="rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-[0.3em] <%= item.tone === 'rose' ? 'bg-rose-100 text-rose-800' : item.tone === 'amber' ? 'bg-amber-100 text-amber-800' : item.tone === 'emerald' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700' %>">
                                <%= item.visibility_state.replace(/_/g, ' ') %>
                            </span>
                        </div>
                        <p class="mt-3 text-sm leading-6 text-slate-700"><%= item.explanation %></p>
                        <div class="mt-4 grid gap-3 md:grid-cols-2">
                            <div class="rounded-xl bg-white p-4 text-sm text-slate-700">
                                <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-slate-500">Applicability</p>
                                <p class="mt-2 font-semibold text-slate-900"><%= item.applicability_summary %></p>
                                <p class="mt-2 text-sm leading-6"><%= item.current_installation_context || 'No active installation context available.' %></p>
                            </div>
                            <div class="rounded-xl bg-white p-4 text-sm text-slate-700">
                                <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-slate-500">Unknown / Unsupported</p>
                                <p class="mt-2 font-semibold text-slate-900"><%= item.unknown_unsupported_summary %></p>
                                <p class="mt-2 text-sm leading-6">
                                    Applicable visibility remains separate from due visibility and separate from readiness visibility for this installed component.
                                </p>
                            </div>
                        </div>
                        <% if ((item.items || []).length > 0) { %>
                            <div class="mt-4 space-y-2">
                                <% item.items.forEach((entry) => { %>
                                    <div class="rounded-xl bg-white p-4 text-sm text-slate-700">
                                        <div class="flex flex-col gap-2 lg:flex-row lg:items-start lg:justify-between">
                                            <div>
                                                <p class="font-semibold text-slate-900"><%= entry.reference %></p>
                                                <p class="mt-1 text-sm text-slate-600"><%= entry.title %></p>
                                            </div>
                                            <span class="rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-[0.3em] <%= entry.applicability === 'APPLICABLE' ? 'bg-emerald-100 text-emerald-800' : entry.applicability === 'NOT_APPLICABLE' ? 'bg-slate-100 text-slate-700' : entry.applicability === 'UNKNOWN' ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800' %>">
                                                <%= entry.applicability.replace(/_/g, ' ') %>
                                            </span>
                                        </div>
                                        <p class="mt-3 text-sm leading-6"><%= entry.explanation %></p>
                                        <p class="mt-2 text-xs uppercase tracking-[0.3em] text-slate-400">
                                            <%= entry.source_family %> | Basis <%= entry.compliance_basis || '-' %> | <%= entry.installation_context || 'No active installation context' %>
                                        </p>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } else if ((safeComplianceVisibility.installed_components || []).length > 0) { %>
            <div class="mt-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-5 text-sm text-slate-600">
                No unknown, unsupported, or applicable compliance attention contributors are currently visible across the active serialized-component set.
            </div>
        <% } else { %>
            <div class="mt-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-5 text-sm text-slate-600">
                No active serialized installations are currently available for aircraft-level compliance drilldown.
            </div>
        <% } %>
    </article>

    <article class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-[0.3em] text-slate-500">Technical Drilldown</p>
                <h3 class="mt-2 text-lg font-semibold text-slate-900">Contributor-level technical context</h3>
                <p class="mt-2 text-sm leading-6 text-slate-700">
                    Drilldown remains read-only and shows which component contributors, states, and configuration groupings produced the current dashboard picture.
                </p>
            </div>
        </div>

        <% if ((technicalDashboard.drilldown?.state_groups || []).some(group => group.contributors.length > 0)) { %>
            <div class="mt-4 grid gap-4 xl:grid-cols-2">
                <% technicalDashboard.drilldown.state_groups.forEach((group) => { %>
                    <% if (group.contributors.length > 0) { %>
                        <div class="rounded-2xl border p-4 <%= group.tone === 'rose' ? 'border-rose-200 bg-rose-50' : group.tone === 'amber' ? 'border-amber-200 bg-amber-50' : 'border-slate-200 bg-slate-50' %>">
                            <div class="flex items-center justify-between gap-3">
                                <div>
                                    <p class="text-sm font-semibold text-slate-900"><%= group.label %></p>
                                    <p class="mt-1 text-xs uppercase tracking-[0.3em] <%= group.tone === 'rose' ? 'text-rose-700' : group.tone === 'amber' ? 'text-amber-700' : 'text-slate-500' %>"><%= group.contributors.length %> contributor<%= group.contributors.length === 1 ? '' : 's' %></p>
                                </div>
                            </div>
                            <p class="mt-3 text-sm leading-6 text-slate-700"><%= group.explanation %></p>
                            <div class="mt-3 space-y-3">
                                <% group.contributors.forEach((item) => { %>
                                    <div class="rounded-xl bg-white p-4">
                                        <div class="flex flex-col gap-2 lg:flex-row lg:items-start lg:justify-between">
                                            <div>
                                                <p class="font-semibold text-slate-900"><%= item.manufacturer_name || 'Unknown Manufacturer' %> <%= item.model_name %></p>
                                                <p class="mt-1 text-xs uppercase tracking-[0.3em] text-slate-500"><%= item.asset_type_code %> | SN <%= item.serial_number %> | <%= item.position || 'Position Not Captured' %></p>
                                            </div>
                                            <span class="rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-[0.3em] <%= item.due_state === 'OVERDUE' ? 'bg-rose-100 text-rose-800' : item.due_state === 'DUE' ? 'bg-amber-100 text-amber-800' : item.due_state === 'DUE_SOON' ? 'bg-yellow-100 text-yellow-800' : 'bg-slate-100 text-slate-700' %>">
                                                <%= item.due_state.replace(/_/g, ' ') %>
                                            </span>
                                        </div>
                                        <p class="mt-3 text-sm leading-6 text-slate-700"><%= item.due_explanation %></p>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                <% }) %>
            </div>
        <% } %>

        <% if ((technicalDashboard.drilldown?.grouped_components || []).length > 0) { %>
            <div class="mt-4 grid gap-4 xl:grid-cols-2">
                <% technicalDashboard.drilldown.grouped_components.forEach((group) => { %>
                    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <p class="text-sm font-semibold text-slate-900"><%= group.label %></p>
                                <p class="mt-1 text-xs uppercase tracking-[0.3em] text-slate-500"><%= group.code %></p>
                            </div>
                            <span class="rounded-full bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-[0.3em] text-slate-700"><%= group.count %> contributor<%= group.count === 1 ? '' : 's' %></span>
                        </div>
                        <div class="mt-3 space-y-3">
                            <% group.contributors.forEach((item) => { %>
                                <div class="rounded-xl bg-white p-4">
                                    <div class="flex flex-col gap-2 lg:flex-row lg:items-start lg:justify-between">
                                        <div>
                                            <p class="font-semibold text-slate-900"><%= item.manufacturer_name || 'Unknown Manufacturer' %> <%= item.model_name %></p>
                                            <p class="mt-1 text-xs uppercase tracking-[0.3em] text-slate-500">SN <%= item.serial_number %> | <%= item.position || 'Position Not Captured' %></p>
                                        </div>
                                        <span class="rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-[0.3em] <%= item.due_state === 'OVERDUE' ? 'bg-rose-100 text-rose-800' : item.due_state === 'DUE' ? 'bg-amber-100 text-amber-800' : item.due_state === 'DUE_SOON' ? 'bg-yellow-100 text-yellow-800' : 'bg-emerald-100 text-emerald-800' %>">
                                            <%= item.due_state.replace(/_/g, ' ') %>
                                        </span>
                                    </div>
                                    <p class="mt-3 text-sm leading-6 text-slate-700"><%= item.due_explanation %></p>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="mt-4 rounded-xl border border-dashed border-slate-300 px-4 py-5 text-sm text-slate-600">
                No active serialized installations are available for technical drilldown yet.
            </div>
        <% } %>
    </article>

    <article class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-xs font-bold uppercase tracking-[0.3em] text-slate-500">Explainability And Auditability</p>
        <p class="mt-3 text-sm leading-6 text-slate-700"><%= technicalDashboard.audit?.derivation_statement || 'No audit derivation statement available.' %></p>
        <div class="mt-4 grid gap-3 xl:grid-cols-3">
            <% (technicalDashboard.audit?.traceability_notes || []).forEach((note) => { %>
                <div class="rounded-xl bg-white p-4 text-sm leading-6 text-slate-700"><%= note %></div>
            <% }) %>
            <% (safeComplianceVisibility.audit?.traceability_notes || []).forEach((note) => { %>
                <div class="rounded-xl bg-white p-4 text-sm leading-6 text-slate-700"><%= note %></div>
            <% }) %>
        </div>
    </article>
</section>
