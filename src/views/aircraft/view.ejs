<%- include('../partials/header') %>

<main class="max-w-5xl mx-auto py-10 px-6">
    <% const bulletinFilters = sbFilters || {}; %>
    <% const canEditAircraft = user?.roles?.some(role => role.code === 'ADMIN'); %>
    <% const safeAvailableSerializedComponents = typeof availableSerializedComponents !== 'undefined' ? availableSerializedComponents : []; %>
    <% const safeActiveSerializedInstallations = typeof activeSerializedInstallations !== 'undefined' ? activeSerializedInstallations : []; %>
    <% const safeSerializedRemovalStatuses = typeof serializedRemovalStatuses !== 'undefined' ? serializedRemovalStatuses : []; %>
    <% const safeSerializedOperationalSummary = typeof serializedOperationalSummary !== 'undefined' ? serializedOperationalSummary : {}; %>
    <% const safeSerializedPositionContext = typeof serializedPositionContext !== 'undefined' ? serializedPositionContext : { occupied_positions: [], recent_positions: [] }; %>

    <div class="mb-6">
        <a href="/aircraft" class="text-sm text-blue-600 hover:underline">
            Back to Fleet
        </a>
    </div>

    <% if (messages && messages.error && messages.error.length) { %>
        <div class="mb-6 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <%= messages.error[0] %>
        </div>
    <% } %>

    <% if (messages && messages.success && messages.success.length) { %>
        <div class="mb-6 rounded border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
            <%= messages.success[0] %>
        </div>
    <% } %>

    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">
            Aircraft: <%= aircraft.registration %>
        </h1>

        <p class="text-sm text-gray-500 mt-1">
            Manufacturer:
            <%= aircraft.ComponentModel?.Manufacturer?.name || '-' %>
            |
            Model:
            <%= aircraft.ComponentModel?.model_name || '-' %>
            |
            Serial:
            <%= aircraft.serial_number %>
        </p>

        <p class="text-xs text-gray-400 mt-2 uppercase tracking-widest">
            Asset Type:
            <%= aircraft.ComponentModel?.AssetType?.code || '-' %>
        </p>
    </div>

    <div class="grid gap-6 mb-8 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="bg-white shadow rounded-lg p-4">
            <% if (aircraft.photo_url) { %>
                <img
                    src="<%= aircraft.photo_url %>"
                    alt="<%= aircraft.registration %> photo"
                    class="w-full h-64 object-cover rounded-lg border"
                >
            <% } else { %>
                <div class="flex h-64 items-center justify-center rounded-lg border border-dashed text-sm text-slate-500">
                    No aircraft photo loaded
                </div>
            <% } %>
        </div>

        <div class="bg-white shadow rounded-lg p-6">
            <% const selectedManufacturerId = aircraft.ComponentModel?.manufacturer_id || aircraft.ComponentModel?.Manufacturer?.id || ''; %>

            <div class="mb-4 flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-slate-900">Aircraft Data</h2>
                    <p class="mt-1 text-sm text-slate-500">
                        Review registration, model details, hours, dates, and reference data.
                    </p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-slate-600">
                        Status: <%= aircraft.status %>
                    </span>
                    <% if (canEditAircraft) { %>
                        <button
                            type="button"
                            id="toggle-aircraft-edit"
                            class="rounded bg-slate-800 px-4 py-2 text-xs font-bold uppercase tracking-widest text-white hover:bg-slate-700"
                            aria-expanded="false"
                            aria-controls="aircraft-edit-form"
                        >
                            Edit Aircraft
                        </button>
                    <% } %>
                </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2 text-sm">
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Registration</p>
                    <p class="mt-1 text-slate-900"><%= aircraft.registration %></p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Serial Number</p>
                    <p class="mt-1 text-slate-900"><%= aircraft.serial_number %></p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Manufacturer</p>
                    <p class="mt-1 text-slate-900"><%= aircraft.ComponentModel?.Manufacturer?.name || '-' %></p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Model</p>
                    <p class="mt-1 text-slate-900"><%= aircraft.ComponentModel?.model_name || '-' %></p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Current Hours</p>
                    <p class="mt-1 text-slate-900"><%= aircraft.total_time_hours %></p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Loaded Into System</p>
                    <p class="mt-1 text-slate-900"><%= aircraft.loaded_into_system_at || '-' %></p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Manufacture Date</p>
                    <p class="mt-1 text-slate-900"><%= aircraft.manufacture_date || '-' %></p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Aircraft Category</p>
                    <p class="mt-1 text-slate-900"><%= categories.find(category => category.id === aircraft.category_id)?.label || '-' %></p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">TCDS Number</p>
                    <p class="mt-1 text-slate-900"><%= aircraft.tcds_number || '-' %></p>
                </div>
                <div class="md:col-span-2">
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">TCDS URL</p>
                    <p class="mt-1 text-slate-900">
                        <% if (aircraft.tcds_url) { %>
                            <a href="<%= aircraft.tcds_url %>" target="_blank" rel="noreferrer" class="text-blue-600 hover:underline">
                                <%= aircraft.tcds_url %>
                            </a>
                        <% } else { %>
                            -
                        <% } %>
                    </p>
                </div>
            </div>

            <% if (canEditAircraft) { %>
                <form
                    id="aircraft-edit-form"
                    action="/aircraft/<%= aircraft.id %>?_csrf=<%= encodeURIComponent(csrfToken) %>"
                    method="POST"
                    enctype="multipart/form-data"
                    class="mt-6 hidden space-y-5 border-t border-slate-200 pt-6"
                >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="version" value="<%= aircraft.version %>">

                    <div>
                        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">
                            Registration
                        </label>
                        <input
                            type="text"
                            name="registration"
                            id="registration"
                            required
                            value="<%= aircraft.registration %>"
                            class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                        >
                    </div>

                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">
                                Serial Number
                            </label>
                            <input
                                type="text"
                                name="serial_number"
                                required
                                value="<%= aircraft.serial_number %>"
                                class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                            >
                        </div>

                        <div>
                            <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">
                                Current Hours
                            </label>
                            <input
                                type="number"
                                step="0.01"
                                min="0"
                                name="total_time_hours"
                                value="<%= aircraft.total_time_hours %>"
                                class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                            >
                        </div>
                    </div>

                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">
                                Date Loaded Into System
                            </label>
                            <input
                                type="date"
                                name="loaded_into_system_at"
                                value="<%= aircraft.loaded_into_system_at || '' %>"
                                class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                            >
                        </div>

                        <div>
                            <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">
                                Manufacture Date
                            </label>
                            <input
                                type="date"
                                name="manufacture_date"
                                value="<%= aircraft.manufacture_date || '' %>"
                                class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                            >
                        </div>
                    </div>

                    <div>
                        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">
                            Aircraft Category
                        </label>
                        <select
                            name="category_id"
                            required
                            class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                        >
                            <option value="">Select Category</option>
                            <% categories.forEach((category) => { %>
                                <option
                                    value="<%= category.id %>"
                                    <%= category.id === aircraft.category_id ? 'selected' : '' %>
                                >
                                    <%= category.label %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">
                                Manufacturer
                            </label>
                            <select
                                name="manufacturer_id"
                                id="manufacturer-select"
                                required
                                class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                                hx-target="#model-select"
                                hx-swap="innerHTML"
                                onchange="if(this.value) { this.setAttribute('hx-get', '/aircraft/manufacturer/' + this.value + '/models'); this.setAttribute('hx-trigger', 'now'); if(typeof htmx !== 'undefined') htmx.ajax('GET', '/aircraft/manufacturer/' + this.value + '/models', '#model-select'); } else { document.getElementById('model-select').innerHTML = '<option value=\'\'>Select Model</option>'; }"
                            >
                                <option value="">Select Manufacturer</option>
                                <% manufacturers.forEach((manufacturer) => { %>
                                    <option
                                        value="<%= manufacturer.id %>"
                                        <%= manufacturer.id === selectedManufacturerId ? 'selected' : '' %>
                                    >
                                        <%= manufacturer.name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div>
                            <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">
                                Model
                            </label>
                            <select
                                id="model-select"
                                name="model_id"
                                required
                                class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                            >
                                <option value="">Select Model</option>
                                <% manufacturerModels.forEach((model) => { %>
                                    <option
                                        value="<%= model.id %>"
                                        <%= model.id === aircraft.model_id ? 'selected' : '' %>
                                    >
                                        <%= model.model_name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="grid gap-4 md:grid-cols-2">
                        <div>
                            <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">
                                TCDS Number
                            </label>
                            <input
                                type="text"
                                name="tcds_number"
                                value="<%= aircraft.tcds_number || '' %>"
                                class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                            >
                        </div>

                        <div>
                            <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">
                                TCDS Web URL
                            </label>
                            <input
                                type="url"
                                name="tcds_url"
                                value="<%= aircraft.tcds_url || '' %>"
                                class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                                placeholder="https://..."
                            >
                        </div>
                    </div>

                    <div>
                        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">
                            Replace Aircraft Photo
                        </label>
                        <input
                            type="file"
                            name="aircraft_photo"
                            accept="image/*"
                            class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                        >
                        <p class="mt-1 text-xs text-slate-500">
                            Leave this empty to keep the current photo.
                        </p>
                    </div>

                    <div class="flex flex-wrap items-center gap-3">
                        <button
                            type="submit"
                            class="rounded bg-slate-800 px-5 py-2 text-sm font-bold text-white hover:bg-slate-700"
                        >
                            Save Aircraft Changes
                        </button>
                        <button
                            type="button"
                            id="cancel-aircraft-edit"
                            class="rounded border border-slate-300 px-5 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50"
                        >
                            Cancel
                        </button>
                    </div>
                </form>
            <% } %>
        </div>
    </div>

    <div class="mb-8 grid gap-6 lg:grid-cols-[1fr_1fr]">
        <div class="rounded-lg bg-white p-6 shadow">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-slate-900">Current Customer Relationships</h2>
                    <p class="mt-1 text-sm text-slate-500">
                        Customer relationships are always driven by explicit customer-aircraft links.
                    </p>
                </div>
                <a href="/customers" class="text-sm font-semibold text-blue-600 hover:underline">
                    Manage Customers
                </a>
            </div>

            <% if (currentCustomerLinks && currentCustomerLinks.length > 0) { %>
                <div class="mt-4 space-y-4">
                    <% currentCustomerLinks.forEach((currentCustomerLink) => { %>
                        <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-4">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <p class="text-lg font-bold text-slate-900">
                                        <%= currentCustomerLink.Customer?.name || 'Unknown Customer' %>
                                    </p>
                                    <p class="mt-1 text-sm text-slate-700">
                                        Contact: <%= currentCustomerLink.Customer?.contact_person || '-' %>
                                    </p>
                                    <p class="text-sm text-slate-700">
                                        Email: <%= currentCustomerLink.Customer?.email || '-' %>
                                    </p>
                                    <p class="text-sm text-slate-700">
                                        Phone: <%= currentCustomerLink.Customer?.phone || '-' %>
                                    </p>
                                </div>
                                <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-emerald-700">
                                    Current
                                </span>
                            </div>

                            <div class="mt-4 grid gap-3 md:grid-cols-3 text-sm text-slate-700">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Relationship Type</p>
                                    <p class="mt-1"><%= currentCustomerLink.relationship_type %></p>
                                </div>
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Start Date</p>
                                    <p class="mt-1"><%= currentCustomerLink.start_date %></p>
                                </div>
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">End Date</p>
                                    <p class="mt-1"><%= currentCustomerLink.end_date || 'Open' %></p>
                                </div>
                            </div>

                            <% if (currentCustomerLink.notes) { %>
                                <div class="mt-4">
                                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Notes</p>
                                    <p class="mt-1 whitespace-pre-wrap text-sm text-slate-700"><%= currentCustomerLink.notes %></p>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="mt-4 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">
                    No current customer relationships are assigned to this aircraft.
                </div>
            <% } %>
        </div>

        <div class="rounded-lg bg-white p-6 shadow">
            <h2 class="text-lg font-semibold text-slate-900">Add Customer Relationship</h2>
            <p class="mt-1 text-sm text-slate-500">
                Add a current customer relationship without replacing unrelated existing relationships.
            </p>

            <form action="/aircraft/<%= aircraft.id %>/customer-links" method="POST" class="mt-5 space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div>
                    <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">Customer</label>
                    <select name="customer_id" required class="w-full rounded border border-slate-300 px-3 py-2 text-sm">
                        <option value="">Select Customer</option>
                        <% customerOptions.forEach((customer) => { %>
                            <option value="<%= customer.id %>">
                                <%= customer.name %> (<%= customer.contact_person %>)
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="grid gap-4 md:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">Relationship Type</label>
                        <select name="relationship_type" required class="w-full rounded border border-slate-300 px-3 py-2 text-sm">
                            <option value="">Select Relationship</option>
                            <% ['OWNER', 'CO_OWNER', 'OPERATOR', 'BILLING_CUSTOMER', 'MANAGEMENT_COMPANY', 'CONTACT_ONLY'].forEach((relationshipType) => { %>
                                <option value="<%= relationshipType %>">
                                    <%= relationshipType.replace(/_/g, ' ') %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">Start Date</label>
                        <input
                            type="date"
                            name="start_date"
                            required
                            value="<%= new Date().toISOString().slice(0, 10) %>"
                            class="w-full rounded border border-slate-300 px-3 py-2 text-sm"
                        >
                    </div>
                </div>

                <div>
                    <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-600">Notes</label>
                    <textarea name="notes" rows="3" class="w-full rounded border border-slate-300 px-3 py-2 text-sm" placeholder="Optional assignment notes"></textarea>
                </div>

                <button type="submit" class="rounded bg-slate-800 px-5 py-2 text-sm font-bold text-white hover:bg-slate-700">
                    Add Customer Relationship
                </button>
            </form>
        </div>
    </div>

    <% if (historicalCustomerLinks && historicalCustomerLinks.length > 0) { %>
        <div class="mb-8 rounded-lg bg-white p-6 shadow">
            <h2 class="text-lg font-semibold text-slate-900">Customer Ownership History</h2>
            <p class="mt-1 text-sm text-slate-500">
                Historical ownership links are preserved and never inferred from free text.
            </p>

            <div class="mt-4 space-y-3">
                <% historicalCustomerLinks.forEach((link) => { %>
                    <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-sm font-semibold text-slate-900">
                                    <%= link.Customer?.name || 'Unknown Customer' %>
                                </p>
                                <p class="mt-1 text-xs uppercase tracking-widest text-slate-500">
                                    <%= link.relationship_type %>
                                </p>
                            </div>
                            <div class="text-right text-sm text-slate-600">
                                <p><%= link.start_date %> to <%= link.end_date || 'Open' %></p>
                            </div>
                        </div>

                        <% if (link.notes) { %>
                            <p class="mt-2 whitespace-pre-wrap text-sm text-slate-600"><%= link.notes %></p>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>

    <div class="mb-8 border-b border-slate-200">
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Aircraft detail sections">
            <button
                type="button"
                class="aircraft-tab rounded-t-lg border border-b-0 border-slate-300 bg-slate-900 px-4 py-3 text-xs font-bold uppercase tracking-widest text-white"
                data-tab-target="overview-panel"
                aria-selected="true"
                role="tab"
            >
                Overview
            </button>
            <button
                type="button"
                class="aircraft-tab rounded-t-lg border border-b-0 border-slate-300 bg-white px-4 py-3 text-xs font-bold uppercase tracking-widest text-slate-600"
                data-tab-target="service-bulletins-panel"
                aria-selected="false"
                role="tab"
            >
                Service Bulletins
            </button>
            <button
                type="button"
                class="aircraft-tab rounded-t-lg border border-b-0 border-slate-300 bg-white px-4 py-3 text-xs font-bold uppercase tracking-widest text-slate-600"
                data-tab-target="installed-components-panel"
                aria-selected="false"
                role="tab"
            >
                Installed Components
            </button>
        </div>
    </div>

    <section id="overview-panel" class="aircraft-tab-panel">
        <div class="bg-white shadow rounded-lg p-6 mb-10">
            <h2 class="text-xl font-semibold mb-4">
                Install Component on <%= aircraft.registration %>
            </h2>

            <form action="/aircraft/<%= aircraft.id %>/components"
                  method="POST"
                  class="space-y-4">

                <div>
                    <label class="block text-sm font-medium text-gray-700">
                        Component Model
                    </label>

                    <select name="model_id"
                            required
                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">

                        <% componentModels.forEach(model => { %>
                            <option value="<%= model.id %>">
                                <%= model.Manufacturer?.name %> -
                                <%= model.model_name %>
                            </option>
                        <% }) %>

                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">
                        Serial Number
                    </label>
                    <input type="text"
                           name="serial_number"
                           required
                           class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                </div>

                <div class="grid grid-cols-2 gap-4">

                    <div>
                        <label class="block text-sm font-medium text-gray-700">
                            TSN at Install
                        </label>
                        <input type="number"
                               step="0.1"
                               name="tsn_at_install"
                               value="0"
                               required
                               class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">
                            TSO at Install
                        </label>
                        <input type="number"
                               step="0.1"
                               name="tso_at_install"
                               value="0"
                               required
                               class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                    </div>

                </div>

                <button type="submit"
                        class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                    Finalize Installation
                </button>

            </form>
        </div>

        <div class="grid gap-6 xl:grid-cols-2">
            <div class="rounded-lg border border-amber-200 bg-amber-50 p-6 shadow">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-widest text-amber-700">Inherited Aircraft Configuration</p>
                        <h2 class="mt-2 text-xl font-semibold text-slate-900">Baseline Capture</h2>
                        <p class="mt-2 text-sm text-slate-700">
                            Capture Existing Installed Component is for onboarding an aircraft's already-installed serialized component state. This is not an authoritative installation action.
                        </p>
                    </div>
                    <span class="rounded-full bg-white px-3 py-1 text-xs font-bold uppercase tracking-widest text-amber-700">
                        Onboarding Only
                    </span>
                </div>

                <div class="mt-4 rounded-lg border border-amber-300 bg-white p-4 text-sm text-slate-700">
                    <p class="font-semibold text-slate-900">Baseline Capture: Existing aircraft configuration captured during onboarding.</p>
                    <p class="mt-2">
                        Use this only when the serialized component is already installed on the real aircraft and Jupiter is capturing inherited operational state. Future removals and swaps must still use the normal authoritative workflow.
                    </p>
                </div>

                <form action="/aircraft/<%= aircraft.id %>/serialized-components/baseline-capture"
                      method="POST"
                      class="mt-5 space-y-4">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div>
                        <label class="block text-sm font-medium text-gray-700">
                            Capture Existing Installed Component
                        </label>
                        <select name="serialized_component_id"
                                required
                                class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                            <option value="">Select Serialized Component</option>
                            <% safeAvailableSerializedComponents.forEach((component) => { %>
                                <option value="<%= component.id %>">
                                    <%= component.ComponentModel?.AssetType?.code || 'UNCLASSIFIED' %> |
                                    <%= component.ComponentModel?.Manufacturer?.name || 'Unknown' %> |
                                    <%= component.ComponentModel?.model_name || 'Unknown Model' %> |
                                    S/N <%= component.serial_number %>
                                    <% if (component.part_number) { %>
                                        | P/N <%= component.part_number %>
                                    <% } %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">
                                Effective Baseline Date
                            </label>
                            <input type="date"
                                   name="installed_at"
                                   value="<%= new Date().toISOString().slice(0, 10) %>"
                                   required
                                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                            <p class="mt-1 text-xs text-slate-500">
                                Capture the effective inherited installed state date known during onboarding.
                            </p>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700">
                                Position
                            </label>
                            <input type="text"
                                   name="position"
                                   placeholder="LH-MAG, NAV-1, BAT-1"
                                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">
                                Inherited TSN at Baseline
                            </label>
                            <input type="number"
                                   step="0.01"
                                   name="install_tsn"
                                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                            <p class="mt-1 text-xs text-slate-500">
                                Enter the best known inherited TSN if supported by records. Leave blank if unknown.
                            </p>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700">
                                Inherited TSO at Baseline
                            </label>
                            <input type="number"
                                   step="0.01"
                                   name="install_tso"
                                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                            <p class="mt-1 text-xs text-slate-500">
                                Enter the best known inherited TSO if supported by records. Leave blank if unknown.
                            </p>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">
                            Inherited Aircraft Configuration
                        </label>
                        <textarea
                            name="inherited_status_context"
                            rows="3"
                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm"
                            placeholder="Describe what is known about this inherited installed state."
                        ></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">
                            Uncertainty or Evidence Limitations
                        </label>
                        <textarea
                            name="uncertainty_notes"
                            rows="3"
                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm"
                            placeholder="Explain any unknown, estimated, or partially evidenced historical information."
                        ></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">
                            Additional Notes
                        </label>
                        <textarea
                            name="notes"
                            rows="3"
                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm"
                            placeholder="Optional baseline capture notes"
                        ></textarea>
                    </div>

                    <div class="rounded-lg border border-amber-300 bg-white p-4 text-sm text-slate-700">
                        This action creates active installation visibility for onboarding, preserves baseline provenance, and does not fabricate maintenance history.
                    </div>

                    <button type="submit"
                            class="bg-amber-600 text-white px-4 py-2 rounded hover:bg-amber-700">
                        Capture Existing Installed Component
                    </button>
                </form>
            </div>

            <div class="rounded-lg border border-slate-200 bg-white p-6 shadow">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Maintenance Workflow</p>
                        <h2 class="mt-2 text-xl font-semibold text-slate-900">Install Serialized Component</h2>
                        <p class="mt-2 text-sm text-slate-500">
                            Use this only for a current authoritative installation event. This remains separate from Baseline Capture.
                        </p>
                    </div>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-slate-700">
                        Explicit Workflow
                    </span>
                </div>

                <form action="/aircraft/<%= aircraft.id %>/serialized-components"
                      method="POST"
                      class="mt-5 space-y-4">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div>
                        <label class="block text-sm font-medium text-gray-700">
                            Available Serialized Component
                        </label>
                        <select name="serialized_component_id"
                                required
                                class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                            <option value="">Select Serialized Component</option>
                            <% safeAvailableSerializedComponents.forEach((component) => { %>
                                <option value="<%= component.id %>">
                                    <%= component.ComponentModel?.AssetType?.code || 'UNCLASSIFIED' %> |
                                    <%= component.ComponentModel?.Manufacturer?.name || 'Unknown' %> |
                                    <%= component.ComponentModel?.model_name || 'Unknown Model' %> |
                                    S/N <%= component.serial_number %>
                                    <% if (component.part_number) { %>
                                        | P/N <%= component.part_number %>
                                    <% } %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">
                                Installation Date
                            </label>
                            <input type="date"
                                   name="installed_at"
                                   value="<%= new Date().toISOString().slice(0, 10) %>"
                                   required
                                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700">
                                Position
                            </label>
                            <input type="text"
                                   name="position"
                                   placeholder="LH-MAG, NAV-1, BAT-1"
                                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">
                                Install TSN
                            </label>
                            <input type="number"
                                   step="0.01"
                                   name="install_tsn"
                                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700">
                                Install TSO
                            </label>
                            <input type="number"
                                   step="0.01"
                                   name="install_tso"
                                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm">
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">
                            Notes
                        </label>
                        <textarea
                            name="notes"
                            rows="3"
                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm"
                            placeholder="Optional serialized installation notes"
                        ></textarea>
                    </div>

                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
                        This action records a current authoritative installation event and remains separate from inherited onboarding capture.
                    </div>

                    <button type="submit"
                            class="bg-slate-800 text-white px-4 py-2 rounded hover:bg-black">
                        Install Serialized Component
                    </button>
                </form>
            </div>
        </div>
    </section>

    <section id="service-bulletins-panel" class="aircraft-tab-panel hidden">
        <div class="bg-white shadow rounded-lg p-6 mb-10">
            <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <h2 class="text-xl font-semibold">Service Bulletins</h2>
                    <p class="mt-1 text-sm text-slate-500">
                        Filter aircraft-applicable bulletins by status and criticality.
                    </p>
                </div>

                <form action="<%= aircraftViewPath %>" method="GET" class="grid gap-3 rounded-lg border border-slate-200 bg-slate-50 p-4 md:grid-cols-2 xl:grid-cols-4">
                    <input type="hidden" name="tab" value="service-bulletins">

                    <div>
                        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">
                            Status
                        </label>
                        <select name="status" class="w-full rounded border border-slate-300 px-3 py-2 text-sm">
                            <option value="" <%= !bulletinFilters.status ? 'selected' : '' %>>All statuses</option>
                            <option value="OPEN" <%= bulletinFilters.status === 'OPEN' ? 'selected' : '' %>>Open</option>
                            <option value="COMPLIED" <%= bulletinFilters.status === 'COMPLIED' ? 'selected' : '' %>>Complied</option>
                            <option value="NOT_APPLICABLE" <%= bulletinFilters.status === 'NOT_APPLICABLE' ? 'selected' : '' %>>Not Applicable</option>
                        </select>
                    </div>

                    <div>
                        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">
                            Sort
                        </label>
                        <select name="sort" class="w-full rounded border border-slate-300 px-3 py-2 text-sm">
                            <option value="sb_number" <%= bulletinFilters.sort !== 'status' ? 'selected' : '' %>>SB Number</option>
                            <option value="status" <%= bulletinFilters.sort === 'status' ? 'selected' : '' %>>Status</option>
                        </select>
                    </div>

                    <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
                        <input
                            type="checkbox"
                            name="open_only"
                            value="true"
                            <%= bulletinFilters.open_only === 'true' ? 'checked' : '' %>
                            class="rounded border-slate-300"
                        >
                        Show open only
                    </label>

                    <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
                        <input
                            type="checkbox"
                            name="critical"
                            value="true"
                            <%= bulletinFilters.critical === 'true' ? 'checked' : '' %>
                            class="rounded border-slate-300"
                        >
                        Critical only
                    </label>

                    <div class="md:col-span-2 xl:col-span-4 flex flex-wrap gap-3">
                        <button
                            type="submit"
                            class="rounded bg-slate-800 px-4 py-2 text-xs font-bold uppercase tracking-widest text-white hover:bg-black"
                        >
                            Apply Filters
                        </button>
                        <a
                            href="<%= aircraftViewPath %>?tab=service-bulletins"
                            class="rounded border border-slate-300 px-4 py-2 text-xs font-bold uppercase tracking-widest text-slate-700 hover:bg-white"
                        >
                            Clear
                        </a>
                    </div>
                </form>
            </div>

            <% if (!serviceBulletins || serviceBulletins.length === 0) { %>
                <p class="text-gray-500 text-sm">No service bulletins apply to this aircraft yet.</p>
            <% } else { %>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="bg-slate-50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                                    SB Number
                                </th>
                                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                                    Title
                                </th>
                                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">
                                    Status
                                </th>
                                <th class="px-4 py-3 text-right text-xs font-bold uppercase tracking-widest text-slate-500">
                                    Action
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 bg-white">
                            <% serviceBulletins.forEach((sb) => { %>
                                <%- include('./partials/service-bulletin-row', { aircraftId: aircraft.id, sb }) %>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </section>

    <section id="installed-components-panel" class="aircraft-tab-panel hidden">
        <div class="bg-white shadow rounded-lg p-6 mb-10">
            <h2 class="text-xl font-semibold mb-4">Installed Components</h2>

            <div class="mb-6 rounded-lg border border-slate-200 bg-slate-50 p-4">
                <p class="text-sm text-slate-700">
                    Active serialized installation visibility remains downstream of authoritative workflow actions. Baseline Capture stays explicitly marked as inherited onboarding provenance and does not replace install/remove authority.
                </p>
            </div>

            <div class="mb-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
                <article class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Active Serialized</p>
                    <p class="mt-2 text-2xl font-bold text-slate-900"><%= safeSerializedOperationalSummary.active_serialized_count || 0 %></p>
                    <p class="mt-2 text-sm text-slate-600">Current serialized installations visible in active aircraft configuration.</p>
                </article>
                <article class="rounded-lg border border-amber-200 bg-amber-50 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-amber-700">Baseline Provenance</p>
                    <p class="mt-2 text-2xl font-bold text-slate-900"><%= safeSerializedOperationalSummary.baseline_capture_count || 0 %></p>
                    <p class="mt-2 text-sm text-slate-600">Active installations currently visible through inherited baseline capture provenance.</p>
                </article>
                <article class="rounded-lg border border-blue-200 bg-blue-50 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-blue-700">Authoritative Install</p>
                    <p class="mt-2 text-2xl font-bold text-slate-900"><%= safeSerializedOperationalSummary.authoritative_install_count || 0 %></p>
                    <p class="mt-2 text-sm text-slate-600">Active installations currently visible from explicit authoritative install workflow.</p>
                </article>
                <article class="rounded-lg border border-rose-200 bg-rose-50 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-rose-700">Visibility Limited</p>
                    <p class="mt-2 text-2xl font-bold text-slate-900"><%= Number(safeSerializedOperationalSummary.readiness_limited_count || 0) + Number(safeSerializedOperationalSummary.review_recommended_count || 0) %></p>
                    <p class="mt-2 text-sm text-slate-600">Advisory-only count of active serialized installations that still need operational review or clarification.</p>
                </article>
                <article class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Uncertainty Visible</p>
                    <p class="mt-2 text-2xl font-bold text-slate-900"><%= safeSerializedOperationalSummary.uncertainty_visible_count || 0 %></p>
                    <p class="mt-2 text-sm text-slate-600">Active installations carrying inherited, unknown, or limited-evidence visibility flags.</p>
                </article>
                <article class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Maintenance Context Limited</p>
                    <p class="mt-2 text-2xl font-bold text-slate-900"><%= safeSerializedOperationalSummary.maintenance_context_limited_count || 0 %></p>
                    <p class="mt-2 text-sm text-slate-600">Active serialized installations without linked maintenance-event visibility in this operational layer.</p>
                </article>
                <article class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Document Visibility Limited</p>
                    <p class="mt-2 text-2xl font-bold text-slate-900"><%= safeSerializedOperationalSummary.document_visibility_limited_count || 0 %></p>
                    <p class="mt-2 text-sm text-slate-600">Active serialized installations without linked component-document visibility in this operational layer.</p>
                </article>
                <article class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Event-Linked Documents</p>
                    <p class="mt-2 text-2xl font-bold text-slate-900"><%= safeSerializedOperationalSummary.maintenance_event_linked_document_visible_count || 0 %></p>
                    <p class="mt-2 text-sm text-slate-600">Active serialized installations with visible maintenance-event-linked component documents.</p>
                </article>
                <article class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Component-Only Evidence</p>
                    <p class="mt-2 text-2xl font-bold text-slate-900"><%= safeSerializedOperationalSummary.component_only_document_visible_count || 0 %></p>
                    <p class="mt-2 text-sm text-slate-600">Active serialized installations with visible component-linked evidence that is not linked to a maintenance event.</p>
                </article>
                <article class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Occupied Positions</p>
                    <p class="mt-2 text-2xl font-bold text-slate-900"><%= safeSerializedOperationalSummary.occupied_position_count || 0 %></p>
                    <p class="mt-2 text-sm text-slate-600">Current explicit serialized installation positions captured on this aircraft.</p>
                </article>
            </div>

            <% if ((safeSerializedPositionContext.occupied_positions || []).length > 0 || (safeSerializedPositionContext.recent_positions || []).length > 0) { %>
                <div class="mb-8 grid gap-4 xl:grid-cols-2">
                    <% if ((safeSerializedPositionContext.occupied_positions || []).length > 0) { %>
                        <div class="rounded-lg border border-rose-200 bg-rose-50 p-4">
                            <p class="text-[11px] font-bold uppercase tracking-widest text-rose-700">Currently Occupied Positions</p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                <% safeSerializedPositionContext.occupied_positions.forEach((position) => { %>
                                    <span class="rounded-full bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-rose-700"><%= position %></span>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                    <% if ((safeSerializedPositionContext.recent_positions || []).length > 0) { %>
                        <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                            <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Recent Position History</p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                <% safeSerializedPositionContext.recent_positions.forEach((position) => { %>
                                    <span class="rounded-full bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-slate-700"><%= position %></span>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <div class="mb-8">
                <div class="mb-4 flex items-center justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-900">Active Serialized Installations</h3>
                        <p class="mt-1 text-sm text-slate-500">
                            Provenance, inherited context, uncertainty, and installation history remain visible for operational review.
                        </p>
                    </div>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-slate-700">
                        <%= safeActiveSerializedInstallations.length %> Active
                    </span>
                </div>

                <% if (safeActiveSerializedInstallations.length > 0) { %>
                    <div class="space-y-4">
                        <% safeActiveSerializedInstallations.forEach((installation) => { %>
                            <% const serializedComponent = installation.SerializedComponent; %>
                            <% const serializedModel = serializedComponent?.ComponentModel; %>
                            <% const serializedManufacturer = serializedModel?.Manufacturer; %>
                            <% const serializedAssetType = serializedModel?.AssetType; %>
                            <% const historyEntries = installation.history_entries || []; %>
                            <% const isBaselineCapture = installation.installation_context === 'BASELINE_CAPTURE'; %>
                            <% const uncertaintyFlags = installation.uncertainty_flags || []; %>
                            <% const readinessSummary = installation.readiness_summary || {}; %>
                            <% const maintenanceContextSummary = installation.maintenance_context_summary || {}; %>
                            <% const documentVisibilitySummary = installation.document_visibility_summary || {}; %>
                            <% const evidenceReadinessSummary = documentVisibilitySummary.readiness_summary || {}; %>
                            <% const evidenceBadges = documentVisibilitySummary.evidence_badges || []; %>
                            <% const documentTypes = documentVisibilitySummary.document_types || []; %>
                            <% const operationalWarnings = installation.operational_warnings || []; %>
                            <article class="rounded-lg border border-slate-200 bg-white p-5">
                                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                                    <div>
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-slate-700">
                                                <%= serializedAssetType?.code || 'UNCLASSIFIED' %>
                                            </span>
                                            <span class="rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-widest <%= isBaselineCapture ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800' %>">
                                                <%= isBaselineCapture ? 'Baseline Capture' : 'Authoritative Install' %>
                                            </span>
                                            <span class="rounded-full bg-emerald-100 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-emerald-800">
                                                <%= serializedComponent?.status || 'INSTALLED' %>
                                            </span>
                                            <span class="rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-widest <%= readinessSummary.state === 'LIMITED' ? 'bg-rose-100 text-rose-800' : readinessSummary.state === 'REVIEW' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800' %>">
                                                <%= readinessSummary.label || 'Operational Review Recommended' %>
                                            </span>
                                        </div>
                                        <h3 class="mt-3 text-base font-bold text-slate-900">
                                            <%= serializedManufacturer?.name || 'Unknown Manufacturer' %>
                                            <%= serializedModel?.model_name || 'Unknown Model' %>
                                        </h3>
                                        <p class="mt-1 text-sm text-slate-600">
                                            Serial <%= serializedComponent?.serial_number || '-' %>
                                            <% if (serializedComponent?.part_number) { %>
                                                | Part Number <%= serializedComponent.part_number %>
                                            <% } %>
                                            <% if (serializedModel?.model_code) { %>
                                                | <%= serializedModel.model_code %>
                                            <% } %>
                                        </p>
                                    </div>

                                    <div class="grid gap-3 text-sm text-slate-700 md:grid-cols-2 lg:min-w-[24rem]">
                                        <div>
                                            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Provenance</p>
                                            <p class="mt-1 font-semibold text-slate-900"><%= installation.provenance_label || installation.installation_context %></p>
                                        </div>
                                        <div>
                                            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Installed At</p>
                                            <p class="mt-1"><%= installation.installed_at || '-' %></p>
                                        </div>
                                        <div>
                                            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Position</p>
                                            <p class="mt-1"><%= installation.position || 'Position Not Captured' %></p>
                                        </div>
                                        <div>
                                            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">History Entries</p>
                                            <p class="mt-1"><%= historyEntries.length %></p>
                                        </div>
                                        <div>
                                            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Supporting Documents</p>
                                            <p class="mt-1"><%= documentVisibilitySummary.document_count ?? 0 %></p>
                                        </div>
                                        <div>
                                            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Event-Linked Documents</p>
                                            <p class="mt-1"><%= documentVisibilitySummary.maintenance_event_linked_document_count ?? 0 %></p>
                                        </div>
                                        <div>
                                            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Component-Only Documents</p>
                                            <p class="mt-1"><%= documentVisibilitySummary.component_only_document_count ?? 0 %></p>
                                        </div>
                                        <div>
                                            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Install TSN</p>
                                            <p class="mt-1"><%= installation.install_tsn ?? '-' %></p>
                                        </div>
                                        <div>
                                            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Install TSO</p>
                                            <p class="mt-1"><%= installation.install_tso ?? '-' %></p>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
                                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Operational Readiness Advisory</p>
                                    <p class="mt-2 text-sm font-semibold text-slate-900"><%= readinessSummary.label || 'Operational Review Recommended' %></p>
                                    <p class="mt-2 text-sm leading-6 text-slate-700"><%= readinessSummary.explanation || 'Advisory only: review current serialized component visibility carefully.' %></p>
                                </div>

                                <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
                                    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Evidence Readiness Advisory</p>
                                    <p class="mt-2 text-sm font-semibold text-slate-900"><%= evidenceReadinessSummary.label || 'Evidence Visibility Limited' %></p>
                                    <p class="mt-2 text-sm leading-6 text-slate-700"><%= evidenceReadinessSummary.explanation || 'Advisory only: supporting evidence visibility is limited in this operational layer.' %></p>
                                </div>

                                <% if (uncertaintyFlags.length > 0) { %>
                                    <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4">
                                        <p class="text-xs font-bold uppercase tracking-widest text-amber-700">Uncertainty and Missing Data</p>
                                        <div class="mt-3 flex flex-wrap gap-2">
                                            <% uncertaintyFlags.forEach((flag) => { %>
                                                <span class="rounded-full bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-amber-800"><%= flag %></span>
                                            <% }) %>
                                        </div>
                                    </div>
                                <% } %>

                                <% if (evidenceBadges.length > 0) { %>
                                    <div class="mt-4 rounded-lg border border-sky-200 bg-sky-50 p-4">
                                        <p class="text-xs font-bold uppercase tracking-widest text-sky-700">Evidence Visibility Badges</p>
                                        <div class="mt-3 flex flex-wrap gap-2">
                                            <% evidenceBadges.forEach((badge) => { %>
                                                <span class="rounded-full bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-sky-800"><%= badge %></span>
                                            <% }) %>
                                        </div>
                                    </div>
                                <% } %>

                                <% if (operationalWarnings.length > 0) { %>
                                    <div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 p-4">
                                        <p class="text-xs font-bold uppercase tracking-widest text-rose-700">Operational Warnings</p>
                                        <div class="mt-3 flex flex-wrap gap-2">
                                            <% operationalWarnings.forEach((warning) => { %>
                                                <span class="rounded-full bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-rose-700"><%= warning %></span>
                                            <% }) %>
                                        </div>
                                    </div>
                                <% } %>

                                <% if (installation.notes) { %>
                                    <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
                                        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Audit Explainability</p>
                                        <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-700"><%= installation.notes %></p>
                                    </div>
                                <% } %>

                                <div class="mt-4 grid gap-4 xl:grid-cols-2">
                                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                                        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Operational Traceability</p>
                                        <p class="mt-2 text-sm leading-6 text-slate-700"><%= installation.traceability_summary || 'Serialized installation traceability unavailable.' %></p>
                                    </div>
                                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                                        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Explainability Summary</p>
                                        <p class="mt-2 text-sm leading-6 text-slate-700"><%= installation.explainability_summary || 'Explainability summary unavailable.' %></p>
                                    </div>
                                </div>

                                <div class="mt-4 grid gap-4 xl:grid-cols-2">
                                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                                        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Maintenance Context Visibility</p>
                                        <p class="mt-2 text-sm font-semibold text-slate-900"><%= maintenanceContextSummary.headline || 'Maintenance context visibility unavailable.' %></p>
                                        <p class="mt-2 text-sm leading-6 text-slate-700"><%= maintenanceContextSummary.explanation || 'No maintenance-context explanation available.' %></p>
                                    </div>
                                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                                        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Component Document Visibility</p>
                                        <p class="mt-2 text-sm font-semibold text-slate-900"><%= documentVisibilitySummary.headline || 'Component-document visibility unavailable.' %></p>
                                        <p class="mt-2 text-sm leading-6 text-slate-700"><%= documentVisibilitySummary.explanation || 'No component-document explanation available.' %></p>
                                        <div class="mt-3 grid gap-3 md:grid-cols-3">
                                            <div class="rounded border border-slate-200 bg-white p-3">
                                                <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Total</p>
                                                <p class="mt-2 text-lg font-bold text-slate-900"><%= documentVisibilitySummary.document_count ?? 0 %></p>
                                            </div>
                                            <div class="rounded border border-slate-200 bg-white p-3">
                                                <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Event-Linked</p>
                                                <p class="mt-2 text-lg font-bold text-slate-900"><%= documentVisibilitySummary.maintenance_event_linked_document_count ?? 0 %></p>
                                            </div>
                                            <div class="rounded border border-slate-200 bg-white p-3">
                                                <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Component-Only</p>
                                                <p class="mt-2 text-lg font-bold text-slate-900"><%= documentVisibilitySummary.component_only_document_count ?? 0 %></p>
                                            </div>
                                        </div>
                                        <p class="mt-3 text-xs font-bold uppercase tracking-widest text-slate-500">Document Types</p>
                                        <% if (documentTypes.length > 0) { %>
                                            <div class="mt-2 flex flex-wrap gap-2">
                                                <% documentTypes.forEach((documentType) => { %>
                                                    <span class="rounded-full bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-slate-700"><%= documentType %></span>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <p class="mt-2 text-sm text-slate-600">No document types are currently visible in this operational layer.</p>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="mt-4 grid gap-4 xl:grid-cols-2">
                                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                                        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Document Relationship Visibility</p>
                                        <p class="mt-2 text-sm font-semibold text-slate-900"><%= documentVisibilitySummary.maintenance_event_relationship || 'No maintenance-event-linked document relationship visibility available.' %></p>
                                        <p class="mt-2 text-sm leading-6 text-slate-700"><%= documentVisibilitySummary.component_relationship || 'No component-only document relationship visibility available.' %></p>
                                    </div>
                                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                                        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Evidence Explainability</p>
                                        <p class="mt-2 text-sm font-semibold text-slate-900"><%= documentVisibilitySummary.traceability_summary || 'Document traceability summary unavailable.' %></p>
                                        <p class="mt-2 text-sm leading-6 text-slate-700"><%= documentVisibilitySummary.explainability_summary || 'Evidence explainability summary unavailable.' %></p>
                                    </div>
                                </div>

                                <details class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
                                    <summary class="cursor-pointer text-sm font-bold uppercase tracking-widest text-slate-600">
                                        Installation History
                                    </summary>
                                    <% if (historyEntries.length > 0) { %>
                                        <div class="mt-4 overflow-x-auto">
                                            <table class="min-w-full divide-y divide-slate-200">
                                                <thead class="bg-white">
                                                    <tr>
                                                        <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Event</th>
                                                        <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Installed</th>
                                                        <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Removed</th>
                                                        <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Position</th>
                                                        <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Notes</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-100 bg-white">
                                                    <% historyEntries.forEach((historyEntry) => { %>
                                                        <tr>
                                                            <td class="px-3 py-2 text-sm text-slate-700"><%= historyEntry.event_label %></td>
                                                            <td class="px-3 py-2 text-sm text-slate-700"><%= historyEntry.installed_at || '-' %></td>
                                                            <td class="px-3 py-2 text-sm text-slate-700"><%= historyEntry.removed_at || 'Active' %></td>
                                                            <td class="px-3 py-2 text-sm text-slate-700"><%= historyEntry.position || '-' %></td>
                                                            <td class="px-3 py-2 text-sm text-slate-700">
                                                                <% if (historyEntry.notes) { %>
                                                                    <span class="whitespace-pre-wrap"><%= historyEntry.notes %></span>
                                                                <% } else { %>
                                                                    -
                                                                <% } %>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    <% } else { %>
                                        <p class="mt-4 text-sm text-slate-500">No serialized installation history is visible for this component yet.</p>
                                    <% } %>
                                </details>

                                <form
                                    action="/aircraft/<%= aircraft.id %>/serialized-components/<%= installation.id %>/remove"
                                    method="POST"
                                    class="mt-4 border-t border-slate-200 pt-4"
                                >
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-5">
                                        <div>
                                            <label class="block text-xs font-bold uppercase tracking-widest text-slate-500">Removed At</label>
                                            <input
                                                type="date"
                                                name="removed_at"
                                                required
                                                value="<%= new Date().toISOString().slice(0, 10) %>"
                                                class="mt-2 block w-full rounded border border-slate-300 px-3 py-2 text-sm"
                                            >
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold uppercase tracking-widest text-slate-500">Removal TSN</label>
                                            <input
                                                type="number"
                                                step="0.01"
                                                name="removal_tsn"
                                                class="mt-2 block w-full rounded border border-slate-300 px-3 py-2 text-sm"
                                            >
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold uppercase tracking-widest text-slate-500">Removal TSO</label>
                                            <input
                                                type="number"
                                                step="0.01"
                                                name="removal_tso"
                                                class="mt-2 block w-full rounded border border-slate-300 px-3 py-2 text-sm"
                                            >
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold uppercase tracking-widest text-slate-500">Resulting Status</label>
                                            <select
                                                name="resulting_status"
                                                required
                                                class="mt-2 block w-full rounded border border-slate-300 px-3 py-2 text-sm"
                                            >
                                                <% safeSerializedRemovalStatuses.forEach((status) => { %>
                                                    <option value="<%= status %>"><%= status %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold uppercase tracking-widest text-slate-500">Notes</label>
                                            <input
                                                type="text"
                                                name="notes"
                                                class="mt-2 block w-full rounded border border-slate-300 px-3 py-2 text-sm"
                                                placeholder="Optional removal notes"
                                            >
                                        </div>
                                    </div>

                                    <p class="mt-3 text-xs leading-6 text-slate-500">
                                        Removal remains an explicit authoritative workflow action. Baseline provenance stays visible in history, but future lifecycle changes still occur only through the normal removal workflow.
                                    </p>

                                    <div class="mt-4">
                                        <button
                                            type="submit"
                                            class="rounded bg-rose-600 px-4 py-2 text-sm font-bold text-white hover:bg-rose-700"
                                        >
                                            Remove Serialized Component
                                        </button>
                                    </div>
                                </form>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-sm text-slate-500">No active serialized installations are currently visible on this aircraft.</p>
                <% } %>
            </div>

            <% if (aircraft.installed_components && aircraft.installed_components.length > 0) { %>
                <ul class="divide-y divide-gray-200">
                    <% aircraft.installed_components.forEach(ac => { %>
                        <% const model = ac.ComponentModel; %>
                        <% const manufacturer = model?.Manufacturer; %>

                        <li class="py-3 flex justify-between items-center">
                            <span>
                                <strong>
                                    <%= manufacturer?.name || 'Unknown Manufacturer' %>
                                    <%= model?.model_name || 'Unknown Model' %>
                                </strong>
                                <br>
                                <span class="text-sm text-gray-500">
                                    Installed:
                                    <%= new Date(ac.installed_at).toLocaleDateString() %>
                                </span>
                            </span>

                            <span class="text-sm text-gray-500 text-right">
                                TSN: <%= ac.tsn_at_install %><br>
                                TSO: <%= ac.tso_at_install %>
                                <% if (ac.is_quarantined) { %>
                                    <br>
                                    <span class="text-red-600 font-semibold">
                                        QUARANTINED
                                    </span>
                                <% } %>
                            </span>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p class="text-gray-500 text-sm">No components installed.</p>
            <% } %>
        </div>
    </section>

</main>

<script>
  (function () {
    const registrationInput = document.getElementById('registration');
    const editToggleButton = document.getElementById('toggle-aircraft-edit');
    const cancelEditButton = document.getElementById('cancel-aircraft-edit');
    const editForm = document.getElementById('aircraft-edit-form');
    const tabs = Array.from(document.querySelectorAll('.aircraft-tab'));
    const panels = Array.from(document.querySelectorAll('.aircraft-tab-panel'));
    const tabMap = {
      overview: 'overview-panel',
      'service-bulletins': 'service-bulletins-panel',
      'installed-components': 'installed-components-panel'
    };

    function formatRegistration(value) {
      const compact = value.toUpperCase().replace(/[^A-Z0-9]/g, '');

      if (
        compact.startsWith('ZS') ||
        compact.startsWith('ZU') ||
        compact.startsWith('ZT')
      ) {
        const prefix = compact.slice(0, 2);
        const suffix = compact.slice(2).replace(/[^A-Z]/g, '').slice(0, 3);
        return suffix ? `${prefix}-${suffix}` : prefix;
      }

      return value.toUpperCase();
    }

    function activateTab(targetId) {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.tabTarget === targetId;
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.classList.toggle('bg-slate-900', isActive);
        tab.classList.toggle('text-white', isActive);
        tab.classList.toggle('bg-white', !isActive);
        tab.classList.toggle('text-slate-600', !isActive);
      });

      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.id !== targetId);
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activateTab(tab.dataset.tabTarget));
    });

    registrationInput?.addEventListener('input', function () {
      registrationInput.value = formatRegistration(registrationInput.value);
    });

    function setEditFormVisible(visible) {
      if (!editForm || !editToggleButton) {
        return;
      }

      editForm.classList.toggle('hidden', !visible);
      editToggleButton.setAttribute('aria-expanded', visible ? 'true' : 'false');
      editToggleButton.textContent = visible ? 'Editing Aircraft' : 'Edit Aircraft';

      if (visible) {
        registrationInput?.focus();
      }
    }

    editToggleButton?.addEventListener('click', () => {
      const isHidden = editForm?.classList.contains('hidden');
      setEditFormVisible(Boolean(isHidden));
    });

    cancelEditButton?.addEventListener('click', () => {
      setEditFormVisible(false);
    });

    const activeTab = new URLSearchParams(window.location.search).get('tab');
    if (activeTab && tabMap[activeTab]) {
      activateTab(tabMap[activeTab]);
    }
  })();
</script>

<%- include('../partials/footer') %>
