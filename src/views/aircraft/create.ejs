<%- include('../partials/header') %>

<main class="max-w-4xl mx-auto py-10 px-4">

  <div class="mb-8">
    <h1 class="text-3xl font-black text-slate-900">Register Aircraft</h1>
    <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mt-1">
      Asset Type: AIRFRAME
    </p>
    <p class="mt-3 text-sm text-slate-500">
      Need to add or update an OEM first?
      <a href="/library/manufacturers" class="font-semibold text-blue-600 hover:underline">
        Manage Manufacturers
      </a>
    </p>
  </div>

  <form action="/aircraft?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" enctype="multipart/form-data" class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div>
      <label class="block text-xs font-bold uppercase text-slate-600 mb-1">
        Registration
      </label>
      <input
        type="text"
        name="registration"
        id="registration"
        required
        class="w-full border border-slate-300 rounded px-3 py-2 text-sm"
        placeholder="ZS-RGP"
      />
      <p class="mt-1 text-xs text-slate-500">
        South African registrations starting with ZS, ZU, or ZT are formatted as `XX-AAA`.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-1">
          Serial Number
        </label>
        <input
          type="text"
          name="serial_number"
          required
          class="w-full border border-slate-300 rounded px-3 py-2 text-sm"
        />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-1">
          Current Hours
        </label>
        <input
          type="number"
          step="0.01"
          min="0"
          name="total_time_hours"
          value="0"
          class="w-full border border-slate-300 rounded px-3 py-2 text-sm"
        />
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-1">
          Date Loaded Into System
        </label>
        <input
          type="date"
          name="loaded_into_system_at"
          value="<%= today %>"
          class="w-full border border-slate-300 rounded px-3 py-2 text-sm"
        />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-1">
          Manufacture Date
        </label>
        <input
          type="date"
          name="manufacture_date"
          class="w-full border border-slate-300 rounded px-3 py-2 text-sm"
        />
      </div>
    </div>

    <div>
      <label class="block text-xs font-bold uppercase text-slate-600 mb-1">
        Aircraft Category
      </label>
      <select
        name="category_id"
        class="w-full border border-slate-300 rounded px-3 py-2 text-sm"
        required
      >
        <option value="">Select Category</option>
        <% categories.forEach(category => { %>
          <option value="<%= category.id %>"><%= category.label %></option>
        <% }) %>
      </select>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-1">
          Manufacturer
        </label>

        <select
          name="manufacturer_id"
          id="manufacturer-select"
          class="w-full border border-slate-300 rounded px-3 py-2 text-sm"
          required
          hx-target="#model-select"
          hx-swap="innerHTML"
          onchange="if(this.value) { 
            this.setAttribute('hx-get', '/aircraft/manufacturer/' + this.value + '/models');
            this.setAttribute('hx-trigger', 'now');
            if(typeof htmx !== 'undefined') htmx.ajax('GET', '/aircraft/manufacturer/' + this.value + '/models', '#model-select');
          } else {
            document.getElementById('model-select').innerHTML = '<option value=\'\'>Select Model</option>';
          }"
        >
          <option value="">Select Manufacturer</option>
          <% manufacturers.forEach(m => { %>
            <option value="<%= m.id %>"><%= m.name %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-1">
          Model
        </label>

        <select
          id="model-select"
          name="model_id"
          class="w-full border border-slate-300 rounded px-3 py-2 text-sm"
          required
        >
          <option value="">Select Model</option>
        </select>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-1">
          TCDS Number
        </label>
        <input
          type="text"
          name="tcds_number"
          class="w-full border border-slate-300 rounded px-3 py-2 text-sm"
          placeholder="3A12"
        />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase text-slate-600 mb-1">
          TCDS Web URL
        </label>
        <input
          type="url"
          name="tcds_url"
          class="w-full border border-slate-300 rounded px-3 py-2 text-sm"
          placeholder="https://..."
        />
      </div>
    </div>

    <div>
      <label class="block text-xs font-bold uppercase text-slate-600 mb-1">
        Aircraft Picture
      </label>
      <input
        type="file"
        name="aircraft_photo"
        accept="image/*"
        class="w-full border border-slate-300 rounded px-3 py-2 text-sm"
      />
      <p class="mt-1 text-xs text-slate-500">
        Upload a photo from the local machine to store with this aircraft record.
      </p>
    </div>

    <button
      type="submit"
      class="bg-slate-800 text-white px-6 py-2 rounded text-sm font-bold hover:bg-slate-700"
    >
      Register Aircraft
    </button>

  </form>

</main>

<script>
  (function () {
    const registrationInput = document.getElementById('registration');

    function formatRegistration(value) {
      const compact = value.toUpperCase().replace(/[^A-Z0-9]/g, '');

      if (
        compact.startsWith('ZS') ||
        compact.startsWith('ZU') ||
        compact.startsWith('ZT')
      ) {
        const prefix = compact.slice(0, 2);
        const suffix = compact.slice(2).replace(/[^A-Z]/g, '').slice(0, 3);
        return suffix ? `${prefix}-${suffix}` : prefix;
      }

      return value.toUpperCase();
    }

    registrationInput?.addEventListener('input', function () {
      registrationInput.value = formatRegistration(registrationInput.value);
    });

    // ✅ HTMX Event Debugging
    document.body.addEventListener('htmx:beforeRequest', function(evt) {
        console.log("📡 [HTMX] Requesting:", evt.detail.pathInfo.path);
    });

    document.body.addEventListener('htmx:afterRequest', function(evt) {
        console.log("✅ [HTMX] Response status:", evt.detail.xhr.status);
    });

    document.body.addEventListener('htmx:responseError', function(evt) {
        console.error("❌ [HTMX] Error:", evt.detail.xhr.responseText);
    });
  })();
</script>

<%- include('../partials/footer') %>