<%- include('../partials/header') %>

<main class="max-w-6xl mx-auto py-10 px-6">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div>
            <a href="/aircraft/view/<%= aircraft.id %>" class="text-sm text-blue-600 hover:underline">
                Back to Aircraft
            </a>
            <h1 class="mt-3 text-3xl font-bold text-slate-900">
                Applicability Preview: <%= aircraft.registration %>
            </h1>
            <p class="mt-2 text-sm text-slate-500">
                Manufacturer:
                <%= aircraft.ComponentModel?.Manufacturer?.name || '-' %>
                |
                Model:
                <%= aircraft.ComponentModel?.model_name || '-' %>
            </p>
        </div>

        <div class="rounded-full bg-slate-100 px-4 py-2 text-xs font-bold uppercase tracking-widest text-slate-600">
            Read-Only Preview
        </div>
    </div>

    <section class="mb-8 grid gap-4 md:grid-cols-4">
        <div class="rounded-lg bg-white p-5 shadow">
            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Total Items</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900"><%= summary.total %></p>
        </div>
        <div class="rounded-lg bg-white p-5 shadow">
            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">AD Count</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900"><%= summary.ad %></p>
        </div>
        <div class="rounded-lg bg-white p-5 shadow">
            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">SB Count</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900"><%= summary.sb %></p>
        </div>
        <div class="rounded-lg bg-white p-5 shadow">
            <p class="text-xs font-bold uppercase tracking-widest text-slate-500">SID Count</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900"><%= summary.sid %></p>
        </div>
    </section>

    <% const safeAdApplicabilityPreview = typeof adApplicabilityPreview !== 'undefined' ? adApplicabilityPreview : []; %>

    <section class="mb-8 rounded-lg bg-white shadow">
        <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-200 px-6 py-4">
            <div>
                <h2 class="text-lg font-semibold text-slate-900">AD Applicability Preview</h2>
                <p class="mt-1 text-sm text-slate-500">
                    Preview only — does not create compliance status.
                </p>
                <p class="mt-1 text-xs font-semibold text-amber-700">
                    This creates an aircraft compliance assignment only. It does not record compliance status or due dates.
                </p>
                <p class="mt-1 text-xs font-semibold text-amber-700">
                    This creates operational compliance tracking only. It does not calculate due dates or create workpacks.
                </p>
            </div>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-slate-700">
                <%= safeAdApplicabilityPreview.length %> Accepted Allocation<%= safeAdApplicabilityPreview.length === 1 ? '' : 's' %>
            </span>
        </div>

        <% if (safeAdApplicabilityPreview.length === 0) { %>
            <div class="px-6 py-8 text-sm text-slate-500">
                No accepted AD applicability allocations currently preview for this aircraft.
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">AD Number</th>
                            <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Subject</th>
                            <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Allocation Type</th>
                            <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Matched Model/Manufacturer</th>
                            <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Classification</th>
                            <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Accepted By / Accepted At</th>
                            <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Review Reason</th>
                            <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 bg-white">
                        <% safeAdApplicabilityPreview.forEach((item) => { %>
                            <tr>
                                <td class="px-4 py-4 align-top text-sm font-semibold text-slate-900">
                                    <%= item.ad_number || '-' %>
                                    <% if (item.revision) { %>
                                        <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">
                                            Rev <%= item.revision %>
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-4 align-top text-sm text-slate-700"><%= item.subject || '-' %></td>
                                <td class="px-4 py-4 align-top text-sm text-slate-700"><%= item.allocation_type || '-' %></td>
                                <td class="px-4 py-4 align-top text-sm text-slate-700"><%= item.matched_target || '-' %></td>
                                <td class="px-4 py-4 align-top text-xs font-bold uppercase tracking-widest text-slate-600"><%= item.classification || '-' %></td>
                                <td class="px-4 py-4 align-top text-sm text-slate-700">
                                    <%= item.accepted_by || '-' %>
                                    <span class="block text-xs text-slate-500"><%= item.accepted_at ? new Date(item.accepted_at).toLocaleString() : '-' %></span>
                                </td>
                                <td class="px-4 py-4 align-top text-sm text-slate-600"><%= item.review_reason || '-' %></td>
                                <td class="px-4 py-4 align-top text-sm">
                                    <% if (item.aircraft_compliance_id) { %>
                                        <div class="space-y-3">
                                            <span class="inline-block rounded bg-emerald-100 px-3 py-2 text-xs font-bold uppercase tracking-widest text-emerald-800">
                                                Operational Record Created
                                                <% if (item.aircraft_compliance_status) { %>
                                                    - <%= item.aircraft_compliance_status %>
                                                <% } %>
                                            </span>
                                            <form method="POST" action="/aircraft/<%= aircraft.id %>/ad-compliance/<%= item.aircraft_compliance_id %>/update-status?_csrf=<%= encodeURIComponent(csrfToken) %>" class="space-y-2">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500" for="ad-compliance-status-<%= item.aircraft_compliance_id %>">
                                                    AD Status
                                                </label>
                                                <select id="ad-compliance-status-<%= item.aircraft_compliance_id %>" name="status" class="w-full rounded border border-slate-300 px-2 py-1 text-xs text-slate-800">
                                                    <% ['DUE', 'IN_PROGRESS', 'COMPLIANT', 'NOT_APPLICABLE'].forEach((statusOption) => { %>
                                                        <option value="<%= statusOption %>" <%= item.aircraft_compliance_status === statusOption ? 'selected' : '' %>><%= statusOption %></option>
                                                    <% }) %>
                                                </select>
                                                <input type="text" name="compliance_method" value="<%= item.aircraft_compliance_method || '' %>" placeholder="Compliance method" class="w-full rounded border border-slate-300 px-2 py-1 text-xs text-slate-800">
                                                <textarea name="notes" rows="2" placeholder="Optional notes" class="w-full rounded border border-slate-300 px-2 py-1 text-xs text-slate-800"><%= item.aircraft_compliance_notes || '' %></textarea>
                                                <p class="text-[10px] font-semibold text-amber-700">
                                                    This updates operational AD compliance status only. It does not calculate due dates or create workpack tasks.
                                                </p>
                                                <button type="submit" class="rounded bg-blue-700 px-3 py-2 text-xs font-bold uppercase tracking-widest text-white hover:bg-blue-800">
                                                    Update AD Status
                                                </button>
                                            </form>
                                            <form method="POST" action="/aircraft/<%= aircraft.id %>/ad-compliance/<%= item.aircraft_compliance_id %>/update-due-data?_csrf=<%= encodeURIComponent(csrfToken) %>" class="space-y-2 border-t border-slate-200 pt-3">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500" for="ad-next-due-at-<%= item.aircraft_compliance_id %>">
                                                    Manual Due Date
                                                </label>
                                                <input id="ad-next-due-at-<%= item.aircraft_compliance_id %>" type="date" name="next_due_at" value="<%= item.aircraft_compliance_next_due_at || '' %>" class="w-full rounded border border-slate-300 px-2 py-1 text-xs text-slate-800">
                                                <label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500" for="ad-next-due-hours-<%= item.aircraft_compliance_id %>">
                                                    Manual Due Hours
                                                </label>
                                                <input id="ad-next-due-hours-<%= item.aircraft_compliance_id %>" type="number" min="0" step="0.01" name="next_due_hours" value="<%= item.aircraft_compliance_next_due_hours ?? '' %>" class="w-full rounded border border-slate-300 px-2 py-1 text-xs text-slate-800">
                                                <label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500" for="ad-last-complied-at-<%= item.aircraft_compliance_id %>">
                                                    Last Complied Date
                                                </label>
                                                <input id="ad-last-complied-at-<%= item.aircraft_compliance_id %>" type="date" name="last_complied_at" value="<%= item.aircraft_compliance_last_complied_at || '' %>" class="w-full rounded border border-slate-300 px-2 py-1 text-xs text-slate-800">
                                                <label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500" for="ad-last-complied-hours-<%= item.aircraft_compliance_id %>">
                                                    Last Complied Hours
                                                </label>
                                                <input id="ad-last-complied-hours-<%= item.aircraft_compliance_id %>" type="number" min="0" step="0.01" name="last_complied_hours" value="<%= item.aircraft_compliance_last_complied_hours ?? '' %>" class="w-full rounded border border-slate-300 px-2 py-1 text-xs text-slate-800">
                                                <input type="text" name="compliance_method" value="<%= item.aircraft_compliance_method || '' %>" placeholder="Compliance method" class="w-full rounded border border-slate-300 px-2 py-1 text-xs text-slate-800">
                                                <textarea name="notes" rows="2" placeholder="Optional due notes" class="w-full rounded border border-slate-300 px-2 py-1 text-xs text-slate-800"><%= item.aircraft_compliance_notes || '' %></textarea>
                                                <p class="text-[10px] font-semibold text-amber-700">
                                                    This records manual AD due data. It does not calculate recurring due requirements or create workpack tasks.
                                                </p>
                                                <button type="submit" class="rounded bg-indigo-700 px-3 py-2 text-xs font-bold uppercase tracking-widest text-white hover:bg-indigo-800">
                                                    Update Manual Due Data
                                                </button>
                                            </form>
                                        </div>
                                    <% } else if (item.compliance_assignment_id) { %>
                                        <form method="POST" action="/aircraft/<%= aircraft.id %>/ad-compliance-assignments/<%= item.compliance_assignment_id %>/create-operational-record?_csrf=<%= encodeURIComponent(csrfToken) %>">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="rounded bg-amber-700 px-3 py-2 text-xs font-bold uppercase tracking-widest text-white hover:bg-amber-800">
                                                Create Operational Compliance Record
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <form method="POST" action="/aircraft/<%= aircraft.id %>/ad-applicability/<%= item.id %>/create-compliance-assignment?_csrf=<%= encodeURIComponent(csrfToken) %>">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="rounded bg-slate-900 px-3 py-2 text-xs font-bold uppercase tracking-widest text-white hover:bg-slate-700">
                                                Create AD Compliance Assignment
                                            </button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>

    <% const sections = [
        { key: 'ad', label: 'Airworthiness Directives', badge: 'AD' },
        { key: 'sb', label: 'Service Bulletins', badge: 'SB' },
        { key: 'sid', label: 'Supplemental Inspection Documents', badge: 'SID' }
    ]; %>

    <% if (summary.total === 0) { %>
        <section class="rounded-lg bg-white p-10 text-center shadow">
            <h2 class="text-lg font-semibold text-slate-900">No applicable compliance items found.</h2>
            <p class="mt-2 text-sm text-slate-500">
                This aircraft currently has no AD, SB, or SID applicability results from the engine.
            </p>
        </section>
    <% } else { %>
        <% sections.forEach((section) => { %>
            <% const items = groupedItems[section.key] || []; %>
            <% if (items.length > 0) { %>
                <section class="mb-8 rounded-lg bg-white shadow">
                    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
                        <div>
                            <h2 class="text-lg font-semibold text-slate-900"><%= section.label %></h2>
                            <p class="mt-1 text-sm text-slate-500">
                                <%= items.length %> applicable item<%= items.length === 1 ? '' : 's' %>
                            </p>
                        </div>
                        <span class="rounded-full bg-slate-900 px-3 py-1 text-xs font-bold uppercase tracking-widest text-white">
                            <%= section.badge %>
                        </span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-slate-200">
                            <thead class="bg-slate-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Source Type</th>
                                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Reference</th>
                                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Title</th>
                                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Description</th>
                                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Interval</th>
                                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Applicability Reason</th>
                                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Source Table</th>
                                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Projected Compliance</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 bg-white">
                                <% items.forEach((item) => { %>
                                    <% const shortDescription = item.description && item.description.length > 140
                                        ? `${item.description.slice(0, 140)}...`
                                        : (item.description || '-'); %>
                                    <% const intervalParts = []; %>
                                    <% if (item.interval_hours !== null && item.interval_hours !== undefined) { intervalParts.push(`${item.interval_hours}h`); } %>
                                    <% if (item.interval_months !== null && item.interval_months !== undefined) { intervalParts.push(`${item.interval_months}m`); } %>
                                    <tr>
                                        <td class="px-4 py-4 text-sm font-semibold text-slate-900"><%= item.source_type %></td>
                                        <td class="px-4 py-4 text-sm text-slate-700"><%= item.reference || '-' %></td>
                                        <td class="px-4 py-4 text-sm text-slate-700"><%= item.title || '-' %></td>
                                        <td class="px-4 py-4 text-sm text-slate-600"><%= shortDescription %></td>
                                        <td class="px-4 py-4 text-sm text-slate-600"><%= intervalParts.length ? intervalParts.join(' / ') : '-' %></td>
                                        <td class="px-4 py-4 text-sm text-slate-600"><%= item.applicability_reason || '-' %></td>
                                        <td class="px-4 py-4 text-sm text-slate-600"><%= item.source_table || '-' %></td>
                                        <td class="px-4 py-4 text-sm text-slate-600"><%= item.is_projected_compliance ? 'true' : 'false' %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </section>
            <% } %>
        <% }) %>
    <% } %>
</main>

<%- include('../partials/footer') %>
