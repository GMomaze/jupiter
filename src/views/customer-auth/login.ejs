<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>JUPITER AMMS - Customer Login</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <style>
    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at top, rgba(37, 99, 235, 0.22), transparent 38%),
        linear-gradient(160deg, #08111f 0%, #10233b 55%, #17314e 100%);
      color: #e5eef9;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 24px;
      box-sizing: border-box;
    }

    .login-container {
      width: 100%;
      max-width: 440px;
      padding: 36px;
      border-radius: 20px;
      background: rgba(7, 16, 30, 0.88);
      border: 1px solid rgba(148, 163, 184, 0.2);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.42);
      backdrop-filter: blur(12px);
    }

    .eyebrow {
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-size: 11px;
      color: #7dd3fc;
      margin-bottom: 12px;
    }

    .login-title {
      font-size: 30px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .login-subtitle {
      font-size: 14px;
      color: #9fb1c7;
      margin-bottom: 28px;
      line-height: 1.5;
    }

    .message {
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 13px;
      margin-bottom: 18px;
    }

    .message.error {
      background: rgba(127, 29, 29, 0.85);
      color: #fecaca;
      border: 1px solid rgba(248, 113, 113, 0.28);
    }

    .message.success {
      background: rgba(6, 78, 59, 0.88);
      color: #ccfbf1;
      border: 1px solid rgba(45, 212, 191, 0.24);
    }

    .panel {
      background: rgba(15, 23, 42, 0.78);
      border: 1px solid rgba(148, 163, 184, 0.16);
      border-radius: 14px;
      padding: 18px;
      margin-bottom: 20px;
    }

    .panel-title {
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .panel-copy {
      font-size: 13px;
      color: #b9c7d8;
      line-height: 1.5;
      margin: 0;
    }

    .form-group {
      margin-bottom: 18px;
    }

    label {
      display: block;
      font-size: 13px;
      margin-bottom: 6px;
      color: #d6e2f0;
    }

    input {
      width: 100%;
      padding: 12px 13px;
      border-radius: 10px;
      border: 1px solid #334155;
      background: #09111f;
      color: #e5eef9;
      font-size: 14px;
      box-sizing: border-box;
    }

    input:focus {
      outline: none;
      border-color: #38bdf8;
      box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
    }

    .btn {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      color: white;
      background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
    }

    .btn.secondary {
      margin-top: 10px;
      background: transparent;
      border: 1px solid rgba(148, 163, 184, 0.3);
      color: #d9e7f5;
    }

    .footer-note {
      text-align: center;
      margin-top: 18px;
      font-size: 11px;
      color: #6f86a1;
    }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="eyebrow">Customer Access</div>
    <div class="login-title">Jupiter Customer Login</div>
    <div class="login-subtitle">Customer authentication is available. Customer dashboard and visibility features are intentionally not exposed in this phase.</div>

    <% if (messages && messages.error && messages.error.length) { %>
      <div class="message error"><%= messages.error[0] %></div>
    <% } %>

    <% if (messages && messages.success && messages.success.length) { %>
      <div class="message success"><%= messages.success[0] %></div>
    <% } %>

    <form method="POST" action="/customer-auth/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" required autofocus>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>

      <button class="btn" type="submit">Customer Login</button>
    </form>

    <form method="GET" action="/customer-auth/reset-password">
      <button class="btn secondary" type="submit">Forgot Password</button>
    </form>

    <div class="footer-note">
      &copy; <%= new Date().getFullYear() %> Jupiter AMMS
    </div>
  </div>
</body>
</html>
