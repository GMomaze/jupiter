<%- include('../../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-4">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-slate-900">Phase 5: Fleet Health & Inventory</h1>
    <div class="text-sm bg-slate-100 px-3 py-1 rounded text-slate-600 border">
      Server Time: <%= new Date().toISOString().split('T')[0] %>
    </div>
  </div>

  <div class="grid gap-8 mb-12">
    <h2 class="text-xl font-semibold text-slate-700">Active Fleet Status</h2>
    <% aircraft.forEach(ac => { %>
      <div class="bg-white border rounded-xl shadow-sm overflow-hidden">
        <div class="bg-slate-800 p-4 flex justify-between items-center text-white">
          <div>
            <h2 class="font-bold text-lg"><%= ac.registration %></h2>
            <p class="text-xs text-slate-400">S/N: <%= ac.serial_number %></p>
          </div>
          <span class="text-sm font-mono bg-slate-700 px-3 py-1 rounded">Current Airframe: <%= ac.total_hours %> hrs</span>
        </div>

        <table class="w-full text-left">
          <thead class="bg-slate-50 border-b text-xs font-bold text-slate-500 uppercase">
            <tr>
              <th class="px-6 py-3 text-center">Action</th>
              <th class="px-6 py-3">Component Model</th>
              <th class="px-6 py-3 font-mono">Serial</th>
              <th class="px-6 py-3">Install Base</th>
              <th class="px-6 py-3 text-blue-600">Current TSO</th>
              <th class="px-6 py-3">TBO Limit</th>
              <th class="px-6 py-3">Health</th>
            </tr>
          </thead>
          <tbody class="divide-y text-sm">
            <% if (ac.components && ac.components.length > 0) { %>
              <% ac.components.forEach(comp => { %>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4">
                    <%- include('../partials/component_actions', { component: { ...comp, status: 'INSTALLED' }, aircraft: aircraft }) %>
                  </td>
                  <td class="px-6 py-4 font-medium"><%= comp.model_name %></td>
                  <td class="px-6 py-4 font-mono text-xs"><%= comp.serial_number %></td>
                  <td class="px-6 py-4 text-slate-500"><%= comp.install_hours_airframe %> hrs</td>
                  <td class="px-6 py-4 font-bold text-blue-600"><%= comp.current_actual_tso %> hrs</td>
                  <td class="px-6 py-4 text-slate-500"><%= comp.tbo_hours %> hrs</td>
                  <td class="px-6 py-4">
                    <span class="px-2 py-1 rounded-full text-[10px] font-bold uppercase
                      <%= comp.maintenance_status === 'NORMAL' ? 'bg-green-100 text-green-700 border border-green-200' : 'bg-red-100 text-red-700 border border-red-200' %>">
                      <%= comp.maintenance_status %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="px-6 py-10 text-center text-slate-400 italic">No components currently installed.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% }) %>
  </div>

  <hr class="my-10 border-slate-200">

  <div class="grid gap-6">
    <h2 class="text-xl font-semibold text-slate-700">Serviceable Inventory (On Shelf)</h2>
    <div class="bg-white border border-dashed border-slate-300 rounded-xl overflow-hidden">
      <table class="w-full text-left">
        <thead class="bg-slate-50 border-b text-xs font-bold text-slate-500 uppercase">
          <tr>
            <th class="px-6 py-3 text-center">Action</th>
            <th class="px-6 py-3">Component Model</th>
            <th class="px-6 py-3 font-mono">Serial</th>
            <th class="px-6 py-3">Last Known TSO</th>
            <th class="px-6 py-3">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y text-sm bg-slate-50/50">
          <% if (typeof uninstalled !== 'undefined' && uninstalled.length > 0) { %>
            <% uninstalled.forEach(item => { %>
              <tr>
                <td class="px-6 py-4">
                  <%- include('../partials/component_actions', { component: { ...item, status: 'SERVICEABLE' }, aircraft: aircraft }) %>
                </td>
                <td class="px-6 py-4 font-medium"><%= item.model_name || 'Generic Component' %></td>
                <td class="px-6 py-4 font-mono text-xs"><%= item.serial_number %></td>
                <td class="px-6 py-4"><%= item.tso_at_install %> hrs</td>
                <td class="px-6 py-4">
                  <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded-full text-[10px] font-bold border border-blue-200">SERVICEABLE</span>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-slate-400 italic">No serviceable components in store.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>