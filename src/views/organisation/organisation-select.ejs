<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jupiter — Select Organisation</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center p-6">
  <main class="w-full max-w-xl rounded-xl bg-slate-900 border border-slate-700 p-8 shadow-xl">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Jupiter AMMS</p>
    <h1 class="mt-2 text-3xl font-black">Select Organisation</h1>
    <p class="mt-3 text-sm text-slate-300">Choose the organisation you are authorised to access.</p>

    <form method="POST" action="/organisation/select" class="mt-8 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% organisations.forEach(function(organisation) { %>
        <label class="block cursor-pointer rounded-lg border border-slate-700 p-4 hover:border-blue-400">
          <input type="radio" name="tenant_public_id" value="<%= organisation.tenantPublicId %>" required>
          <span class="ml-2 font-bold"><%= organisation.tenantDisplayName %></span>
          <span class="ml-2 text-sm text-slate-400"><%= organisation.tenantCode %></span>
        </label>
      <% }); %>
      <button type="submit" class="w-full rounded bg-blue-600 px-4 py-3 font-bold hover:bg-blue-500">Continue</button>
    </form>

    <form method="POST" action="/auth/logout" class="mt-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="w-full rounded border border-slate-600 px-4 py-2 text-sm font-bold hover:bg-slate-800">Logout</button>
    </form>
  </main>
</body>
</html>
