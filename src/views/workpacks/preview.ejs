<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <a href="/workpacks/planner<%= maintenanceType ? `?maintenance_type=${maintenanceType}&planning_aircraft_id=${aircraftId}` : '' %>" class="text-sm font-medium text-blue-600 hover:text-blue-800">
      Back to Planner
    </a>
    <h1 class="mt-3 text-3xl font-bold text-gray-900">Workpack Preview</h1>
    <p class="mt-1 text-sm text-gray-500">
      Review candidate content, remove or re-add items, then generate a workpack using the existing template generation flow.
    </p>
  </div>

  <% if (planningSession) { %>
    <section class="mb-6 rounded-lg border <%= planningSession.status === 'GENERATED' ? 'border-green-200 bg-green-50' : planningSession.status === 'READY_FOR_GENERATION' ? 'border-blue-200 bg-blue-50' : planningSession.status === 'IN_PROGRESS' ? 'border-amber-200 bg-amber-50' : 'border-slate-200 bg-slate-50' %> px-4 py-3 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider <%= planningSession.status === 'GENERATED' ? 'text-green-700' : planningSession.status === 'READY_FOR_GENERATION' ? 'text-blue-700' : planningSession.status === 'IN_PROGRESS' ? 'text-amber-700' : 'text-slate-700' %>">
        Planning Session <%= planningSession.status %>
      </p>
      <p class="mt-1 text-sm <%= planningSession.status === 'GENERATED' ? 'text-green-900' : planningSession.status === 'READY_FOR_GENERATION' ? 'text-blue-900' : planningSession.status === 'IN_PROGRESS' ? 'text-amber-900' : 'text-slate-900' %>">
        <%= planningSession.status === 'GENERATED'
          ? 'This planning session has been finalized and is now read-only.'
          : planningSession.status === 'READY_FOR_GENERATION'
            ? 'This planning session is valid and ready for explicit generation confirmation.'
            : planningSession.status === 'IN_PROGRESS'
              ? 'This planning session is actively being edited. Saving again overwrites the current session state.'
              : 'This planning session exists but has not yet moved into active editing.' %>
      </p>
    </section>
  <% } %>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm lg:col-span-1">
      <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500">Template Details</h2>
      <% if (preview.template) { %>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="font-semibold text-gray-700">Template Name</dt>
            <dd class="text-gray-900"><%= preview.template.name %></dd>
          </div>
          <div>
            <dt class="font-semibold text-gray-700">Template Type</dt>
            <dd class="text-gray-900"><%= preview.template.template_type %></dd>
          </div>
          <div>
            <dt class="font-semibold text-gray-700">Model ID</dt>
            <dd class="break-all text-gray-900"><%= preview.template.model_id %></dd>
          </div>
          <div>
            <dt class="font-semibold text-gray-700">Active</dt>
            <dd class="text-gray-900"><%= preview.template.is_active ? 'YES' : 'NO' %></dd>
          </div>
        </dl>
      <% } else { %>
        <p class="mt-4 text-sm text-gray-500">Template not resolved for preview.</p>
      <% } %>
    </section>

    <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm lg:col-span-1">
      <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500">Aircraft Details</h2>
      <% if (preview.aircraft) { %>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="font-semibold text-gray-700">Registration</dt>
            <dd class="text-gray-900"><%= preview.aircraft.registration %></dd>
          </div>
          <div>
            <dt class="font-semibold text-gray-700">Aircraft Model</dt>
            <dd class="text-gray-900"><%= preview.aircraft.model_name || 'Unknown' %></dd>
          </div>
          <div>
            <dt class="font-semibold text-gray-700">Model ID</dt>
            <dd class="break-all text-gray-900"><%= preview.aircraft.model_id %></dd>
          </div>
        </dl>
      <% } else { %>
        <p class="mt-4 text-sm text-gray-500">Aircraft not resolved for preview.</p>
      <% } %>
    </section>

    <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm lg:col-span-1">
      <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500">Generation Status</h2>
      <div class="mt-4">
        <span class="inline-flex rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide <%= preview.can_generate ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
          <%= preview.can_generate ? 'CAN GENERATE' : 'BLOCKED' %>
        </span>
      </div>

      <dl class="mt-4 space-y-3 text-sm">
        <div>
          <dt class="font-semibold text-gray-700">Template ID</dt>
          <dd class="break-all text-gray-900"><%= templateId %></dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-700">Aircraft ID</dt>
          <dd class="break-all text-gray-900"><%= aircraftId %></dd>
        </div>
      </dl>

      <div class="mt-5">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500">Blocking Errors</h3>
        <% if (preview.blocking_errors && preview.blocking_errors.length > 0) { %>
          <ul class="mt-3 space-y-2 text-sm text-red-700">
            <% preview.blocking_errors.forEach(error => { %>
              <li class="rounded border border-red-200 bg-red-50 px-3 py-2"><%= error %></li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="mt-3 text-sm text-gray-500">No blocking errors.</p>
        <% } %>
      </div>
    </section>
  </div>

  <section class="mt-8 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500">Summary</h2>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Items</p>
        <p class="mt-2 text-2xl font-black text-slate-900"><%= preview.summary.total_items %></p>
      </div>
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Standard Tasks</p>
        <p class="mt-2 text-2xl font-black text-slate-900"><%= preview.summary.standard_task_count %></p>
      </div>
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Compliance Items</p>
        <p class="mt-2 text-2xl font-black text-slate-900"><%= preview.summary.compliance_item_count %></p>
      </div>
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">SID Items</p>
        <p class="mt-2 text-2xl font-black text-slate-900"><%= preview.summary.sid_count %></p>
      </div>
    </div>

    <div class="mt-6 border-t border-gray-200 pt-6">
      <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500">Commit Action</h3>
      <p class="mt-2 text-sm text-gray-500">
        Preview validation runs immediately before generation. Use the item list below to remove or re-add candidate content before confirming generation.
      </p>
    </div>
  </section>

  <% if (typeof commitResult !== 'undefined' && commitResult) { %>
    <section class="mt-8 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500">Generation Result</h2>
      <div class="mt-4">
        <span class="inline-flex rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide <%= commitResult.status === 'SUCCESS' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
          <%= commitResult.status %>
        </span>
      </div>

      <dl class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 text-sm">
        <div class="rounded-lg bg-slate-50 p-4">
          <dt class="font-semibold text-gray-700">Generated Workpack ID</dt>
          <dd class="mt-1 break-all text-gray-900"><%= commitResult.workpack_id || 'N/A' %></dd>
        </div>
        <div class="rounded-lg bg-slate-50 p-4">
          <dt class="font-semibold text-gray-700">Tasks Created</dt>
          <dd class="mt-1 text-gray-900"><%= commitResult.tasks_created %></dd>
        </div>
        <div class="rounded-lg bg-slate-50 p-4">
          <dt class="font-semibold text-gray-700">Executions Created</dt>
          <dd class="mt-1 text-gray-900"><%= commitResult.executions_created %></dd>
        </div>
        <div class="rounded-lg bg-slate-50 p-4">
          <dt class="font-semibold text-gray-700">Status</dt>
          <dd class="mt-1 text-gray-900"><%= commitResult.status %></dd>
        </div>
      </dl>

      <div class="mt-5">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500">Errors</h3>
        <% if (commitResult.errors && commitResult.errors.length > 0) { %>
          <ul class="mt-3 space-y-2 text-sm text-red-700">
            <% commitResult.errors.forEach(error => { %>
              <li class="rounded border border-red-200 bg-red-50 px-3 py-2"><%= error %></li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="mt-3 text-sm text-gray-500">No errors.</p>
        <% } %>
      </div>
    </section>
  <% } %>

  <section class="mt-8 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500">Preview Items</h2>
        <p class="mt-1 text-sm text-gray-500">
          Ordered preview of all applicable template items. Select the content you want in the generated workpack. No records have been created yet.
        </p>
      </div>
    </div>

    <% if (preview.items && preview.items.length > 0) { %>
      <form method="POST" action="/workpacks/templates/<%= templateId %>/aircraft/<%= aircraftId %>/generate" class="mt-6">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="maintenance_type" value="<%= maintenanceType || '' %>">
        <input type="hidden" name="template_id" value="<%= templateId %>">
        <input type="hidden" name="aircraft_id" value="<%= aircraftId %>">
        <input type="hidden" name="session_id" value="<%= planningSession?.id || '' %>">

        <div class="mb-4 flex flex-wrap items-center gap-2">
          <button type="button" id="select-all-preview-items" <%= planningSession?.status === 'GENERATED' ? 'disabled' : '' %> class="rounded border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50">
            Select All
          </button>
          <button type="button" id="clear-all-preview-items" <%= planningSession?.status === 'GENERATED' ? 'disabled' : '' %> class="rounded border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50">
            Clear All
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">Include</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">Seq</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">Type</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">Source Ref</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">Title</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">Description</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">Required</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">Notes</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">Validation</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">Validation Errors</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% preview.items.forEach(item => { %>
                <% const isSelected = !selectedItemIds || selectedItemIds.includes(item.template_item_id); %>
                <tr class="align-top hover:bg-gray-50">
                  <td class="px-4 py-4 text-sm text-gray-700">
                    <input
                      type="checkbox"
                      name="selected_item_ids"
                      value="<%= item.template_item_id %>"
                      class="preview-item-checkbox h-4 w-4 rounded border-gray-300 text-slate-900 focus:ring-slate-500"
                      <%= isSelected ? 'checked' : '' %>
                      <%= planningSession?.status === 'GENERATED' ? 'disabled' : '' %>
                    >
                  </td>
                  <td class="px-4 py-4 text-sm font-semibold text-gray-900"><%= item.sequence_no %></td>
                  <td class="px-4 py-4 text-sm text-gray-700"><%= item.item_type %></td>
                  <td class="px-4 py-4 text-sm text-gray-700"><%= item.source_reference || 'N/A' %></td>
                  <td class="px-4 py-4 text-sm font-medium text-gray-900"><%= item.title || 'N/A' %></td>
                  <td class="px-4 py-4 text-sm text-gray-700 whitespace-pre-wrap"><%= item.description || 'N/A' %></td>
                  <td class="px-4 py-4 text-sm text-gray-700"><%= item.is_required ? 'YES' : 'NO' %></td>
                  <td class="px-4 py-4 text-sm text-gray-700 whitespace-pre-wrap"><%= item.notes || 'N/A' %></td>
                  <td class="px-4 py-4">
                    <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-wide <%= item.validation_status === 'READY' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                      <%= item.validation_status %>
                    </span>
                  </td>
                  <td class="px-4 py-4 text-sm text-gray-700">
                    <% if (item.validation_errors && item.validation_errors.length > 0) { %>
                      <ul class="space-y-2">
                        <% item.validation_errors.forEach(error => { %>
                          <li class="rounded border border-red-200 bg-red-50 px-2 py-1 text-red-700"><%= error %></li>
                        <% }) %>
                      </ul>
                    <% } else { %>
                      <span class="text-gray-500">None</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="mt-6 border-t border-gray-200 pt-6">
          <div class="flex flex-wrap items-center gap-3">
            <% if (!planningSession || planningSession.status !== 'GENERATED') { %>
              <button
                type="submit"
                formaction="/workpacks/planning-sessions/save"
                class="inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-50"
              >
                Save Planning Session
              </button>
            <% } %>

            <% if (preview.can_generate && (!planningSession || planningSession.status !== 'GENERATED')) { %>
            <button
              type="submit"
              class="inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-black"
            >
              <%= planningSession ? 'Finalize & Generate Workpack' : 'Generate Workpack' %>
            </button>
            <% } %>
          </div>

          <% if (!preview.can_generate) { %>
            <div class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
              Generation is blocked until all preview errors are resolved.
            </div>
          <% } else if (planningSession?.status === 'GENERATED') { %>
            <div class="mt-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700">
              This planning session is closed and can no longer be changed.
            </div>
          <% } %>
        </div>
      </form>
    <% } else { %>
      <p class="mt-6 text-sm text-gray-500">No preview items available.</p>
    <% } %>
  </section>
</main>

<script>
  (function () {
    const checkboxes = Array.from(document.querySelectorAll('.preview-item-checkbox'));
    const selectAllButton = document.getElementById('select-all-preview-items');
    const clearAllButton = document.getElementById('clear-all-preview-items');

    selectAllButton?.addEventListener('click', function () {
      checkboxes.forEach((checkbox) => {
        checkbox.checked = true;
      });
    });

    clearAllButton?.addEventListener('click', function () {
      checkboxes.forEach((checkbox) => {
        checkbox.checked = false;
      });
    });
  })();
</script>

<%- include('../partials/footer') %>
