<%- include('../../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <%
    const canAccessExecution = user?.roles?.some(
      role => role.code === 'ENGINEER' || role.code === 'MECHANIC' || role.code === 'SUPERVISOR'
    );
    const workpackStatusCode = String(pack?.status_code || '').trim().toUpperCase();
  %>
  <div class="flex justify-between items-start mb-8 bg-white p-6 rounded-xl border shadow-sm">
    <div>
      <nav class="text-sm text-slate-500 mb-2">
        <a href="/workpacks" class="hover:text-blue-600">Workpack Fleet</a> / 
        <span class="text-slate-800">Detail & Integrity Report</span>
      </nav>
      <h1 class="text-3xl font-bold text-slate-900">WO: <%= pack.work_order_number %></h1>
      <p class="text-slate-600 font-medium">Aircraft: <span class="text-blue-600"><%= pack.registration %></span></p>
      <p class="text-xs text-slate-400 mt-1">S/N: <%= pack.serial_number %> | Airframe Hours: <%= pack.total_hours %></p>
    </div>
    <div class="text-right">
      <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Current Status</p>
      <span class="px-4 py-1.5 rounded-full font-bold text-sm border 
        <%= pack.status_code === 'DRAFT' ? 'bg-slate-100 text-slate-600 border-slate-300' : 
           pack.status_code === 'CLOSED' ? 'bg-green-100 text-green-700 border-green-300' : 
           'bg-blue-100 text-blue-700 border-blue-300' %>">
        <%= workpackStatusCode %>
      </span>
    </div>
  </div>

  <div class="mb-6 flex flex-wrap gap-3">
    <a
      href="/workpacks/<%= pack.id %>/tasks"
      class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50"
    >
      Tasks
    </a>
    <% if (canAccessExecution) { %>
      <a
        href="/workpacks/<%= pack.id %>/execution"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50"
      >
        Execution
      </a>
    <% } %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 bg-white rounded-xl border shadow-sm overflow-hidden">
      <div class="bg-slate-50 px-6 py-4 border-b">
        <h3 class="text-sm font-bold text-slate-700 uppercase">Task Execution Details</h3>
      </div>
      <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50 border-b">
          <tr>
            <th class="px-6 py-3 text-xs font-bold text-slate-500 uppercase">Task</th>
            <th class="px-6 py-3 text-xs font-bold text-slate-500 uppercase">Component S/N</th>
            <th class="px-6 py-3 text-xs font-bold text-slate-500 uppercase">Sign-off</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <% tasks.forEach(task => { %>
            <tr class="hover:bg-slate-50">
              <td class="px-6 py-4">
                <p class="font-bold text-slate-900 text-sm"><%= task.title %></p>
                <p class="text-xs text-slate-500"><%= task.description %></p>
              </td>
              <td class="px-6 py-4 font-mono text-sm text-slate-600">
                <%= task.component_serial || 'AIRFRAME' %>
              </td>
              <td class="px-6 py-4">
                <span class="text-xs font-bold <%= task.status === 'LOCKED' ? 'text-green-600' : 'text-amber-600' %>">
                  <%= task.status %>
                </span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="space-y-6">
      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <h3 class="text-sm font-bold text-slate-700 uppercase mb-4">Post-Closure Impact</h3>
        <div class="space-y-4">
          <div class="p-3 bg-blue-50 rounded border border-blue-100">
            <p class="text-xs text-blue-600 font-bold uppercase">Lifecycle Sync</p>
            <p class="text-sm text-blue-900 mt-1">
              Closing this pack will set TSO to <strong>0.00</strong> for all linked components.
            </p>
          </div>
          
          <% if (workpackStatusCode === 'CLOSED') { %>
            <div class="w-full rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-center text-sm font-semibold text-emerald-800">
              Workpack already CLOSED.
            </div>
          <% } else if (workpackStatusCode === 'CERTIFIED') { %>
            <form method="POST" action="/workpacks/<%= pack.id %>/close">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button
                type="submit"
                class="w-full bg-slate-900 text-white font-bold py-3 rounded-lg hover:bg-black transition-all shadow-lg">
                FINALIZE & CLOSE
              </button>
            </form>
          <% } else { %>
            <div class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-center text-sm text-slate-600">
              Final close becomes available only after CERTIFIED.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
