<%- include('../partials/header') %>

<main class="p-6 bg-slate-50 min-h-screen">

  <div class="flex justify-between items-start mb-8 bg-white p-6 rounded-xl border shadow-sm">
    <div>
      <nav class="text-sm text-slate-500 mb-2">
        <a href="/workpacks/planner" class="hover:text-blue-600">Planner</a> /
        <span class="text-slate-800">Tasks</span>
      </nav>

      <h1 class="text-3xl font-bold text-slate-900">
        WO: <%= pack.work_order_number %>
      </h1>

      <p class="text-slate-600 font-medium">
        Aircraft:
        <span class="text-blue-600">
          <%= pack.Aircraft?.registration || '' %>
        </span>
      </p>
    </div>

    <div class="text-right">
      <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">
        Current Lifecycle
      </p>

      <span class="px-4 py-1.5 rounded-full font-bold text-sm border
        <%= pack.WorkpackStatus?.code === 'DRAFT' ? 'bg-slate-100 text-slate-600 border-slate-300' :
           pack.WorkpackStatus?.code === 'RELEASED' ? 'bg-green-100 text-green-700 border-green-300' :
           'bg-blue-100 text-blue-700 border-blue-300' %>">
        <%= pack.WorkpackStatus?.code %>
      </span>
    </div>
  </div>

  <div class="grid gap-4">
    <% if (!tasks || tasks.length === 0) { %>
      <div class="bg-white border rounded-xl p-8 text-center text-slate-400 italic">
        No tasks currently assigned to this work pack.
      </div>
    <% } %>

    <% if (tasks) { %>
      <% tasks.forEach(task => { %>
        <%- include('../partials/task_row', { task, pack, user }) %>
      <% }) %>
    <% } %>
  </div>

  <div class="mt-6 flex justify-between items-center">
    <p class="text-sm text-slate-500">
      Total Work Items:
      <span class="font-bold text-slate-900">
        <%= tasks ? tasks.length : 0 %>
      </span>
    </p>

    <% if (pack.WorkpackStatus?.code === 'DRAFT' && tasks && tasks.length > 0 && user?.roles?.some(role => role.code === 'PLANNER')) { %>
      <button
        hx-post="/workpacks/<%= pack.id %>/issue"
        hx-confirm="Are you sure? This will lock the task list and move this pack to the hangar."
        hx-headers='{"x-csrf-token":"<%= csrfToken %>"}'
        class="bg-blue-600 text-white px-6 py-2 rounded-lg font-bold shadow-md hover:bg-blue-700 transition-all"
      >
        ISSUE WORK PACK
      </button>
    <% } %>
  </div>

  <% if (user?.roles?.some(role => role.code === 'ENGINEER')) { %>
    <% const allTasksCertified = tasks.length > 0 && tasks.every(task => task.status === 'CERTIFIED_BY_ENGINEER'); %>
    <div class="mt-8 border-t pt-8 flex justify-between items-center">
      <a
        href="/workpacks/<%= pack.id %>/execution"
        class="inline-block bg-slate-200 text-slate-800 px-6 py-3 rounded-lg font-bold hover:bg-slate-300"
      >
        Open Execution
      </a>

      <% if (pack.WorkpackStatus?.code === 'CERTIFIED') { %>
        <div class="text-right">
          <p class="text-sm font-semibold text-emerald-700">
            Workpack already certified
          </p>
          <p class="text-sm text-slate-500">
            This pack has already been engineer closed.
          </p>
        </div>
      <% } else if (pack.WorkpackStatus?.code === 'IN_PROGRESS' && allTasksCertified) { %>
        <form
          method="POST"
          action="/workpacks/<%= pack.id %>/close"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button
            type="submit"
            class="bg-emerald-700 text-white px-8 py-3 rounded-lg font-bold hover:bg-emerald-800"
          >
            Close Workpack
          </button>
        </form>
      <% } else if (pack.WorkpackStatus?.code === 'IN_PROGRESS') { %>
        <div class="text-right">
          <p class="text-sm font-semibold text-slate-700">
            Engineer close-out is locked
          </p>
          <p class="text-sm text-slate-500">
            Certify every task before the workpack can be closed.
          </p>
        </div>
      <% } else { %>
        <div class="text-right">
          <p class="text-sm font-semibold text-slate-700">
            Close-out unavailable
          </p>
          <p class="text-sm text-slate-500">
            Workpack must be in progress before engineer close-out is available.
          </p>
        </div>
      <% } %>
    </div>
  <% } %>

</main>

<%- include('../partials/footer') %>
