<%- include('../partials/header') %>

<main class="p-6 bg-slate-50 min-h-screen">
  <%
    const canManageWorkpacks = user?.roles?.some(role => role.code === 'PLANNER' || role.code === 'ADMIN');
    const canAccessExecution = user?.roles?.some(
      role => role.code === 'ENGINEER' || role.code === 'MECHANIC' || role.code === 'SUPERVISOR'
    );
    const workpackStatusCode = String(pack?.WorkpackStatus?.code || '').trim().toUpperCase();
    const totalTaskCount = tasks ? tasks.length : 0;
    const taskInProgressCount = tasks ? tasks.filter(task => task.status === 'IN_PROGRESS').length : 0;
    const taskWaitingEngineerCount = tasks ? tasks.filter(task => task.status === 'COMPLETED_BY_MECHANIC').length : 0;
    const taskCompleteCount = tasks ? tasks.filter(task => task.status === 'CERTIFIED_BY_ENGINEER' || task.status === 'LOCKED').length : 0;
    const taskOpenCount = tasks ? tasks.filter(task => task.status === 'OPEN').length : 0;
    const taskStatusSummary =
      totalTaskCount === 0
        ? 'No tasks'
        : tasks.every(task => task.status === 'CERTIFIED_BY_ENGINEER' || task.status === 'LOCKED')
        ? 'Tasks complete'
        : tasks.some(task => task.status === 'COMPLETED_BY_MECHANIC')
        ? 'Waiting for engineer sign off'
        : tasks.some(task => task.status === 'IN_PROGRESS')
        ? `${tasks.filter(task => task.status === 'IN_PROGRESS').length} in progress`
        : `${totalTaskCount} open`;
    const componentContext = componentExecutionContext || { summary: {}, items: [], explanation: '' };
    const componentContextSummary = componentContext.summary || {};
    const componentContextItems = componentContext.items || [];
  %>

  <!-- ✅ COMPACT HEADER -->
<div class="mb-8 rounded-xl border bg-white p-6 shadow-sm space-y-1">

  <!-- ROW 1 -->
  <div class="flex items-center justify-between">
    <!-- LEFT -->
    <nav class="mb-1 text-sm text-slate-500">
      <a href="/workpacks/planner" class="hover:text-blue-600">Planner</a> /
      <span class="text-slate-800">Tasks</span>
    </nav>
    <!-- CENTER (empty for row 1) -->
    <div></div>
    <!-- RIGHT (empty for row 1) -->
    <div></div>
  </div>

  <!-- ROW 2 -->
  <div class="flex items-center justify-between">
    <!-- LEFT -->
    <h1 class="text-2xl font-bold text-slate-900 leading-tight">
      WO: <%= pack.work_order_number %>
    </h1>

    <!-- CENTER -->
    <p class="text-sm font-semibold text-slate-800 leading-tight">
      <%= taskStatusSummary %>
    </p>

    <!-- RIGHT -->
    <div class="text-right">
      <p class="text-xs font-bold text-slate-400 uppercase tracking-widest leading-tight">
        Current Lifecycle
      </p>
    </div>
  </div>

  <!-- ROW 3 -->
  <div class="flex items-center justify-between">
    <!-- LEFT -->
    <p class="text-slate-600 text-sm">
      Aircraft:
      <span class="text-blue-600 font-medium">
        <%= pack.Aircraft?.registration || '' %>
      </span>
    </p>

    <!-- CENTER -->
    <div class="flex flex-wrap items-center justify-center gap-2">
      <span class="rounded-full bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-700">
        In Progress: <%= taskInProgressCount %>
      </span>
      <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700">
        Waiting Engineer: <%= taskWaitingEngineerCount %>
      </span>
      <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700">
        Complete: <%= taskCompleteCount %>
      </span>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">
        Open: <%= taskOpenCount %>
      </span>
    </div>

    <!-- RIGHT -->
    <span class="inline-block mt-1 px-3 py-1 rounded-full font-bold text-xs border
        <%= pack.WorkpackStatus?.code === 'DRAFT' ? 'bg-slate-100 text-slate-600 border-slate-300' :
           pack.WorkpackStatus?.code === 'CLOSED' ? 'bg-green-100 text-green-700 border-green-300' :
           'bg-blue-100 text-blue-700 border-blue-300' %>">
        <%= workpackStatusCode %>
      </span>
  </div>
</div>
<!-- ------------------------------------------------------------------- -->


  <div class="mb-6 flex flex-wrap gap-3">
    <a
      href="/workpacks/<%= pack.id %>/snags"
      class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50"
    >
      Snags
    </a>
    <a
      href="/workpacks/<%= pack.id %>/tasks"
      class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white"
    >
      Tasks
    </a>
    <% if (canAccessExecution) { %>
      <a
        href="/workpacks/<%= pack.id %>/execution"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50"
      >
        Execution
      </a>
    <% } %>
    <a
      href="/workpacks/<%= pack.id %>/service-bulletins"
      class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50"
    >
      Service Bulletins
    </a>
    <a
      href="/workpacks/<%= pack.id %>/audit"
      class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50"
    >
      Audit
    </a>
    <%- include('../partials/workpack-pdf-menu', { pack }) %>
  </div>

  <section class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-black uppercase tracking-widest text-slate-400">Serialized Component Due Visibility</p>
        <p class="mt-2 text-sm text-slate-600"><%= componentContext.explanation || 'No serialized-component context is available for this workpack.' %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">
          Installed: <%= componentContextSummary.installed_serialized_count || 0 %>
        </span>
        <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
          Due: <%= componentContextSummary.due_count || 0 %>
        </span>
        <span class="rounded-full bg-rose-50 px-3 py-1 text-xs font-bold text-rose-700">
          Overdue: <%= componentContextSummary.overdue_count || 0 %>
        </span>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">
          Unknown: <%= componentContextSummary.unknown_due_count || 0 %>
        </span>
      </div>
    </div>

    <% if (componentContextItems.length > 0) { %>
      <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        <% componentContextItems.forEach((item) => { %>
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm text-slate-700">
            <div class="font-semibold text-slate-900">
              <%= item.position || 'Position Not Captured' %> | SN <%= item.serial_number %>
            </div>
            <div class="mt-1 text-xs text-slate-500">
              <%= item.manufacturer_name || 'Unknown Manufacturer' %> <%= item.model_name %>
              <% if (item.model_code) { %> | <%= item.model_code %><% } %>
            </div>
            <div class="mt-2 font-semibold text-slate-900"><%= item.due_state.replace(/_/g, ' ') %></div>
            <div class="mt-1 text-xs leading-5 text-slate-600"><%= item.due_explanation %></div>
            <% if (item.due_worst_limit) { %>
              <div class="mt-2 text-xs text-slate-600">
                Worst: <%= item.due_worst_limit.limit_type || 'Life limit' %> |
                Hours <%= item.due_worst_limit.remaining_hours ?? '-' %> |
                Cycles <%= item.due_worst_limit.remaining_cycles ?? '-' %> |
                Days <%= item.due_worst_limit.remaining_calendar_days ?? '-' %>
              </div>
            <% } %>
            <% if (item.due_is_partial || item.due_has_unknown_limits) { %>
              <div class="mt-2 text-xs text-amber-700">
                <%= item.due_is_partial ? 'Partial calculation.' : 'Unknown limit data present.' %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <div class="grid gap-4">
    <% if (canShowAvailableTemplates) { %>
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="text-sm font-bold uppercase text-slate-800">Available Templates</h2>
            <p class="mt-1 text-xs text-slate-500">Compatible templates can be added directly to this workpack.</p>
          </div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
            <%= pack.Aircraft?.registration || '' %>
          </span>
        </div>

        <% if (!availableTemplates || availableTemplates.length === 0) { %>
          <p class="mt-3 text-xs italic text-slate-500">No remaining compatible templates for this workpack.</p>
        <% } else { %>
          <div class="mt-3 space-y-2">
            <% availableTemplates.forEach(template => { %>
              <div class="rounded border border-slate-200 bg-slate-50 p-3 flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-[9px] font-bold text-slate-500">#<%= template.task_card_number %></span>
                    <span class="text-sm font-medium text-slate-900 truncate"><%= template.title %></span>
                  </div>
                  <div class="flex gap-1">
                    <% if(template.is_required_for_wood) { %><span class="text-[8px] bg-orange-100 text-orange-700 px-1 rounded">WOOD</span><% } %>
                    <% if(template.is_required_for_fabric) { %><span class="text-[8px] bg-purple-100 text-purple-700 px-1 rounded">FABRIC</span><% } %>
                    <% if(template.is_required_for_bungees) { %><span class="text-[8px] bg-green-100 text-green-700 px-1 rounded">BUNGEE</span><% } %>
                  </div>
                </div>

                <% if (planningEditable && canManageWorkpacks) { %>
                  <form
                    method="POST"
                    action="/workpacks/templates/<%= template.id %>/add"
                    class="flex items-center gap-2"
                  >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="workpack_id" value="<%= pack.id %>">
                    <button type="submit" class="rounded bg-slate-800 px-3 py-1 text-[10px] text-white">
                      Add
                    </button>
                  </form>
                <% } else if (canManageWorkpacks) { %>
                  <span class="text-[10px] font-medium text-slate-400">Planning locked</span>
                <% } else { %>
                  <span class="text-[10px] font-medium text-slate-400">Planner/Admin only</span>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>

    <% if (!tasks || tasks.length === 0) { %>
      <div class="bg-white border rounded-xl p-8 text-center text-slate-400 italic">
        No tasks currently assigned to this work pack.
      </div>
    <% } %>

    <% if (tasks) { %>
      <% tasks.forEach(task => { %>
        <%- include('../partials/task_row', { task, pack, user }) %>
      <% }) %>
    <% } %>
  </div>

  <div class="mt-6 flex justify-between items-center">
    <p class="text-sm text-slate-500">
      Total Work Items:
      <span class="font-bold text-slate-900">
        <%= tasks ? tasks.length : 0 %>
      </span>
    </p>

    <% if (pack.WorkpackStatus?.code === 'DRAFT' && tasks && tasks.length > 0 && canManageWorkpacks) { %>
      <button
        hx-post="/workpacks/<%= pack.id %>/issue"
        hx-confirm="Are you sure? This will lock the task list and move this pack to the hangar."
        hx-headers='{"x-csrf-token":"<%= csrfToken %>"}'
        class="bg-blue-600 text-white px-6 py-2 rounded-lg font-bold shadow-md hover:bg-blue-700 transition-all"
      >
        ISSUE WORK PACK
      </button>
    <% } %>
  </div>

  <% if (canAccessExecution) { %>
    <% const openSnagCount = ((pack.Snags || []).filter((snag) => snag.status !== 'CLOSED')).length; %>
    <div class="mt-8 border-t pt-8 flex justify-between items-center">
      <a
        href="/workpacks/<%= pack.id %>/execution"
        class="inline-block bg-slate-200 text-slate-800 px-6 py-3 rounded-lg font-bold hover:bg-slate-300"
      >
        Open Execution
      </a>

      <% if (!user?.roles?.some(role => role.code === 'ENGINEER')) { %>
        <div class="text-right">
          <p class="text-sm font-semibold text-slate-700">
            Execution available
          </p>
          <p class="text-sm text-slate-500">
            Open the execution workspace to continue task activity and review current progress.
          </p>
        </div>
      <% } else if (workpackStatusCode === 'CLOSED') { %>
        <div class="text-right">
          <p class="text-sm font-semibold text-emerald-700">Workpack already closed</p>
          <p class="text-sm text-slate-500">
            CLOSED is the final administrative state.
          </p>
        </div>
      <% } else if (workpackStatusCode === 'CERTIFIED') { %>
        <form method="POST" action="/workpacks/<%= pack.id %>/close">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button
            type="submit"
            class="bg-emerald-700 text-white px-8 py-3 rounded-lg font-bold hover:bg-emerald-800"
          >
            Close Workpack
          </button>
        </form>
      <% } else if (workpackStatusCode === 'IN_PROGRESS' && openSnagCount > 0) { %>
        <div class="text-right">
          <p class="text-sm font-semibold text-slate-700">
            Final close is blocked by snags
          </p>
          <p class="text-sm text-slate-500">
            Close the remaining <%= openSnagCount %> snag<%= openSnagCount === 1 ? '' : 's' %> before certification and final close.
          </p>
        </div>
      <% } else if (workpackStatusCode === 'IN_PROGRESS') { %>
        <div class="text-right">
          <p class="text-sm font-semibold text-slate-700">
            Final close is not yet available
          </p>
          <p class="text-sm text-slate-500">
            Certify the workpack from Execution before final close becomes available.
          </p>
        </div>
      <% } else { %>
        <div class="text-right">
          <p class="text-sm font-semibold text-slate-700">
            Close-out unavailable
          </p>
          <p class="text-sm text-slate-500">
            Workpack must reach CERTIFIED before final close is available.
          </p>
        </div>
      <% } %>
    </div>
  <% } %>

</main>

<%- include('../partials/footer') %>
