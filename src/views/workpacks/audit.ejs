<%- include('../partials/header') %>

<main class="p-6 bg-slate-50 min-h-screen">
  <div class="mb-8 rounded-xl border bg-white p-6 shadow-sm space-y-1">
    <div class="flex items-center justify-between">
      <nav class="mb-1 text-sm text-slate-500">
        <a href="/workpacks/planner" class="hover:text-blue-600">Planner</a> /
        <span class="text-slate-800">Audit</span>
      </nav>
      <div></div>
      <div></div>
    </div>

    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-slate-900 leading-tight">
        WO: <%= pack.work_order_number %>
      </h1>
      <p class="text-sm font-semibold text-slate-800 leading-tight">
        Workpack Audit Timeline
      </p>
      <div class="text-right">
        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest leading-tight">
          Current Lifecycle
        </p>
      </div>
    </div>

    <div class="flex items-center justify-between">
      <p class="text-slate-600 text-sm">
        Aircraft:
        <span class="text-blue-600 font-medium">
          <%= pack.Aircraft?.registration || '' %>
        </span>
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2">
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">
          Entries: <%= auditEntries.length %>
        </span>
      </div>

      <span class="inline-block mt-1 px-3 py-1 rounded-full font-bold text-xs border
        <%= pack.WorkpackStatus?.code === 'DRAFT' ? 'bg-slate-100 text-slate-600 border-slate-300' :
           pack.WorkpackStatus?.code === 'CLOSED' ? 'bg-green-100 text-green-700 border-green-300' :
           'bg-blue-100 text-blue-700 border-blue-300' %>">
        <%= pack.WorkpackStatus?.code %>
      </span>
    </div>
  </div>

  <div class="mb-6 flex flex-wrap gap-3">
    <a
      href="/workpacks/<%= pack.id %>/snags"
      class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50"
    >
      Snags
    </a>
    <a
      href="/workpacks/<%= pack.id %>/tasks"
      class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50"
    >
      Tasks
    </a>
    <a
      href="/workpacks/<%= pack.id %>/execution"
      class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50"
    >
      Execution
    </a>
    <a
      href="/workpacks/<%= pack.id %>/service-bulletins"
      class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50"
    >
      Service Bulletins
    </a>
    <a
      href="/workpacks/<%= pack.id %>/audit"
      class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white"
    >
      Audit
    </a>
  </div>

  <div class="mb-6 rounded-xl border bg-white p-5 shadow-sm">
    <form method="GET" action="/workpacks/<%= pack.id %>/audit" class="grid gap-4 lg:grid-cols-5">
      <div>
        <label class="mb-1 block text-[10px] font-bold uppercase tracking-widest text-slate-500">Entity Type</label>
        <select name="entity_type" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800">
          <option value="">All events</option>
          <option value="workpack" <%= filters?.entity_type === 'workpack' ? 'selected' : '' %>>Workpack</option>
          <option value="task" <%= filters?.entity_type === 'task' ? 'selected' : '' %>>Task</option>
          <option value="snag" <%= filters?.entity_type === 'snag' ? 'selected' : '' %>>Snag</option>
        </select>
      </div>

      <div>
        <label class="mb-1 block text-[10px] font-bold uppercase tracking-widest text-slate-500">User</label>
        <select name="user_id" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800">
          <option value="">All users</option>
          <% (availableUsers || []).forEach((auditUser) => { %>
            <option value="<%= auditUser.id %>" <%= filters?.user_id === auditUser.id ? 'selected' : '' %>><%= auditUser.name %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="mb-1 block text-[10px] font-bold uppercase tracking-widest text-slate-500">From</label>
        <input type="date" name="from" value="<%= filters?.from || '' %>" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800">
      </div>

      <div>
        <label class="mb-1 block text-[10px] font-bold uppercase tracking-widest text-slate-500">To</label>
        <input type="date" name="to" value="<%= filters?.to || '' %>" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800">
      </div>

      <div class="flex flex-col justify-end gap-2">
        <label class="inline-flex items-center gap-2 text-xs text-slate-600">
          <input type="checkbox" name="raw" value="1" <%= filters?.raw ? 'checked' : '' %>>
          Show raw values
        </label>
        <div class="flex gap-2">
          <button type="submit" class="flex-1 rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white">Apply</button>
          <a href="/workpacks/<%= pack.id %>/audit" class="flex-1 rounded-lg border border-slate-300 bg-white px-4 py-2 text-center text-sm font-bold text-slate-700">Clear</a>
        </div>
      </div>
    </form>
  </div>

  <% if (!auditEntries || auditEntries.length === 0) { %>
    <div class="rounded-xl border bg-white p-8 text-center italic text-slate-400 shadow-sm">
      No audit entries were found for this workpack.
    </div>
  <% } else { %>
    <div class="space-y-4">
      <% auditEntries.forEach((entry) => { %>
        <div class="rounded-xl border bg-white p-5 shadow-sm">
          <div class="flex gap-4">
            <div class="flex w-10 flex-col items-center">
              <span class="mt-1 h-3 w-3 rounded-full bg-slate-900"></span>
              <span class="mt-2 h-full w-px bg-slate-200"></span>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-slate-700">
                      <%= entry.filter_entity_type %>
                    </span>
                    <span class="rounded-full bg-blue-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-blue-700">
                      <%= entry.source.replace(/_/g, ' ') %>
                    </span>
                  </div>
                  <p class="mt-3 text-base font-bold text-slate-900"><%= entry.event_label %></p>
                  <p class="mt-1 text-sm font-semibold text-slate-700"><%= entry.entity_label %></p>
                  <% if (entry.event_description) { %>
                    <p class="mt-2 text-sm text-slate-600"><%= entry.event_description %></p>
                  <% } %>
                  <p class="mt-2 text-xs text-slate-500">
                    <%= entry.actor_name %>
                    <% if (entry.created_at) { %>
                      on <%= new Date(entry.created_at).toLocaleString('en-GB') %>
                    <% } %>
                  </p>
                </div>
              </div>

              <% if (filters?.raw) { %>
                <div class="mt-4 grid gap-4 lg:grid-cols-3">
                  <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Before</p>
                    <pre class="mt-2 whitespace-pre-wrap break-words text-xs text-slate-700"><%= JSON.stringify(entry.old_value ?? null, null, 2) %></pre>
                  </div>
                  <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">After</p>
                    <pre class="mt-2 whitespace-pre-wrap break-words text-xs text-slate-700"><%= JSON.stringify(entry.new_value ?? null, null, 2) %></pre>
                  </div>
                  <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Metadata</p>
                    <pre class="mt-2 whitespace-pre-wrap break-words text-xs text-slate-700"><%= JSON.stringify(entry.metadata ?? null, null, 2) %></pre>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
