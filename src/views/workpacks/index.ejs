<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <%
        const canAccessExecution = user?.roles?.some(
            role => role.code === 'ENGINEER' || role.code === 'MECHANIC' || role.code === 'SUPERVISOR'
        );
    %>
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Workpack Fleet</h1>
            <p class="mt-1 text-sm text-gray-500">Global overview of all maintenance work orders.</p>
        </div>
        <div class="flex space-x-3">
            <a href="/workpacks/planner" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                Open Planner
            </a>
        </div>
    </div>

    <div class="flex flex-col">
        <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
                <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Work Order</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Aircraft</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                                <th scope="col" class="relative px-6 py-3">
                                    <span class="sr-only">Actions</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% if (workpacks.length > 0) { %>
                                <% workpacks.forEach(wp => { %>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-blue-600">
                                            <%= wp.work_order_number %>
                                        </td>

                                        <!-- ✅ Aircraft is now clickable -->
                                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                                            <a href="/aircraft/<%= wp.registration %>" 
                                               class="text-blue-600 hover:text-blue-900 font-medium">
                                                <%= wp.registration %>
                                            </a>
                                        </td>

                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <% 
                                                let statusClass = 'bg-gray-100 text-gray-800';
                                                if (wp.status_code === 'ISSUED') statusClass = 'bg-blue-100 text-blue-800';
                                                if (wp.status_code === 'IN_PROGRESS') statusClass = 'bg-yellow-100 text-yellow-800';
                                                if (wp.status_code === 'CLOSED') statusClass = 'bg-green-100 text-green-800';
                                            %>
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= statusClass %>">
                                                <%= wp.status_label %>
                                            </span>
                                        </td>

                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                            <%= new Date(wp.created_at).toLocaleDateString() %>
                                        </td>

                                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                            <% if (canAccessExecution) { %>
                                                <a href="/workpacks/<%= wp.id %>/execution" class="mr-4 text-slate-700 hover:text-slate-900">
                                                    Open Execution
                                                </a>
                                            <% } %>
                                            <a href="/workpacks/<%= wp.id %>/tasks" class="text-blue-600 hover:text-blue-900">
                                                View Detail
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-500">
                                        No workpacks found. Go to the 
                                        <a href="/workpacks/planner" class="text-blue-600 underline">
                                            Planner
                                        </a> 
                                        to create one.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
