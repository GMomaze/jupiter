<%- include('../partials/header') %>

<main class="p-6 bg-slate-50 min-h-screen max-w-6xl mx-auto">

  <% if (!user?.roles?.some(role => role.code === 'ENGINEER' || role.code === 'MECHANIC' || role.code === 'SUPERVISOR')) { %>
    <div class="bg-red-100 text-red-700 p-4 rounded mb-6 text-center font-bold">
      Access Restricted - Engineer, Mechanic, or Supervisor Role Required
    </div>
  <% } else { %>
    <%
      const allSnags = Array.isArray(snags) ? snags : [];
      const activeSnags = Array.isArray(openSnags) ? openSnags : [];
      const possibleRecurringSnags = Array.isArray(snagPatterns) ? snagPatterns : [];
      const workpackStatusCode = String(pack?.WorkpackStatus?.code || '').trim().toUpperCase();
      const isMechanic = user?.roles?.some(role => role.code === 'MECHANIC');
      const isEngineer = user?.roles?.some(role => role.code === 'ENGINEER');
      const isSupervisor = user?.roles?.some(role => role.code === 'SUPERVISOR');
      const canStartSnag = isMechanic || isEngineer || isSupervisor;
      const canResolveSnag = isMechanic || isEngineer || isSupervisor;
      const componentContext = componentExecutionContext || { summary: {}, items: [], explanation: '' };
      const componentContextSummary = componentContext.summary || {};
      const componentContextItems = componentContext.items || [];
      const componentReferenceLookup = componentContext.reference_lookup || { task_by_id: {}, snag_by_id: {} };
      const executionOperationalContext = operationalMaturity || { summary: {}, task_visibility_cards: [], snag_visibility_cards: [], unmatched_references: [], explanation: '' };
      const executionOperationalSummary = executionOperationalContext.summary || {};
      const taskVisibilityCardLookup = Object.fromEntries((executionOperationalContext.task_visibility_cards || []).map(card => [card.task_id, card]));
      const snagVisibilityCardLookup = Object.fromEntries((executionOperationalContext.snag_visibility_cards || []).map(card => [card.snag_id, card]));
    %>

    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-black text-slate-900 uppercase tracking-tight">
          Execution Cockpit
        </h1>
        <p class="text-slate-500 font-medium">
          WO: <%= pack.work_order_number %> - <%= pack.Aircraft.registration %>
        </p>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/workpacks/<%= pack.id %>/audit"
          class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-bold uppercase tracking-widest text-slate-700 hover:bg-slate-50"
        >
          Audit
        </a>
        <%- include('../partials/workpack-pdf-menu', { pack }) %>
        <%- include('../partials/status-badge', { status: workpackStatusCode }) %>
      </div>
    </div>

    <% if (crsValidation && Array.isArray(crsValidation.issues) && crsValidation.issues.length > 0) { %>
      <div class="mb-8 rounded-xl border border-red-200 bg-red-50 px-6 py-5 shadow-sm">
        <p class="text-sm font-black uppercase tracking-widest text-red-700">
          <%= crsValidation.title || 'CRS cannot be generated' %>
        </p>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-red-900">
          <% crsValidation.issues.forEach((issue) => { %>
            <li class="leading-relaxed"><%= issue %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="grid gap-6">
      <div class="bg-white border-2 border-slate-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-slate-50 border-b flex flex-wrap justify-between items-center gap-4">
          <div>
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Serialized Components</span>
            <h2 class="text-lg font-bold text-slate-800">Execution Technical Context</h2>
            <p class="mt-1 text-xs text-slate-500">Derived serialized-component visibility for execution only. No lifecycle, compliance, or installation mutation occurs here.</p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-slate-200 text-slate-600 border border-slate-300">
              Installed: <%= componentContextSummary.installed_serialized_count || 0 %>
            </span>
            <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-amber-100 text-amber-700 border border-amber-200">
              Due: <%= componentContextSummary.due_count || 0 %>
            </span>
            <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-rose-100 text-rose-700 border border-rose-200">
              Overdue: <%= componentContextSummary.overdue_count || 0 %>
            </span>
            <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-blue-100 text-blue-700 border border-blue-200">
              Referenced: <%= componentContextSummary.referenced_record_count || 0 %>
            </span>
          </div>
        </div>

        <div class="p-6">
          <p class="text-sm text-slate-700"><%= componentContext.explanation || 'No serialized-component execution context is available for this workpack.' %></p>
          <p class="mt-2 text-xs uppercase tracking-widest text-slate-400">
            <%= componentContextSummary.aircraft_readiness_indicator ? componentContextSummary.aircraft_readiness_indicator.replace(/_/g, ' ') : 'NO AIRCRAFT READINESS SIGNAL' %> | <%= componentContextSummary.aircraft_readiness_explanation || 'Aircraft technical-status visibility is unavailable.' %>
          </p>

          <div class="mt-4 grid gap-4 xl:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Execution Headline</p>
              <p class="mt-2 text-sm font-semibold leading-6 text-slate-900"><%= executionOperationalSummary.headline || 'Execution technical visibility is available.' %></p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Task Matches</p>
              <p class="mt-2 text-2xl font-black text-slate-900"><%= executionOperationalSummary.task_serialized_match_count || 0 %></p>
              <p class="mt-2 text-xs leading-5 text-slate-600">Task component references matched safely to active serialized-component visibility.</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Snag Matches</p>
              <p class="mt-2 text-2xl font-black text-slate-900"><%= executionOperationalSummary.snag_serialized_match_count || 0 %></p>
              <p class="mt-2 text-xs leading-5 text-slate-600">Snag component references matched safely to active serialized-component visibility.</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Execution Boundary</p>
              <p class="mt-2 text-xs leading-5 text-slate-700"><%= executionOperationalSummary.operational_boundary_notice || 'Execution visibility only.' %></p>
            </div>
          </div>

          <% if ((executionOperationalContext.unmatched_references || []).length > 0) { %>
            <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Unmatched Execution References</p>
              <p class="mt-2 text-sm text-slate-600">These workpack references remain visible for explainability, but no active serialized-component match could be derived safely.</p>
              <div class="mt-3 space-y-2">
                <% executionOperationalContext.unmatched_references.forEach((reference) => { %>
                  <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700">
                    <span class="font-semibold text-slate-900"><%= reference.source_label %></span>
                    <span class="text-xs text-slate-500">(<%= reference.source_type %>)</span>
                    <div class="mt-1 text-xs text-slate-500"><%= reference.explanation %></div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <% if (componentContextItems.length === 0) { %>
            <div class="mt-4 rounded-lg border border-dashed px-6 py-6 text-sm text-slate-500">
              No active serialized components are currently installed on this workpack aircraft.
            </div>
          <% } else { %>
            <div class="mt-4 overflow-x-auto rounded-lg border">
              <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Component</th>
                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Position</th>
                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Due</th>
                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Compliance</th>
                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Traceability</th>
                    <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Workpack Refs</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                  <% componentContextItems.forEach((item) => { %>
                    <tr>
                      <td class="px-4 py-3 text-sm text-slate-700">
                        <div class="font-semibold text-slate-900">
                          <%= item.manufacturer_name || 'Unknown Manufacturer' %> <%= item.model_name %>
                        </div>
                        <div class="mt-1 text-slate-600">
                          <%= item.asset_type_code %> | SN <%= item.serial_number %>
                          <% if (item.model_code) { %>| <%= item.model_code %><% } %>
                        </div>
                      </td>
                      <td class="px-4 py-3 text-sm text-slate-700">
                        <div><%= item.position || 'Position Not Captured' %></div>
                        <div class="mt-1 text-xs text-slate-500">Installed <%= item.installed_at || '-' %></div>
                      </td>
                      <td class="px-4 py-3 text-sm text-slate-700">
                        <div class="font-semibold text-slate-900"><%= item.due_state.replace(/_/g, ' ') %></div>
                        <div class="mt-1 text-slate-600"><%= item.due_explanation %></div>
                      </td>
                      <td class="px-4 py-3 text-sm text-slate-700">
                        <div>Applicable: <span class="font-semibold text-slate-900"><%= item.compliance_counts.applicable %></span></div>
                        <div>Not Applicable: <span class="font-semibold text-slate-900"><%= item.compliance_counts.not_applicable %></span></div>
                        <div>Unknown: <span class="font-semibold text-slate-900"><%= item.compliance_counts.unknown %></span></div>
                        <div>Unsupported: <span class="font-semibold text-slate-900"><%= item.compliance_counts.unsupported %></span></div>
                      </td>
                      <td class="px-4 py-3 text-sm text-slate-700">
                        <div><%= item.installation_traceability %></div>
                        <div class="mt-1 text-xs uppercase tracking-widest text-slate-400">
                          Events <%= item.maintenance_event_count %> | Documents <%= item.document_count %>
                        </div>
                      </td>
                      <td class="px-4 py-3 text-sm text-slate-700">
                        <% if ((item.workpack_references || []).length === 0) { %>
                          <div class="text-slate-500">Not directly referenced</div>
                        <% } else { %>
                          <% item.workpack_references.forEach((reference) => { %>
                            <div>
                              <span class="font-semibold text-slate-900"><%= reference.source_label %></span>
                              <span class="text-xs text-slate-500">(<%= reference.match_basis.replace(/_/g, ' ') %>)</span>
                            </div>
                          <% }) %>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <div class="bg-white border-2 border-slate-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-slate-50 border-b flex flex-wrap justify-between items-center gap-4">
          <div>
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Snags</span>
            <h2 class="text-lg font-bold text-slate-800">Execution Snag Register</h2>
            <p class="mt-1 text-xs text-slate-500">Snag controls are separate from task controls and only use the snag lifecycle.</p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-slate-200 text-slate-600 border border-slate-300">
              Total: <%= allSnags.length %>
            </span>
            <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-amber-100 text-amber-700 border border-amber-200">
              Open: <%= activeSnags.length %>
            </span>
          </div>
        </div>

        <div class="p-6 grid grid-cols-1 xl:grid-cols-2 gap-6">
          <div class="space-y-4">
            <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
              <h3 class="text-[10px] font-bold text-amber-700 uppercase tracking-widest mb-3">Open Snags</h3>
              <% if (activeSnags.length === 0) { %>
                <p class="text-sm text-emerald-700 font-semibold">No open snags for this workpack.</p>
              <% } else { %>
                <div class="space-y-3">
                  <% activeSnags.forEach((snag) => { %>
                    <% const snagComponentReference = componentReferenceLookup.snag_by_id?.[snag.id] || null; %>
                    <% const snagVisibilityCard = snagVisibilityCardLookup[snag.id] || null; %>
                    <div class="rounded-lg border border-amber-200 bg-white px-4 py-3">
                      <div class="flex items-start justify-between gap-3">
                        <div>
                          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Snag</p>
                          <p class="text-sm font-semibold text-slate-900 whitespace-pre-wrap"><%= snag.defect_text || snag.description %></p>
                          <% if (snag.Component || snag.component_id) { %>
                            <p class="mt-2 text-xs text-slate-500">
                              Component:
                              <span class="font-medium text-slate-700">
                                <%= snag.Component?.position_code || snag.Component?.serial_number || snag.component_id %>
                              </span>
                            </p>
                          <% } %>
                        </div>
                        <div class="flex flex-col items-end gap-2">
                          <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-amber-100 text-amber-700 border border-amber-200">
                            <%= snag.status.replace(/_/g, ' ') %>
                          </span>
                        </div>
                      </div>
                      <p class="mt-2 text-xs text-slate-500">
                        Logged
                        <% if (snag.created_at) { %>
                          on <%= new Date(snag.created_at).toLocaleString('en-GB') %>
                        <% } %>
                      </p>
                      <% if (snagComponentReference) { %>
                        <p class="mt-2 text-xs text-slate-500">
                          <% if (snagComponentReference.serialized_component_id) { %>
                            Derived serialized reference:
                            <span class="font-semibold text-slate-700"><%= snagComponentReference.serialized_component_serial_number %></span>
                            <% if (snagComponentReference.serialized_component_position) { %>
                              at <span class="font-semibold text-slate-700"><%= snagComponentReference.serialized_component_position %></span>
                            <% } %>
                          <% } else { %>
                            Serialized component visibility could not be derived safely from this snag reference.
                          <% } %>
                        </p>
                      <% } %>
                      <% if (snagVisibilityCard) { %>
                        <div class="mt-3 grid gap-3 xl:grid-cols-2">
                          <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-3 text-sm text-slate-700">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Technical Context</p>
                            <p class="mt-2 font-semibold text-slate-900"><%= snagVisibilityCard.due_state ? snagVisibilityCard.due_state.replace(/_/g, ' ') : 'No due state derived' %></p>
                            <p class="mt-2 text-xs leading-5 text-slate-600"><%= snagVisibilityCard.compliance_summary %></p>
                          </div>
                          <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-3 text-sm text-slate-700">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Install/Remove Context</p>
                            <p class="mt-2 text-xs leading-5 text-slate-600"><%= snagVisibilityCard.install_remove_context %></p>
                          </div>
                        </div>
                        <% if (snagVisibilityCard.drilldown) { %>
                          <details class="mt-3 rounded-lg border border-slate-200 bg-slate-50 px-3 py-3">
                            <summary class="cursor-pointer text-[10px] font-black uppercase tracking-widest text-slate-500">Supporting Technical Drilldown</summary>
                            <div class="mt-3 text-xs leading-5 text-slate-600">
                              <div><span class="font-semibold text-slate-800">Component:</span> <%= snagVisibilityCard.drilldown.manufacturer_name || 'Unknown Manufacturer' %> <%= snagVisibilityCard.drilldown.model_name %> | SN <%= snagVisibilityCard.drilldown.serial_number %></div>
                              <div class="mt-1"><span class="font-semibold text-slate-800">Position:</span> <%= snagVisibilityCard.drilldown.position || 'Position Not Captured' %></div>
                              <div class="mt-1"><span class="font-semibold text-slate-800">Traceability:</span> <%= snagVisibilityCard.drilldown.installation_traceability %></div>
                              <div class="mt-1"><span class="font-semibold text-slate-800">Compliance:</span> <%= snagVisibilityCard.drilldown.compliance_explanation %></div>
                            </div>
                          </details>
                        <% } %>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>

            <% if (possibleRecurringSnags.length > 0) { %>
              <div class="rounded-xl border border-slate-200 bg-slate-100 p-4">
                <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">Recurring Snags</h3>
                <p class="text-sm text-slate-600 mb-3">Recurring snag detection is informational only and is derived from historical snag history on this aircraft.</p>
                <div class="space-y-3">
                  <% possibleRecurringSnags.forEach((pattern) => { %>
                    <div class="rounded-lg border border-slate-200 bg-white px-4 py-3">
                      <div class="flex items-start justify-between gap-3">
                        <div>
                          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Recurring Snag</p>
                          <p class="text-sm font-semibold text-slate-900 whitespace-pre-wrap"><%= pattern.normalised_description %></p>
                          <% if (pattern.component_id) { %>
                            <p class="mt-1 text-xs text-slate-500">Grouped with component-specific history.</p>
                          <% } %>
                        </div>
                        <div class="flex flex-col items-end gap-2">
                          <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-slate-100 text-slate-600 border border-slate-200">
                            <%= pattern.occurrence_count %> occurrences
                          </span>
                          <% if (pattern.recurring) { %>
                            <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-amber-100 text-amber-700 border border-amber-200">
                              Recurring Snag
                            </span>
                          <% } %>
                        </div>
                      </div>
                      <p class="mt-2 text-xs text-slate-500">
                        Latest occurrence:
                        <span class="font-medium text-slate-600">
                          <%= pattern.latest_created_at ? new Date(pattern.latest_created_at).toLocaleString('en-GB') : 'Unknown' %>
                        </span>
                      </p>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-3">All Snags</h3>
              <% if (allSnags.length === 0) { %>
                <p class="text-sm text-slate-500">No snags linked to this workpack have been recorded from execution yet.</p>
              <% } else { %>
                <div class="space-y-3">
                  <% allSnags.forEach((snag) => { %>
                    <% const snagComponentReference = componentReferenceLookup.snag_by_id?.[snag.id] || null; %>
                    <% const snagVisibilityCard = snagVisibilityCardLookup[snag.id] || null; %>
                    <div class="rounded-lg border border-slate-200 bg-white px-4 py-3">
                      <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Snag</p>
                          <p class="text-sm font-medium text-slate-900 whitespace-pre-wrap"><%= snag.defect_text || snag.description %></p>
                          <% if (snag.Component || snag.component_id) { %>
                            <p class="mt-1 text-xs text-slate-500">
                              Component:
                              <span class="font-medium text-slate-700">
                                <%= snag.Component?.position_code || snag.Component?.serial_number || snag.component_id %>
                              </span>
                            </p>
                          <% } %>
                          <p class="mt-1 text-xs text-slate-500">
                            <% if (snag.created_at) { %>
                              Logged <%= new Date(snag.created_at).toLocaleString('en-GB') %>
                            <% } else { %>
                              Created time unavailable
                            <% } %>
                          </p>
                        </div>
                        <span class="text-[10px] font-bold uppercase px-2 py-1 rounded border
                          <%= snag.status === 'CLOSED'
                            ? 'bg-emerald-100 text-emerald-700 border-emerald-200'
                            : snag.status === 'RESOLVED'
                              ? 'bg-blue-100 text-blue-700 border-blue-200'
                              : snag.status === 'IN_PROGRESS'
                                ? 'bg-amber-100 text-amber-700 border-amber-200'
                                : 'bg-slate-100 text-slate-700 border-slate-200' %>">
                          <%= snag.status.replace(/_/g, ' ') %>
                        </span>
                      </div>
                      <% if (snagComponentReference) { %>
                        <p class="mt-2 text-xs text-slate-500">
                          <% if (snagComponentReference.serialized_component_id) { %>
                            Derived serialized reference:
                            <span class="font-semibold text-slate-700"><%= snagComponentReference.serialized_component_serial_number %></span>
                            <% if (snagComponentReference.serialized_component_position) { %>
                              at <span class="font-semibold text-slate-700"><%= snagComponentReference.serialized_component_position %></span>
                            <% } %>
                          <% } else { %>
                            Serialized component visibility could not be derived safely from this snag reference.
                          <% } %>
                        </p>
                      <% } %>
                      <% if (snagVisibilityCard) { %>
                        <div class="mt-3 grid gap-3 xl:grid-cols-2">
                          <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-3 text-sm text-slate-700">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Reference Context</p>
                            <p class="mt-2 text-xs leading-5 text-slate-600"><%= snagVisibilityCard.reference_explanation %></p>
                          </div>
                          <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-3 text-sm text-slate-700">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Install/Remove Context</p>
                            <p class="mt-2 text-xs leading-5 text-slate-600"><%= snagVisibilityCard.install_remove_context %></p>
                          </div>
                        </div>
                        <% if (snagVisibilityCard.drilldown) { %>
                          <details class="mt-3 rounded-lg border border-slate-200 bg-slate-50 px-3 py-3">
                            <summary class="cursor-pointer text-[10px] font-black uppercase tracking-widest text-slate-500">Supporting Technical Drilldown</summary>
                            <div class="mt-3 text-xs leading-5 text-slate-600">
                              <div><span class="font-semibold text-slate-800">Component:</span> <%= snagVisibilityCard.drilldown.manufacturer_name || 'Unknown Manufacturer' %> <%= snagVisibilityCard.drilldown.model_name %> | SN <%= snagVisibilityCard.drilldown.serial_number %></div>
                              <div class="mt-1"><span class="font-semibold text-slate-800">Position:</span> <%= snagVisibilityCard.drilldown.position || 'Position Not Captured' %></div>
                              <div class="mt-1"><span class="font-semibold text-slate-800">Due Visibility:</span> <%= snagVisibilityCard.drilldown.due_explanation %></div>
                              <div class="mt-1"><span class="font-semibold text-slate-800">Compliance:</span> <%= snagVisibilityCard.drilldown.compliance_explanation %></div>
                            </div>
                          </details>
                        <% } %>
                      <% } %>

                      <% if (snag.status === 'OPEN' && canStartSnag) { %>
                        <form method="POST" action="/workpacks/<%= pack.id %>/snags/<%= snag.id %>/start" class="mt-3 flex justify-end">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="return_to" value="execution">
                          <button
                            type="submit"
                            class="bg-slate-800 text-white py-2 px-4 rounded-lg font-bold text-[11px] uppercase tracking-widest hover:bg-black transition-all shadow-sm">
                            Start Snag
                          </button>
                        </form>
                      <% } else if (snag.status === 'IN_PROGRESS' && canResolveSnag) { %>
                        <form method="POST" action="/workpacks/<%= pack.id %>/snags/<%= snag.id %>/complete" class="mt-3 space-y-3">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="return_to" value="execution">
                          <textarea
                            name="resolution_notes"
                            rows="3"
                            class="w-full rounded-lg border border-slate-200 p-3 text-sm text-slate-800 outline-none focus:border-blue-500"
                            placeholder="Enter snag resolution notes before resolving..."
                            required
                          ></textarea>
                          <div class="flex justify-end">
                            <button
                              type="submit"
                              class="bg-blue-600 text-white py-2 px-4 rounded-lg font-bold text-[11px] uppercase tracking-widest hover:bg-blue-700 transition-all shadow-sm">
                              Resolve Snag
                            </button>
                          </div>
                        </form>
                      <% } else if (snag.status === 'RESOLVED') { %>
                        <div class="mt-3 rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-[11px] font-bold uppercase tracking-widest text-blue-700">
                          Snag resolved. Closure remains separate from task completion and workpack certification.
                        </div>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>

            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <div class="mb-4">
                <h3 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Create Snag</h3>
                <p class="mt-2 text-sm text-slate-600">Log a snag directly from execution without changing any task or workpack status.</p>
              </div>

            <form method="POST" action="/workpacks/<%= pack.id %>/execution/snags" class="space-y-4">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="workpack_id" value="<%= pack.id %>">
              <input type="hidden" name="aircraft_id" value="<%= pack.Aircraft?.id || '' %>">
              <input type="hidden" name="created_by" value="<%= user?.id || '' %>">

              <textarea
                name="defect_text"
                rows="6"
                class="w-full rounded-lg border-2 border-slate-200 p-3 text-sm text-slate-800 outline-none focus:border-blue-500"
                placeholder="Describe the snag found during execution..."
                required
              ></textarea>

              <button
                type="submit"
                class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold text-xs uppercase tracking-widest hover:bg-blue-700 transition-all shadow-md">
                Create Snag
              </button>
            </form>
          </div>
        </div>
      </div>

      <% tasks.forEach(task => { %>
        <% const taskComponentReference = componentReferenceLookup.task_by_id?.[task.id] || null; %>
        <% const taskVisibilityCard = taskVisibilityCardLookup[task.id] || null; %>
        <div class="bg-white border-2 border-slate-200 rounded-xl shadow-sm overflow-hidden" id="task-container-<%= task.id %>">
          <div class="px-6 py-4 bg-slate-50 border-b flex justify-between items-center">
            <div>
              <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Task #<%= task.task_card_number %></span>
              <h2 class="text-lg font-bold text-slate-800"><%= task.title %></h2>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-slate-200 text-slate-600 border border-slate-300">
                <%= task.status.replace(/_/g, ' ') %>
              </span>
            </div>
          </div>

          <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-8">
            <% if (taskComponentReference) { %>
              <div class="lg:col-span-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
                <% if (taskComponentReference.serialized_component_id) { %>
                  <span class="font-semibold text-slate-900">Serialized reference:</span>
                  SN <%= taskComponentReference.serialized_component_serial_number %>
                  <% if (taskComponentReference.serialized_component_position) { %>
                    at <%= taskComponentReference.serialized_component_position %>
                  <% } %>
                  via <%= taskComponentReference.match_basis.replace(/_/g, ' ') %>.
                <% } else { %>
                  <span class="font-semibold text-slate-900">Component reference present:</span>
                  no active serialized component could be derived safely from current source data.
                <% } %>
                <div class="mt-1 text-xs text-slate-500"><%= taskComponentReference.explanation %></div>
              </div>
            <% } %>
            <% if (taskVisibilityCard) { %>
              <div class="lg:col-span-2 grid gap-4 xl:grid-cols-3">
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
                  <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Execution Component Visibility</p>
                  <p class="mt-2 font-semibold text-slate-900"><%= taskVisibilityCard.reference_label %></p>
                  <p class="mt-2 text-xs leading-5 text-slate-600"><%= taskVisibilityCard.reference_explanation %></p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
                  <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Due / Compliance Context</p>
                  <p class="mt-2 font-semibold text-slate-900"><%= taskVisibilityCard.due_state ? taskVisibilityCard.due_state.replace(/_/g, ' ') : 'No due state derived' %></p>
                  <% if (taskVisibilityCard.due_explanation) { %>
                    <p class="mt-2 text-xs leading-5 text-slate-600"><%= taskVisibilityCard.due_explanation %></p>
                  <% } %>
                  <p class="mt-2 text-xs leading-5 text-slate-600"><%= taskVisibilityCard.compliance_summary %></p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
                  <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Install/Remove Context</p>
                  <p class="mt-2 text-xs leading-5 text-slate-600"><%= taskVisibilityCard.install_remove_context %></p>
                </div>
              </div>
              <% if (taskVisibilityCard.drilldown) { %>
                <details class="lg:col-span-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
                  <summary class="cursor-pointer text-[10px] font-black uppercase tracking-widest text-slate-500">Supporting Technical Drilldown</summary>
                  <div class="mt-4 grid gap-3 xl:grid-cols-2 text-sm text-slate-700">
                    <div class="rounded-lg border border-slate-200 bg-white px-3 py-3">
                      <p class="font-semibold text-slate-900"><%= taskVisibilityCard.drilldown.manufacturer_name || 'Unknown Manufacturer' %> <%= taskVisibilityCard.drilldown.model_name %></p>
                      <p class="mt-1 text-xs text-slate-500"><%= taskVisibilityCard.drilldown.asset_type_code %> | SN <%= taskVisibilityCard.drilldown.serial_number %> | <%= taskVisibilityCard.drilldown.position || 'Position Not Captured' %></p>
                      <p class="mt-2 text-xs leading-5 text-slate-600"><%= taskVisibilityCard.drilldown.installation_traceability %></p>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-white px-3 py-3">
                      <p class="font-semibold text-slate-900"><%= taskVisibilityCard.drilldown.due_state.replace(/_/g, ' ') %></p>
                      <p class="mt-2 text-xs leading-5 text-slate-600"><%= taskVisibilityCard.drilldown.due_explanation %></p>
                      <p class="mt-2 text-xs leading-5 text-slate-600"><%= taskVisibilityCard.drilldown.compliance_explanation %></p>
                    </div>
                  </div>
                </details>
              <% } %>
            <% } %>
            
            <!-- Phase 3 Inputs -->
            <div class="space-y-4">
              <h3 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Maintenance Instructions</h3>
              <div class="bg-slate-50 border border-slate-200 rounded-lg p-5 text-sm text-slate-700 leading-relaxed whitespace-pre-wrap">
                <% 
                  let description = task.description || '';
                  let inputIndex = 0;
                  const isMechanic = user?.roles?.some(role => role.code === 'MECHANIC');
                  const isEngineer = user?.roles?.some(role => role.code === 'ENGINEER');
                  const isSupervisor = user?.roles?.some(role => role.code === 'SUPERVISOR');
                  const taskOwnedByCurrentUser = !!user?.id && task.assigned_to === user.id;
                  const canEditTask = !['CERTIFIED_BY_ENGINEER', 'LOCKED'].includes(task.status)
                    && isMechanic
                    && task.status === 'IN_PROGRESS'
                    && taskOwnedByCurrentUser;

                  let htmlDescription = description.replace(/\[\s*\]/g, () => {
                    inputIndex++;

                    if (!canEditTask) {
                      return `[value ${inputIndex}]`;
                    }

                    return `<input type="text"
                      data-task-id="${task.id}"
                      data-position="${inputIndex}"
                      class="measurement-input w-20 border-b-2 border-blue-400 bg-white text-black text-center font-bold outline-none mx-1"
                      placeholder="...">`;
                  });
                %>
                <%- htmlDescription %>
              </div>
            </div>

            <div class="flex flex-col">
              <h3 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">Work Performed / Findings</h3>

              <% if (canEditTask) { %>
                <form hx-post="/workpacks/tasks/<%= task.id %>/work-note" hx-trigger="change delay:800ms" class="flex-1 flex flex-col">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <textarea
                    id="payload-<%= task.id %>"
                    name="work_performed"
                    class="hidden"
                  ><%= task.work_performed || '' %></textarea>
                  <textarea
                    id="measurements-payload-<%= task.id %>"
                    name="measurements_payload"
                    class="hidden"
                  ></textarea>
                  <textarea
                    id="note-<%= task.id %>"
                    name="work_performed"
                    class="flex-1 w-full border-2 border-slate-200 rounded-lg p-3 text-sm focus:border-blue-500 outline-none min-h-[120px] transition-colors"
                    placeholder="Record findings or specific values here..."
                  ><%= task.work_performed || '' %></textarea>
                </form>
              <% } else { %>
                <div class="flex-1 w-full border-2 border-slate-200 rounded-lg p-3 text-sm min-h-[120px] bg-slate-50 text-slate-700 whitespace-pre-wrap"><%= task.work_performed || 'Read only' %></div>
              <% } %>

              <!-- 🔥 UPDATED BUTTON SECTION -->
              <div class="mt-6 pt-4 border-t flex gap-3">

                <% if (task.status === 'OPEN' && isMechanic) { %>
                  <button 
                    hx-post="/workpacks/tasks/<%= task.id %>/start"
                    hx-target="#task-container-<%= task.id %>"
                    hx-swap="outerHTML"
                    class="flex-1 bg-slate-800 text-white py-3 rounded-lg font-bold text-xs uppercase tracking-widest hover:bg-black transition-all shadow-md">
                    Start Task
                  </button>

                <% } else if (task.status === 'IN_PROGRESS' && canEditTask) { %>
                  <form
                    method="POST"
                    action="/workpacks/tasks/<%= task.id %>/complete"
                    hx-post="/workpacks/tasks/<%= task.id %>/complete"
                    hx-target="#task-container-<%= task.id %>"
                    hx-swap="outerHTML"
                    hx-confirm="Mark this task completed?"
                    hx-headers='{"x-csrf-token":"<%= csrfToken %>"}'
                    hx-on::after-request="if (event.detail.successful) window.location.reload()"
                    class="flex-1"
                  >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <textarea
                      id="complete-payload-<%= task.id %>"
                      name="work_performed"
                      class="hidden"
                    ><%= task.work_performed || '' %></textarea>
                    <textarea
                      id="complete-measurements-payload-<%= task.id %>"
                      name="measurements_payload"
                      class="hidden"
                    ></textarea>
                    <button
                      type="submit"
                      hx-disabled-elt="this"
                      class="w-full bg-emerald-600 text-white py-3 rounded-lg font-bold text-xs uppercase tracking-widest hover:bg-emerald-700 transition-all shadow-md"
                    >
                      Complete (Mechanic)
                    </button>
                  </form>

                <% } else if (task.status === 'COMPLETED_BY_MECHANIC') { %>

                  <!-- 🔧 Mechanic Sign -->
                  <% if (isMechanic) { %>
                    <div class="flex-1 bg-orange-100 text-orange-800 py-3 px-4 rounded-lg font-bold text-xs uppercase tracking-widest text-center border border-orange-200">
                      Awaiting Engineer Certification
                    </div>
                  <% } %>

                  <!-- 🔧 Engineer Sign -->
                  <% if (isEngineer) { %>
                    <form
                      method="POST"
                      action="/workpacks/tasks/<%= task.id %>/sign"
                      hx-post="/workpacks/tasks/<%= task.id %>/sign"
                      hx-target="#task-container-<%= task.id %>"
                      hx-swap="outerHTML"
                      hx-confirm="Certify this completed task?"
                      hx-headers='{"x-csrf-token":"<%= csrfToken %>"}'
                      hx-on::after-request="if (event.detail.successful) window.location.reload()"
                      class="flex-1"
                    >
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button
                        type="submit"
                        hx-disabled-elt="this"
                        class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold text-xs uppercase tracking-widest hover:bg-blue-700 transition-all shadow-md">
                        Certify (Engineer Sign)
                      </button>
                    </form>
                  <% } %>

                <% } else if (task.status === 'CERTIFIED_BY_ENGINEER' && isSupervisor) { %>
                  <form method="POST" action="/workpacks/tasks/<%= task.id %>/lock" class="flex-1">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit"
                      class="w-full bg-slate-900 text-white py-3 rounded-lg font-bold text-xs uppercase tracking-widest hover:bg-black transition-all shadow-md">
                      Lock Task
                    </button>
                  </form>

                <% } else if (task.status === 'LOCKED') { %>
                  <div class="flex-1 bg-slate-100 text-slate-700 py-3 px-4 rounded-lg font-bold text-xs uppercase tracking-widest text-center border border-slate-200">
                    Locked - Read Only
                  </div>

                <% } %>

              </div>
              <!-- 🔥 END BUTTON SECTION -->

            </div>

          </div>
        </div>
      <% }) %>
    </div>

    <% if (user?.roles?.some(role => role.code === 'ENGINEER')) { %>
      <% const allTasksTerminal = tasks.length > 0 && tasks.every(task => task.status === 'CERTIFIED_BY_ENGINEER' || task.status === 'LOCKED'); %>
      <div class="mt-12 border-t border-slate-200 pt-8 flex justify-end">
        <% if (workpackStatusCode === 'CLOSED') { %>
          <div class="text-right">
            <span class="text-xs font-black text-emerald-600 uppercase tracking-widest">Completed</span>
            <p class="text-sm text-slate-500">Workpack already closed.</p>
          </div>
        <% } else if (workpackStatusCode === 'CERTIFIED') { %>
          <form method="POST" action="/workpacks/<%= pack.id %>/close">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="bg-emerald-700 text-white px-10 py-4 rounded-xl font-bold hover:bg-emerald-800 transition-all shadow-xl">
              Finalize & Issue CRS
            </button>
          </form>
        <% } else if (workpackStatusCode === 'IN_PROGRESS' && allTasksTerminal) { %>
          <form method="POST" action="/workpacks/<%= pack.id %>/certify">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="bg-blue-700 text-white px-10 py-4 rounded-xl font-bold hover:bg-blue-800 transition-all shadow-xl">
              Certify Workpack
            </button>
          </form>
        <% } else { %>
          <div class="text-right bg-white p-5 rounded-xl border-2 border-slate-100 shadow-sm">
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Engineer Progress Locked</p>
            <p class="text-[11px] text-slate-500 mt-1 italic">All tasks must be engineer certified or locked before workpack certification and close can proceed.</p>
          </div>
        <% } %>
      </div>
    <% } %>

  <% } %>

</main>

<script>
  (() => {
    const START_MARKER = '[Captured Values]';
    const END_MARKER = '[/Captured Values]';

    function buildCapturedValues(taskId) {
      return Array.from(document.querySelectorAll(`.measurement-input[data-task-id="${taskId}"]`))
        .map((input) => {
          const position = input.dataset.position?.trim();
          const value = input.value.trim();
          if (!position || !value) return '';
          return `Value ${position}: ${value}`;
        })
        .filter(Boolean)
        .join('\n');
    }

    function buildStructuredMeasurementPayload(taskId) {
      return Array.from(document.querySelectorAll(`.measurement-input[data-task-id="${taskId}"]`))
        .map((input, index) => {
          const position = Number(input.dataset.position || index + 1);
          return {
            field_key: `field_${index}`,
            field_label: `Value ${position}`,
            position,
            value: input.value.trim() || null,
          };
        });
    }

    function syncTaskPayload(taskId) {
      const payload = document.getElementById(`payload-${taskId}`);
      const completionPayload = document.getElementById(`complete-payload-${taskId}`);
      const measurementPayload = document.getElementById(`measurements-payload-${taskId}`);
      const completionMeasurementPayload = document.getElementById(`complete-measurements-payload-${taskId}`);
      const noteEditor = document.getElementById(`note-${taskId}`);

      if ((!payload && !completionPayload && !measurementPayload && !completionMeasurementPayload) || !noteEditor) {
        return;
      }

      const captured = buildCapturedValues(taskId);
      const structuredMeasurements = buildStructuredMeasurementPayload(taskId);
      const note = noteEditor.value.trim();
      const nextValue = captured
        ? `${START_MARKER}\n${captured}\n${END_MARKER}${note ? `\n\n${note}` : ''}`
        : note;

      if (payload) {
        payload.value = nextValue;
      }

      if (completionPayload) {
        completionPayload.value = nextValue;
      }

      if (measurementPayload) {
        measurementPayload.value = JSON.stringify(structuredMeasurements);
      }

      if (completionMeasurementPayload) {
        completionMeasurementPayload.value = JSON.stringify(structuredMeasurements);
      }
    }

    function initialiseAllTasks() {
      document.querySelectorAll('[id^="note-"]').forEach((noteEditor) => {
        const taskId = noteEditor.id.replace('note-', '');
        if (taskId) {
          syncTaskPayload(taskId);
        }
      });
    }

    initialiseAllTasks();

    document.addEventListener('input', (event) => {
      const target = event.target;

      if (target instanceof HTMLInputElement && target.classList.contains('measurement-input')) {
        syncTaskPayload(target.dataset.taskId);
        return;
      }

      if (target instanceof HTMLTextAreaElement && target.id.startsWith('note-')) {
        syncTaskPayload(target.id.replace('note-', ''));
      }
    });

    document.body.addEventListener('htmx:afterSwap', () => {
      initialiseAllTasks();
    });
  })();
</script>

<%- include('../partials/footer') %>
