<%- include('../../partials/header') %>

<main class="max-w-4xl mx-auto py-10 px-6 space-y-8">
  <% if (messages?.success?.length || messages?.error?.length) { %>
    <section class="space-y-3">
      <% (messages?.success || []).forEach((message) => { %>
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
          <%= message %>
        </div>
      <% }) %>
      <% (messages?.error || []).forEach((message) => { %>
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
          <%= message %>
        </div>
      <% }) %>
    </section>
  <% } %>

  <div>
    <a href="/library" class="text-sm text-blue-600 hover:underline">Back to Library</a>
  </div>

  <section class="bg-white border rounded-xl p-6 shadow-sm space-y-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">Generic Model Import</h1>
        <p class="mt-2 text-sm text-slate-500">
          Upload model CSV data and preview component model rows before commit.
        </p>
      </div>
      <a
        href="/library/models/import/template"
        class="inline-flex rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100"
      >
        Download CSV Template
      </a>
    </div>

    <form
      method="POST"
      action="/library/models/import/preview?_csrf=<%= encodeURIComponent(csrfToken) %>"
      enctype="multipart/form-data"
      class="space-y-4 rounded-lg border border-slate-200 bg-slate-50 p-5"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <input
          type="file"
          name="model_master_file"
          accept=".csv,text/csv"
          required
          class="block w-full rounded border bg-white px-3 py-2 text-sm text-slate-700"
        >
        <button
          type="submit"
          class="rounded bg-slate-800 px-4 py-2 text-sm font-bold text-white hover:bg-black"
        >
          Preview File
        </button>
      </div>

      <div class="rounded border border-slate-200 bg-white p-4 text-xs text-slate-600">
        <div class="font-bold text-slate-800">CSV only</div>
        <p class="mt-2">
          This phase supports CSV files only. XLSX workbooks are not supported by the model import flow yet.
        </p>

        <div class="font-bold text-slate-800">Preferred headers</div>
        <div class="mt-2 font-mono">
          manufacturer,asset_type,model_code,model_name,family,series,notes,is_active
        </div>
        <div class="mt-3 font-bold text-slate-800">Compatible headers</div>
        <div class="mt-2 font-mono">
          manufacturer_code,asset_type_code,model_code,model_name,family,series,notes,is_active
        </div>
        <p class="mt-3">
          Manufacturer and asset type can be provided as names or codes. Existing Piper-style CSV files remain supported.
        </p>
        <ul class="mt-3 list-disc space-y-1 pl-5">
          <li><span class="font-bold text-slate-800">model_code</span> is the OEM or applicability code used for matching and duplicate prevention.</li>
          <li><span class="font-bold text-slate-800">model_name</span> is the display or common name shown to users. If blank, commit uses model_code.</li>
          <li><span class="font-bold text-slate-800">manufacturer_code</span> must match an existing manufacturer code or name.</li>
          <li><span class="font-bold text-slate-800">asset_type_code</span> must match an existing asset type code or name.</li>
          <li>Unresolved manufacturer or asset type values appear as REVIEW_REQUIRED in preview and are not committed.</li>
        </ul>
      </div>
    </form>
  </section>
</main>

<%- include('../../partials/footer') %>
