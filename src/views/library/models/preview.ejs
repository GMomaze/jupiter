<%- include('../../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-6 space-y-8">
  <div class="flex items-center justify-between gap-4">
    <div>
      <a href="/library/models/import" class="text-sm text-blue-600 hover:underline">Back to Import</a>
      <h1 class="mt-3 text-3xl font-bold text-slate-900">Generic Model Import Preview</h1>
      <p class="mt-2 text-sm text-slate-500">
        Preview generated for <span class="font-semibold text-slate-700"><%= fileName %></span>. No rows have been saved.
      </p>
    </div>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-6">
    <% ['NEW', 'EXISTING_CODE_MATCH', 'LEGACY_NAME_MATCH', 'DUPLICATE_CONFLICT', 'REVIEW_REQUIRED', 'INVALID'].forEach((status) => { %>
      <div class="rounded-xl border bg-white p-4 shadow-sm">
        <div class="text-[10px] font-bold uppercase tracking-widest text-slate-500"><%= status.replace(/_/g, ' ') %></div>
        <div class="mt-2 text-2xl font-black text-slate-900"><%= preview.counts[status] || 0 %></div>
      </div>
    <% }) %>
  </section>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <div>
      <h2 class="text-lg font-bold text-slate-900">Rows</h2>
      <p class="mt-1 text-sm text-slate-500">
        Only NEW rows will be created during commit. Existing, legacy, duplicate, review-required, and invalid rows are skipped.
      </p>
    </div>

    <div class="mt-4 overflow-x-auto rounded-lg border">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Source Row</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Submitted Manufacturer</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Resolved Manufacturer</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Submitted Asset Type</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Resolved Asset Type</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Model Code</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Model Name</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Status</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Reason</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% preview.rows.forEach((row) => { %>
            <tr>
              <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900"><%= row.rowNumber %></td>
              <td class="px-3 py-3 align-top text-sm text-slate-700"><%= row.values.manufacturer || row.values.manufacturer_code || '-' %></td>
              <td class="px-3 py-3 align-top text-sm text-slate-700"><%= row.manufacturer_display || '-' %></td>
              <td class="px-3 py-3 align-top text-sm text-slate-700"><%= row.values.asset_type || row.values.asset_type_code || '-' %></td>
              <td class="px-3 py-3 align-top text-sm text-slate-700"><%= row.asset_type_display || '-' %></td>
              <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900"><%= row.values.model_code || '-' %></td>
              <td class="px-3 py-3 align-top text-sm text-slate-700"><%= row.values.model_name || '-' %></td>
              <td class="px-3 py-3 align-top">
                <% const badgeClass = row.status === 'NEW' ? 'bg-emerald-100 text-emerald-800' : row.status === 'INVALID' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800'; %>
                <span class="inline-flex rounded-full px-2 py-1 text-[10px] font-bold uppercase tracking-wider <%= badgeClass %>">
                  <%= row.status.replace(/_/g, ' ') %>
                </span>
              </td>
              <td class="px-3 py-3 align-top text-xs text-slate-700"><%= row.reason %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="rounded-xl border bg-slate-50 p-6 shadow-sm">
    <form
      method="POST"
      action="/library/models/import/commit?_csrf=<%= encodeURIComponent(csrfToken) %>"
      class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="import_token" value="<%= importToken %>">
      <p class="text-sm text-slate-600">
        Commit will create <span class="font-bold text-emerald-700"><%= preview.counts.NEW || 0 %></span> new component model rows.
      </p>
      <button type="submit" class="rounded bg-emerald-700 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-800">
        Commit New Rows
      </button>
    </form>
  </section>
</main>

<%- include('../../partials/footer') %>
