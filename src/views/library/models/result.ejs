<%- include('../../partials/header') %>

<main class="max-w-6xl mx-auto py-10 px-6 space-y-8">
  <div>
    <a href="/library/models/import" class="text-sm text-blue-600 hover:underline">Back to Import</a>
    <h1 class="mt-3 text-3xl font-bold text-slate-900">Generic Model Import Result</h1>
    <p class="mt-2 text-sm text-slate-500">
      Import completed for <span class="font-semibold text-slate-700"><%= fileName %></span>.
    </p>
  </div>

  <section class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-xl border bg-white p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Total Rows</div>
      <div class="mt-2 text-2xl font-black text-slate-900"><%= result.totalRows %></div>
    </div>
    <div class="rounded-xl border bg-emerald-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-emerald-700">Created</div>
      <div class="mt-2 text-2xl font-black text-emerald-800"><%= result.created %></div>
    </div>
    <div class="rounded-xl border bg-amber-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-amber-700">Skipped</div>
      <div class="mt-2 text-2xl font-black text-amber-800"><%= result.skipped %></div>
    </div>
  </section>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900">Row Results</h2>
    <div class="mt-4 overflow-x-auto rounded-lg border">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Source Row</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Status</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Model Code</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Model Name</th>
            <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Reason</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% result.rows.forEach((row) => { %>
            <tr>
              <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900"><%= row.rowNumber %></td>
              <td class="px-3 py-3 align-top text-sm font-bold text-slate-700"><%= row.status %></td>
              <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900"><%= row.model_code || '-' %></td>
              <td class="px-3 py-3 align-top text-sm text-slate-700"><%= row.model_name || '-' %></td>
              <td class="px-3 py-3 align-top text-xs text-slate-700"><%= row.reason %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<%- include('../../partials/footer') %>
