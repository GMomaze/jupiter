<%- include('../../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-6 space-y-8">
  <div class="flex items-center justify-between gap-4">
    <div>
      <a href="/library/tasks/import" class="text-sm text-blue-600 hover:underline">Back to Import</a>
      <h1 class="mt-3 text-3xl font-bold text-slate-900">Standard Task Import Result</h1>
      <p class="mt-2 text-sm text-slate-500">
        Commit completed for <span class="font-semibold text-slate-700"><%= fileName %></span>.
      </p>
    </div>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
    <div class="rounded-xl border bg-white p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Processed</div>
      <div class="mt-2 text-2xl font-black text-slate-900"><%= result.totalRowsProcessed %></div>
    </div>
    <div class="rounded-xl border bg-white p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Valid Rows</div>
      <div class="mt-2 text-2xl font-black text-slate-900"><%= result.totalValidRows %></div>
    </div>
    <div class="rounded-xl border bg-emerald-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-emerald-700">Inserted</div>
      <div class="mt-2 text-2xl font-black text-emerald-800"><%= result.totalInserted %></div>
    </div>
    <div class="rounded-xl border bg-rose-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-rose-700">Skipped Invalid</div>
      <div class="mt-2 text-2xl font-black text-rose-800"><%= result.totalSkippedInvalid %></div>
    </div>
    <div class="rounded-xl border bg-amber-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-amber-700">Skipped Duplicate</div>
      <div class="mt-2 text-2xl font-black text-amber-800"><%= result.totalSkippedDuplicate %></div>
    </div>
  </section>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <div>
      <h2 class="text-lg font-bold text-slate-900">Row Outcome</h2>
      <p class="mt-1 text-sm text-slate-500">
        Each processed row shows its final import outcome and reason.
      </p>
    </div>

    <% if (!result.rows.length) { %>
      <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 px-4 py-6 text-sm text-slate-500">
        No rows were available to process.
      </div>
    <% } else { %>
      <div class="mt-4 overflow-x-auto rounded-lg border">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Row</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Outcome</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Normalized Values</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Reason</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% result.rows.forEach((row) => { %>
              <tr>
                <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900">
                  <%= row.rowNumber %>
                </td>
                <td class="px-3 py-3 align-top">
                  <% if (row.status === 'INSERTED') { %>
                    <span class="inline-flex rounded-full bg-emerald-100 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-800">
                      INSERTED
                    </span>
                  <% } else if (row.status === 'SKIPPED - DUPLICATE') { %>
                    <span class="inline-flex rounded-full bg-amber-100 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-amber-800">
                      SKIPPED - DUPLICATE
                    </span>
                  <% } else { %>
                    <span class="inline-flex rounded-full bg-rose-100 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-rose-800">
                      SKIPPED - INVALID
                    </span>
                  <% } %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <dl class="grid gap-2 md:grid-cols-2">
                    <div><dt class="font-bold text-slate-500">title</dt><dd><%= row.values.title || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">description</dt><dd><%= row.values.description || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">source_type</dt><dd><%= row.values.source_type || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">interval_hours</dt><dd><%= row.values.interval_hours ?? '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">interval_months</dt><dd><%= row.values.interval_months ?? '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">is_active</dt><dd><%= row.values.is_active === null ? 'true (default)' : row.values.is_active ? 'true' : 'false' %></dd></div>
                    <div><dt class="font-bold text-slate-500">model_applicability</dt><dd><%= row.values.model_applicability || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">aircraft_applicability</dt><dd><%= row.values.aircraft_applicability || '-' %></dd></div>
                  </dl>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= row.reason %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../../partials/footer') %>
