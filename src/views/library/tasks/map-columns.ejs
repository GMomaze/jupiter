<%- include('../../partials/header') %>

<main class="max-w-5xl mx-auto py-10 px-6 space-y-8">
  <div>
    <a href="/library/tasks/import" class="text-sm text-blue-600 hover:underline">Back to Import</a>
  </div>

  <% if (mappingErrors?.length) { %>
    <section class="space-y-3">
      <% mappingErrors.forEach((message) => { %>
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
          <%= message %>
        </div>
      <% }) %>
    </section>
  <% } %>

  <section class="bg-white border rounded-xl p-6 shadow-sm space-y-6">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">Map Standard Task Columns</h1>
      <p class="mt-2 text-sm text-slate-500">
        CSV headers detected for <span class="font-semibold text-slate-700"><%= fileName %></span>. Map each Jupiter field before previewing rows in memory.
      </p>
    </div>

    <div class="grid gap-4 lg:grid-cols-[2fr,1fr]">
      <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
        <h2 class="text-sm font-bold uppercase tracking-widest text-slate-700">Detected CSV Headers</h2>
        <% if (!headers.length) { %>
          <p class="mt-3 text-sm text-slate-500">No headers detected.</p>
        <% } else { %>
          <div class="mt-3 flex flex-wrap gap-2">
            <% headers.forEach((header) => { %>
              <span class="inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-700 border border-slate-200">
                <%= header %>
              </span>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
        <h2 class="text-sm font-bold uppercase tracking-widest text-amber-700">Unmapped / Unknown Headers</h2>
        <p class="mt-2 text-xs text-amber-800">
          <%= unknownColumns?.length ? unknownColumns.join(', ') : 'None' %>
        </p>
      </div>
    </div>

    <form
      method="POST"
      action="/library/tasks/import/preview?_csrf=<%= encodeURIComponent(csrfToken) %>"
      class="space-y-5"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="import_token" value="<%= importToken %>">

      <div class="overflow-x-auto rounded-lg border">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Jupiter Field</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Requirement</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">CSV Column</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% targetFields.forEach((field) => { %>
              <tr>
                <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900">
                  <%= field.key %>
                </td>
                <td class="px-3 py-3 align-top text-xs">
                  <% if (field.required) { %>
                    <span class="inline-flex rounded-full bg-rose-100 px-2 py-1 font-bold uppercase tracking-wider text-rose-700">
                      Required
                    </span>
                  <% } else { %>
                    <span class="inline-flex rounded-full bg-slate-100 px-2 py-1 font-bold uppercase tracking-wider text-slate-600">
                      Optional
                    </span>
                  <% } %>
                </td>
                <td class="px-3 py-3 align-top">
                  <select
                    name="<%= field.key %>"
                    class="w-full rounded border px-3 py-2 text-sm"
                  >
                    <option value="">-- Unmapped --</option>
                    <% headers.forEach((header) => { %>
                      <option value="<%= header %>" <%= mapping[field.key] === header ? 'selected' : '' %>>
                        <%= header %>
                      </option>
                    <% }) %>
                  </select>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 text-xs text-slate-600 space-y-1">
        <p>Required fields must be mapped before preview.</p>
        <p>A CSV column can only be used once.</p>
        <p>Optional fields may remain unmapped and will appear as blank in preview.</p>
      </div>

      <button
        type="submit"
        class="rounded bg-slate-800 px-4 py-2 text-sm font-bold text-white hover:bg-black"
      >
        Continue to Preview
      </button>
    </form>
  </section>
</main>

<%- include('../../partials/footer') %>
