<%- include('../../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-6 space-y-8">
  <div class="flex items-center justify-between gap-4">
    <div>
      <a href="/library" class="text-sm text-blue-600 hover:underline">Back to Library</a>
      <h1 class="mt-3 text-3xl font-bold text-slate-900">Standard Tasks</h1>
      <p class="mt-2 text-sm text-slate-500">
        Read-only admin view of reusable Standard Tasks stored in <code>task_templates</code>.
      </p>
    </div>

    <a
      href="/library/tasks/import"
      class="rounded bg-slate-800 px-4 py-2 text-sm font-bold text-white hover:bg-black"
    >
      Import Standard Tasks
    </a>
  </div>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold text-slate-900">Task Template Library</h2>
        <p class="mt-1 text-sm text-slate-500">
          Showing title, source, intervals, applicability, status, and created timestamp.
        </p>
      </div>
      <div class="rounded-lg border border-orange-200 bg-orange-50 px-4 py-3 text-xs font-bold uppercase tracking-widest text-orange-700">
        <%= standardTasks.length %> Standard Tasks
      </div>
    </div>

    <% if (!standardTasks.length) { %>
      <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 px-6 py-10 text-center">
        <p class="text-sm font-semibold text-slate-700">No standard tasks exist yet.</p>
        <p class="mt-2 text-sm text-slate-500">
          Use the Standard Task import flow to add reusable task templates.
        </p>
      </div>
    <% } else { %>
      <div class="mt-6 overflow-x-auto rounded-lg border">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Title</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Description</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Source Type</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Interval Hours</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Interval Months</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Model Applicability</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Aircraft Applicability</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Active</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Created</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% standardTasks.forEach((task) => { %>
              <tr>
                <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900">
                  <%= task.title || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-sm text-slate-700">
                  <div class="max-w-md whitespace-pre-wrap break-words"><%= task.description || '-' %></div>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= task.source_type || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= task.interval_hours ?? '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= task.interval_months ?? '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= task.model_applicability || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= task.aircraft_applicability || '-' %>
                </td>
                <td class="px-3 py-3 align-top">
                  <% if (task.is_active) { %>
                    <span class="inline-flex rounded-full bg-emerald-100 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-800">
                      Active
                    </span>
                  <% } else { %>
                    <span class="inline-flex rounded-full bg-slate-200 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-700">
                      Inactive
                    </span>
                  <% } %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= task.created_at ? new Date(task.created_at).toLocaleString() : '-' %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../../partials/footer') %>
