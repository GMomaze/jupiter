<%- include('../../partials/header') %>
<main class="max-w-3xl mx-auto py-10 px-4">
  <h1 class="text-3xl font-black"><%= title %></h1>
  <div class="mt-4 rounded border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">Phase 1 permits <strong>ALL_SERIALS_OF_MODEL</strong> only. Serial, configuration, modification, suffix, range, and other narrower effectivity are not allowed. Planning defaults are not authoritative and are never copied into this form.</div>
  <% if (errors.length) { %><div class="mt-4 rounded border border-rose-300 bg-rose-50 p-4 text-sm text-rose-800"><% errors.forEach((error) => { %><p><%= error %></p><% }) %></div><% } %>
  <form method="POST" action="<%= target ? `/library/life-limit-governance/proposals/${target.id}/${String(purpose).toLowerCase()}` : '/library/life-limit-governance/proposals' %>" class="mt-6 space-y-5 rounded border bg-white p-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="applicability_scope" value="ALL_SERIALS_OF_MODEL"><input type="hidden" name="narrower_effectivity_absent" value="true"><input type="hidden" name="applicability_statement" value="All serials of model">
    <% if (target) { %><p class="text-sm"><strong>Target:</strong> revision <%= target.revision_number %>, <%= target.manufacturer_name %> <%= target.model_name %></p><input type="hidden" name="component_model_id" value="<%= target.component_model_id %>"><% } else { %>
      <label class="block text-sm font-bold">Component model<select name="component_model_id" required class="mt-1 w-full rounded border p-2"><option value="">Select model</option><% models.forEach((model) => { %><option value="<%= model.id %>" <%= form.component_model_id === model.id ? 'selected' : '' %>><%= model.manufacturer_name %> — <%= model.model_name %></option><% }) %></select></label>
    <% } %>
    <% if (purpose !== 'WITHDRAWAL') { %><label class="block text-sm font-bold">Limit type and controlled basis<select name="limit_type" required class="mt-1 w-full rounded border p-2"><option value="">Select</option><option value="TBO_HOURS">TBO hours / since overhaul</option><option value="TBO_CYCLES">TBO cycles / since overhaul</option><option value="LIFE_LIMIT_HOURS">Life-limit hours / since new</option><option value="LIFE_LIMIT_CYCLES">Life-limit cycles / since new</option><option value="CALENDAR_LIFE">Calendar life / calendar</option></select></label><label class="block text-sm font-bold">Single positive limit value<input name="limit_value" type="number" min="0.01" step="0.01" required value="<%= form.limit_value || '' %>" class="mt-1 w-full rounded border p-2"></label><% } %>
    <label class="block text-sm font-bold">Authority effective date<input type="date" name="source_effective_date" required value="<%= form.source_effective_date || '' %>" class="mt-1 w-full rounded border p-2"></label>
    <label class="block text-sm font-bold">Source reference<input name="source_reference" required value="<%= form.source_reference || '' %>" class="mt-1 w-full rounded border p-2"></label>
    <label class="block text-sm font-bold">Source document reference<input name="source_document_reference" required value="<%= form.source_document_reference || '' %>" class="mt-1 w-full rounded border p-2"></label>
    <label class="block text-sm font-bold">Evidence summary<textarea name="evidence_summary" required class="mt-1 w-full rounded border p-2"><%= form.evidence_summary || '' %></textarea></label>
    <label class="block text-sm font-bold">Proposal reason / justification<textarea name="proposal_reason" required class="mt-1 w-full rounded border p-2"><%= form.proposal_reason || '' %></textarea></label>
    <button class="rounded bg-indigo-700 px-4 py-2 font-bold text-white">Submit for independent review</button>
  </form>
</main><%- include('../../partials/footer') %>
