<%- include('../../partials/header') %>
<main class="max-w-5xl mx-auto py-10 px-4">
  <h1 class="text-3xl font-black">Life-Limit Proposal</h1>
  <div class="mt-4 rounded border border-blue-300 bg-blue-50 p-4 text-sm text-blue-900"><strong>Approval creates a governed but dormant publication.</strong> It does not change aircraft or workpack due calculations. Independent approval is mandatory.</div>
  <section class="mt-6 grid grid-cols-2 gap-4 rounded border bg-white p-6 text-sm"><div><strong>Model</strong><p><%= proposal.manufacturer_name %> <%= proposal.model_name %></p></div><div><strong>Status</strong><p><%= proposal.status %></p></div><div><strong>Purpose / revision</strong><p><%= proposal.proposal_purpose %> / <%= proposal.revision_number %></p></div><div><strong>Lineage</strong><p class="break-all"><%= proposal.lineage_id %></p></div><div><strong>Applicability</strong><p><%= proposal.applicability_scope %> — <%= proposal.applicability_statement %></p></div><div><strong>Limit</strong><p><%= proposal.limit_type || 'Determination only' %> / <%= proposal.basis || '—' %>: <%= proposal.limit_hours ?? proposal.limit_cycles ?? proposal.limit_months ?? '—' %></p></div><div><strong>Effective date</strong><p><%= proposal.source_effective_date %></p></div><div><strong>Source</strong><p><%= proposal.source_reference %> / <%= proposal.source_document_reference || '—' %></p></div><div class="col-span-2"><strong>Evidence</strong><p><%= proposal.evidence_summary %></p></div><div class="col-span-2"><strong>Proposal reason</strong><p><%= proposal.proposal_reason %></p></div><div><strong>Proposer</strong><p><%= proposal.proposer_name %></p></div><div><strong>Decision maker / reason</strong><p><%= proposal.decision_maker_name || 'Pending' %> — <%= proposal.decision_reason || '—' %></p></div></section>
  <% if (proposal.publication_id) { %><section class="mt-6 rounded border border-indigo-300 bg-indigo-50 p-5"><h2 class="font-black">Governed publication</h2><p>State: <strong><%= proposal.publication_state %></strong>; operational limit active: <strong><%= proposal.operational_limit_active %></strong></p><p class="text-sm"><%= proposal.operational_limit_description %></p></section><% } %>
  <% if (canApprove && proposal.status === 'PROPOSED' && proposal.proposed_by !== currentUserId) { %><section class="mt-6 grid gap-4 md:grid-cols-2"><form method="POST" action="/library/life-limit-governance/proposals/<%= proposal.id %>/approve" class="rounded border bg-white p-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="evidence_confirmed" value="true"><textarea name="decision_reason" required placeholder="Independent approval reason" class="w-full rounded border p-2"></textarea><button class="mt-2 rounded bg-emerald-700 px-4 py-2 font-bold text-white">Approve dormant publication</button></form><form method="POST" action="/library/life-limit-governance/proposals/<%= proposal.id %>/reject" class="rounded border bg-white p-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><textarea name="decision_reason" required placeholder="Rejection reason" class="w-full rounded border p-2"></textarea><button class="mt-2 rounded bg-rose-700 px-4 py-2 font-bold text-white">Reject</button></form></section><% } %>
  <% if (canPropose && proposal.status === 'APPROVED' && proposal.publication_id) { %><div class="mt-6 flex gap-3"><a class="rounded border px-4 py-2 font-bold" href="/library/life-limit-governance/proposals/<%= proposal.id %>/replacement/new">Propose replacement</a><a class="rounded border px-4 py-2 font-bold" href="/library/life-limit-governance/proposals/<%= proposal.id %>/withdrawal/new">Propose withdrawal</a></div><% } %>
  <section class="mt-8"><h2 class="text-xl font-black">Immutable transition history</h2><ol class="mt-3 space-y-3"><% history.forEach((h) => { %><li class="rounded border bg-white p-3 text-sm"><strong><%= h.event_code %></strong> — <%= h.actor_name %> — <%= h.reason %> (<%= h.from_status || 'none' %> → <%= h.to_status %>)<p>Recorded: <%= h.created_at %>; evidence confirmed: <%= h.evidence_confirmed %></p><details class="mt-2"><summary class="font-bold">Before snapshot</summary><pre class="mt-1 overflow-auto whitespace-pre-wrap rounded bg-slate-100 p-2"><%= JSON.stringify(h.before_snapshot, null, 2) %></pre></details><details class="mt-2"><summary class="font-bold">After snapshot</summary><pre class="mt-1 overflow-auto whitespace-pre-wrap rounded bg-slate-100 p-2"><%= JSON.stringify(h.after_snapshot, null, 2) %></pre></details></li><% }) %></ol></section>
  <section class="mt-8"><h2 class="text-xl font-black">Legacy limits — LEGACY_UNREVIEWED</h2><p class="text-sm text-slate-600">These existing rows are separate from governed publications and are not presented as approved.</p><ul class="mt-3"><% legacyLimits.forEach((l) => { %><li class="border-t py-2 text-sm"><%= l.limit_type %> / <%= l.basis %> — active: <%= l.is_active %></li><% }) %></ul></section>
</main><%- include('../../partials/footer') %>
