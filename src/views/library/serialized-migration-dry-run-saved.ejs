<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <% const summary = batch.dry_run_summary || {}; %>
  <% const metadata = batch.metadata || {}; %>
  <% const categoryCounts = summary.category_counts || {}; %>

  <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">
        Saved Ledger Evidence
      </p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">
        Saved Migration Dry Run
      </h1>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">
        This batch preserves the dry-run source snapshots and proposed target snapshots for review.
        It is a ledger record only and does not contain target records.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/library/serialized-components/migration-dry-run" class="inline-flex items-center justify-center rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">
        New Dry Run
      </a>
      <a href="/library" class="inline-flex items-center justify-center rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">
        Back to Library
      </a>
    </div>
  </div>

  <section class="mb-6 rounded border border-emerald-200 bg-emerald-50 p-4">
    <div class="grid grid-cols-1 gap-3 md:grid-cols-4">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.2em] text-emerald-700">Batch Status</p>
        <p class="mt-1 text-sm font-semibold text-emerald-900"><%= batch.status %></p>
      </div>
      <div>
        <p class="text-xs font-black uppercase tracking-[0.2em] text-emerald-700">Batch ID</p>
        <p class="mt-1 break-all text-sm font-semibold text-emerald-900"><%= batch.id %></p>
      </div>
      <div>
        <p class="text-xs font-black uppercase tracking-[0.2em] text-emerald-700">Saved At</p>
        <p class="mt-1 text-sm font-semibold text-emerald-900"><%= metadata.saved_at || batch.created_at || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-black uppercase tracking-[0.2em] text-emerald-700">Source Mode</p>
        <p class="mt-1 text-sm font-semibold text-emerald-900"><%= metadata.source_report_mode || '-' %></p>
      </div>
    </div>
  </section>

  <section class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Source Rows</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= summary.source_rows_evaluated || 0 %></p>
      <p class="mt-1 text-xs text-slate-500">Saved rows: <%= rows.length %></p>
    </article>
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Readiness Score</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= summary.readiness_score || 0 %>%</p>
      <p class="mt-1 text-xs text-slate-500">From saved dry-run summary</p>
    </article>
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Warnings</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= summary.warning_count || 0 %></p>
      <p class="mt-1 text-xs text-slate-500">Preserved in row evidence</p>
    </article>
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Blockers</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= summary.blocker_count || 0 %></p>
      <p class="mt-1 text-xs text-slate-500">Preserved in row evidence</p>
    </article>
  </section>

  <section class="mb-6 rounded border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-4">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">Category Counts</p>
      <h2 class="mt-1 text-xl font-black text-slate-900">Saved Dry Run Categories</h2>
    </div>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
      <% ['AUTO_MIGRATE', 'MANUAL_REVIEW_REQUIRED', 'CONFLICT', 'BLOCKED', 'SKIP'].forEach((category) => { %>
        <div class="rounded border border-slate-200 bg-slate-50 p-3">
          <p class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500"><%= category %></p>
          <p class="mt-2 text-2xl font-black text-slate-900"><%= categoryCounts[category] || 0 %></p>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="rounded border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 p-5">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">Saved Rows</p>
      <h2 class="mt-1 text-xl font-black text-slate-900">Preserved Source and Planned Target Evidence</h2>
    </div>

    <% if (rows.length === 0) { %>
      <div class="p-6 text-sm font-semibold text-slate-600">
        This saved dry-run contains no source rows.
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Source</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Planned Component</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Planned Install</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Planned Life</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Planned Event</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Category</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Evidence Flags</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% rows.forEach((row) => { %>
              <% const source = row.source_snapshot || {}; %>
              <% const planned = row.planned_target_snapshot || {}; %>
              <tr>
                <td class="px-3 py-3 text-slate-700">
                  <div class="font-bold text-slate-900"><%= source.aircraft_registration || '-' %></div>
                  <div>ID: <%= row.source_row_id || source.id || '-' %></div>
                  <div>Status: <%= source.current_status || '-' %></div>
                  <div>Position: <%= source.position_code || '-' %></div>
                </td>
                <td class="px-3 py-3 text-slate-700">
                  <div class="font-bold"><%= planned.proposed_serialized_component?.action || 'NONE' %></div>
                  <div><%= source.model_code || '-' %></div>
                  <div>Serial: <%= source.serial_number || '-' %></div>
                </td>
                <td class="px-3 py-3 text-slate-700">
                  <div class="font-bold"><%= planned.proposed_installation?.action || 'NONE' %></div>
                  <div>Installed: <%= planned.proposed_installation?.installed_at || '-' %></div>
                  <div>Removed: <%= planned.proposed_installation?.removed_at || '-' %></div>
                </td>
                <td class="px-3 py-3 text-slate-700">
                  <div class="font-bold"><%= planned.proposed_life_state?.action || 'NONE' %></div>
                  <div>TSN: <%= planned.proposed_life_state?.tsn_hours ?? '-' %></div>
                  <div>TSO: <%= planned.proposed_life_state?.tso_hours ?? '-' %></div>
                </td>
                <td class="px-3 py-3 text-slate-700">
                  <div class="font-bold"><%= planned.proposed_maintenance_event?.action || 'NONE' %></div>
                  <div><%= planned.proposed_maintenance_event?.event_type || '-' %></div>
                </td>
                <td class="px-3 py-3">
                  <span class="inline-flex rounded bg-slate-100 px-2 py-1 text-xs font-black text-slate-700">
                    <%= row.migration_category || '-' %>
                  </span>
                  <div class="mt-2 text-xs font-semibold text-slate-500">Status: <%= row.status || '-' %></div>
                </td>
                <td class="px-3 py-3 text-slate-700">
                  <% if (Array.isArray(row.warnings) && row.warnings.length > 0) { %>
                    <div class="font-bold text-amber-700">Warnings</div>
                    <div><%= row.warnings.join('; ') %></div>
                  <% } %>
                  <% if (Array.isArray(row.conflicts) && row.conflicts.length > 0) { %>
                    <div class="mt-2 font-bold text-red-700">Blockers</div>
                    <div><%= row.conflicts.join('; ') %></div>
                  <% } %>
                  <% if ((!Array.isArray(row.warnings) || row.warnings.length === 0) && (!Array.isArray(row.conflicts) || row.conflicts.length === 0)) { %>
                    -
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>
