<div class="space-y-2">
  <% if (models.length === 0) { %>
    <p class="text-xs text-slate-500 italic font-medium">No models registered for this manufacturer.</p>
  <% } %>

  <% models.forEach(model => { %>
    <a 
      href="/library/model/<%= model.id %>"
      class="model-card relative block p-4 border-2 border-slate-100 rounded-lg shadow-sm hover:border-slate-400 transition-all group cursor-pointer bg-white"
      onclick="
        /* 1. Reset all cards in this column */
        document.querySelectorAll('.model-card').forEach(c => {
          c.classList.remove('bg-slate-800', 'border-slate-800');
          c.classList.add('bg-white', 'border-slate-100');
          
          const title = c.querySelector('h3');
          if(title) title.classList.remove('text-white');
          
          const badges = c.querySelectorAll('.tbo-badge');
          badges.forEach(b => {
            b.classList.remove('bg-slate-600', 'text-slate-100');
            b.classList.add('bg-slate-100', 'text-slate-600');
          });
        });

        /* 2. Highlight this card */
        this.classList.remove('bg-white', 'border-slate-100');
        this.classList.add('bg-slate-800', 'border-slate-800');
        
        /* 3. Style text and badges inside active card */
        const activeTitle = this.querySelector('h3');
        if(activeTitle) activeTitle.classList.add('text-white');
        
        const activeBadges = this.querySelectorAll('.tbo-badge');
        activeBadges.forEach(b => {
          b.classList.remove('bg-slate-100', 'text-slate-600');
          b.classList.add('bg-slate-600', 'text-slate-100');
        });
      "
    >
      <span class="absolute top-2 right-2 text-[10px] font-bold uppercase tracking-widest text-slate-400 group-hover:text-blue-500 transition-colors">
        View
      </span>

      <div>
        <h3 class="font-black text-slate-900 uppercase text-sm pr-6 transition-colors">
          <%= formatModelDisplay(model) %>
        </h3>
        
        <div class="flex gap-2 mt-2">
          <span class="tbo-badge px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-100 text-slate-600 transition-colors">
            TBO: <%= model.default_tbo_hours %>h
          </span>
          <span class="tbo-badge px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-100 text-slate-600 transition-colors">
            <%= model.default_tbo_months %>m
          </span>
        </div>
      </div>
    </a>
  <% }) %>
</div>
