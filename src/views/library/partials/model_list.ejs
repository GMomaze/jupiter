<div class="space-y-2">

  <% if (models.length === 0) { %>
    <p class="text-xs text-slate-500 italic font-medium">
      No models registered for this manufacturer.
    </p>
  <% } %>

  <% models.forEach(model => { %>

    <div 
      class="model-card relative p-4 border-2 border-slate-100 rounded-lg shadow-sm hover:border-slate-400 transition-all cursor-pointer bg-white"

      hx-get="/library/model/<%= model.id %>"
      hx-target="#requirement-container"
      hx-swap="innerHTML"
    >

      <button 
        class="absolute top-2 right-2 text-slate-300 hover:text-blue-400 cursor-pointer z-20 transition-colors"
        hx-get="/library/model/<%= model.id %>/edit"
        hx-target="#model-container"
        hx-swap="innerHTML"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4"
          fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round"
            stroke-width="2"
            d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 
               2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 
               3.732z" />
        </svg>
      </button>

      <div>

        <h3 class="font-black text-slate-900 uppercase text-sm pr-6">
          <%= model.model_name %>
        </h3>

        <div class="flex gap-2 mt-2">

          <% if (model.default_tbo_hours) { %>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-100 text-slate-600">
            TBO: <%= model.default_tbo_hours %>h
          </span>
          <% } %>

          <% if (model.default_tbo_months) { %>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-100 text-slate-600">
            <%= model.default_tbo_months %>m
          </span>
          <% } %>

        </div>

      </div>

    </div>

  <% }) %>

</div>