<div class="p-4 bg-blue-50 border border-dashed border-blue-400 rounded-lg shadow-inner">
    <h3 class="text-sm font-black uppercase mb-4 text-blue-900 tracking-tight">New Maintenance Rule</h3>
    
    <form hx-post="/library/requirement" 
          hx-target="#requirement-container" 
          class="space-y-4">
        
        <input type="hidden" name="model_id" value="<%= modelId %>">

        <div>
            <label class="block text-[10px] font-black uppercase text-slate-500 mb-1 tracking-widest">Rule Title</label>
            <input type="text" name="title" class="w-full p-2 border border-slate-200 rounded text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="e.g. 50-Hour Inspection" required>
        </div>

        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block text-[10px] font-black uppercase text-slate-500 mb-1 tracking-widest">Interval (Hours)</label>
                <input type="number" name="interval_hours" class="w-full p-2 border border-slate-200 rounded text-sm outline-none" placeholder="100">
            </div>
            <div>
                <label class="block text-[10px] font-black uppercase text-slate-500 mb-1 tracking-widest">Interval (Months)</label>
                <input type="number" name="interval_months" class="w-full p-2 border rounded text-sm outline-none" placeholder="12">
            </div>
        </div>

        <div>
            <label class="block text-[10px] font-black uppercase text-slate-500 mb-1 tracking-widest">Description</label>
            <textarea name="description" class="w-full p-2 border border-slate-200 rounded text-sm resize-none outline-none" rows="3" placeholder="Technical scope..."></textarea>
        </div>

        <div class="flex flex-col gap-2 pt-2">
            <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded font-black text-xs uppercase tracking-widest hover:bg-slate-900 transition-all cursor-pointer">
                Save Rule
            </button>
            <button type="button" 
                    hx-get="/library/model/<%= modelId %>/requirements" 
                    hx-target="#requirement-container"
                    class="text-[10px] font-bold text-slate-400 uppercase py-2 cursor-pointer hover:text-slate-600 transition-colors">
                Cancel
            </button>
        </div>
    </form>
</div>