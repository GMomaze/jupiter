<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <% const summary = report.summary || {}; %>
  <% const bucketCounts = report.bucket_counts || {}; %>
  <% const exceptions = Array.isArray(report.detailed_exceptions) ? report.detailed_exceptions : []; %>

  <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">
        Read-Only Report
      </p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">
        Serialized Component Reconciliation
      </h1>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">
        Compares active legacy aircraft component records with active serialized component installations.
        This page does not persist mappings, migrate records, or change lifecycle state.
      </p>
    </div>
    <a href="/library" class="inline-flex items-center justify-center rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">
      Back to Library
    </a>
  </div>

  <section class="mb-6 rounded border border-slate-200 bg-slate-50 p-4">
    <p class="text-sm font-semibold text-slate-700">
      <%= report.explanation %>
    </p>
    <p class="mt-1 text-xs text-slate-500">
      Generated at <%= report.generated_at %>
    </p>
  </section>

  <section class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Legacy Rows</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= summary.total_legacy_rows || 0 %></p>
      <p class="mt-1 text-xs text-slate-500">Active: <%= summary.active_legacy_rows || 0 %></p>
    </article>
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Serialized Components</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= summary.total_serialized_components || 0 %></p>
      <p class="mt-1 text-xs text-slate-500">Active installs: <%= summary.active_serialized_installations || 0 %></p>
    </article>
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Matched Pairs</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= summary.matched_count || 0 %></p>
      <p class="mt-1 text-xs text-slate-500">Legacy + serialized candidate pairs</p>
    </article>
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Readiness</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= summary.readiness_percentage || 0 %>%</p>
      <p class="mt-1 text-xs text-slate-500">Migration-ready: <%= summary.migration_ready_count || 0 %></p>
    </article>
  </section>

  <section class="mb-6 rounded border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-4">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">Bucket Counts</p>
      <h2 class="mt-1 text-xl font-black text-slate-900">Reconciliation Buckets</h2>
    </div>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      <% buckets.forEach((bucket) => { %>
        <div class="rounded border border-slate-200 bg-slate-50 p-3">
          <p class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500"><%= bucket %></p>
          <p class="mt-2 text-2xl font-black text-slate-900"><%= bucketCounts[bucket] || 0 %></p>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="rounded border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 p-5">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">Detailed Exceptions</p>
      <h2 class="mt-1 text-xl font-black text-slate-900">
        Rows Requiring Review
      </h2>
      <p class="mt-2 text-sm text-slate-600">
        MATCHED rows are excluded from this table so review effort stays focused on gaps, conflicts, and incomplete evidence.
      </p>
    </div>

    <% if (exceptions.length === 0) { %>
      <div class="p-6 text-sm font-semibold text-slate-600">
        No reconciliation exceptions were found.
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Aircraft</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Legacy ID</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Serialized ID</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Install ID</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Model</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Serial</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Position</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Bucket</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Confidence</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Conflict Flags</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% exceptions.forEach((row) => { %>
              <tr>
                <td class="px-3 py-3 font-semibold text-slate-900"><%= row.aircraft_registration || '-' %></td>
                <td class="px-3 py-3 text-slate-600"><%= row.legacy_component_id || '-' %></td>
                <td class="px-3 py-3 text-slate-600"><%= row.serialized_component_id || '-' %></td>
                <td class="px-3 py-3 text-slate-600"><%= row.serialized_installation_id || '-' %></td>
                <td class="px-3 py-3 text-slate-600">
                  <div>Legacy: <%= row.legacy_model_display || '-' %></div>
                  <div>Serialized: <%= row.serialized_model_display || '-' %></div>
                </td>
                <td class="px-3 py-3 text-slate-600">
                  <div>Legacy: <%= row.legacy_serial_number || '-' %></div>
                  <div>Serialized: <%= row.serialized_serial_number || '-' %></div>
                </td>
                <td class="px-3 py-3 text-slate-600">
                  <div>Legacy: <%= row.legacy_position || '-' %></div>
                  <div>Serialized: <%= row.serialized_position || '-' %></div>
                </td>
                <td class="px-3 py-3">
                  <span class="inline-flex rounded bg-slate-100 px-2 py-1 text-xs font-black text-slate-700">
                    <%= row.bucket %>
                  </span>
                </td>
                <td class="px-3 py-3 text-slate-600"><%= row.confidence || 'NONE' %></td>
                <td class="px-3 py-3 text-slate-600">
                  <% if (Array.isArray(row.conflict_flags) && row.conflict_flags.length > 0) { %>
                    <%= row.conflict_flags.join(', ') %>
                  <% } else { %>
                    -
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>
