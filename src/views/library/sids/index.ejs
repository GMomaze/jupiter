<%- include('../../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-6 space-y-8">
  <div class="flex items-center justify-between gap-4">
    <div>
      <a href="/library" class="text-sm text-blue-600 hover:underline">Back to Library</a>
      <h1 class="mt-3 text-3xl font-bold text-slate-900">Supplemental Inspection Documents</h1>
      <p class="mt-2 text-sm text-slate-500">
        Read-only admin view of SID records stored in <code>supplemental_inspection_documents</code>.
      </p>
    </div>
  </div>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold text-slate-900">SID Library</h2>
        <p class="mt-1 text-sm text-slate-500">
          Showing identity, interval data, active state, and applicable model counts.
        </p>
      </div>
      <div class="rounded-lg border border-purple-200 bg-purple-50 px-4 py-3 text-xs font-bold uppercase tracking-widest text-purple-700">
        <%= sids.length %> SID Records
      </div>
    </div>

    <% if (!sids.length) { %>
      <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 px-6 py-10 text-center">
        <p class="text-sm font-semibold text-slate-700">No SIDs imported yet.</p>
        <p class="mt-2 text-sm text-slate-500">
          SID source records will appear here after the SID import flow is implemented and used.
        </p>
      </div>
    <% } else { %>
      <div class="mt-6 overflow-x-auto rounded-lg border">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Manufacturer</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Reference</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Title</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Category</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Interval</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Active</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Applicable Models</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Created</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% sids.forEach((sid) => { %>
              <tr>
                <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900">
                  <%= sid.manufacturer || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900">
                  <a href="/library/sids/<%= sid.id %>" class="text-blue-700 hover:underline">
                    <%= sid.reference || '-' %>
                  </a>
                </td>
                <td class="px-3 py-3 align-top text-sm text-slate-700">
                  <%= sid.title || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= sid.category || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  Initial: <%= sid.initial_interval_hours ?? '-' %> hrs / <%= sid.initial_interval_months ?? '-' %> months
                  <div class="mt-1 text-slate-500">
                    Repeat: <%= sid.repeat_interval_hours ?? '-' %> hrs / <%= sid.repeat_interval_months ?? '-' %> months
                  </div>
                </td>
                <td class="px-3 py-3 align-top">
                  <% if (sid.is_active) { %>
                    <span class="inline-flex rounded-full bg-emerald-100 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-800">
                      Active
                    </span>
                  <% } else { %>
                    <span class="inline-flex rounded-full bg-slate-200 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-700">
                      Inactive
                    </span>
                  <% } %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= sid.ModelApplicability?.length || 0 %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= sid.created_at ? new Date(sid.created_at).toLocaleString() : '-' %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../../partials/footer') %>
