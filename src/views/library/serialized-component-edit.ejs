<%- include('../partials/header') %>

<main class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <% const model = serializedComponent.ComponentModel; %>
  <% const activeAircraft = activeInstallation?.Aircraft; %>
  <% const isInstalled = Boolean(activeInstallation); %>
  <% const safeStatuses = safeEditableStatuses || []; %>
  <% const canEditStatus = !isInstalled && safeStatuses.includes(serializedComponent.status); %>
  <% const lifeState = serializedComponent.LifeState || null; %>
  <% const maintenanceEvents = serializedComponent.MaintenanceEvents || []; %>

  <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">
        Edit Serialized Component
      </h1>
      <p class="mt-2 text-sm text-slate-500">
        Update Library-controlled serialized component information without changing aircraft installation history or maintenance authority.
      </p>
    </div>

    <div class="flex gap-4 text-sm font-semibold">
      <a href="/library/serialized-components" class="text-blue-600 hover:underline">Back to Serialized Components</a>
      <a href="/library/serialized-components/<%= serializedComponent.id %>/life" class="text-blue-600 hover:underline">Life Dashboard</a>
      <a href="/library" class="text-blue-600 hover:underline">Back to Library</a>
    </div>
  </div>

  <% if (messages?.success?.length || messages?.error?.length) { %>
    <div class="mb-6 space-y-3">
      <% (messages?.success || []).forEach((message) => { %>
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800"><%= message %></div>
      <% }) %>
      <% (messages?.error || []).forEach((message) => { %>
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-800"><%= message %></div>
      <% }) %>
    </div>
  <% } %>

  <% if (isInstalled) { %>
    <section class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-5">
      <h2 class="text-sm font-bold uppercase tracking-widest text-amber-800">Installed Component Lock</h2>
      <p class="mt-2 text-sm leading-6 text-amber-900">
        This serialized component is currently installed on
        <span class="font-semibold"><%= activeAircraft?.registration || 'an aircraft' %></span>
        <% if (activeInstallation?.position) { %>
          at position <span class="font-semibold"><%= activeInstallation.position %></span>
        <% } %>.
        Library edit is limited to non-lifecycle metadata only.
      </p>
      <p class="mt-2 text-sm leading-6 text-amber-900">
        Component model and status are locked here because installation and removal state must remain controlled by operational install/remove workflows, not by Library edits.
      </p>
    </section>
  <% } %>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <div class="mb-6 grid gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4 md:grid-cols-2">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Current Model</p>
        <p class="mt-1 text-sm font-semibold text-slate-900">
          <%= model?.Manufacturer?.name || '-' %> <%= model?.model_name || '-' %>
        </p>
        <p class="mt-1 text-xs text-slate-500">
          <%= model?.AssetType?.code || '-' %><% if (model?.model_code) { %> | <%= model.model_code %><% } %>
        </p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Current Status</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= serializedComponent.status || '-' %></p>
        <p class="mt-1 text-xs text-slate-500">
          <% if (isInstalled) { %>
            Installed <%= activeInstallation?.installed_at || '-' %>
          <% } else { %>
            Created <%= serializedComponent.created_at || '-' %>
          <% } %>
        </p>
      </div>
    </div>

    <form method="POST" action="/library/serialized-components/<%= serializedComponent.id %>/update?_csrf=<%= encodeURIComponent(csrfToken) %>" class="grid gap-4 md:grid-cols-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="md:col-span-2">
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">
          Component Model
        </label>

        <% if (isInstalled) { %>
          <div class="w-full rounded border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
            <%= model?.Manufacturer?.name || '-' %> - <%= model?.model_name || '-' %>
          </div>
          <p class="mt-1 text-xs text-slate-500">
            Locked while installed to preserve current aircraft installation identity and operational history.
          </p>
        <% } else { %>
          <select name="component_model_id" required class="w-full rounded border px-3 py-2 text-sm">
            <option value="">Select a model</option>
            <% manufacturers.forEach((manufacturer) => { %>
              <% const models = manufacturer.ComponentModels || []; %>
              <% if (models.length > 0) { %>
                <optgroup label="<%= manufacturer.name %>">
                  <% models.forEach((manufacturerModel) => { %>
                    <option
                      value="<%= manufacturerModel.id %>"
                      <%= manufacturerModel.id === serializedComponent.component_model_id ? 'selected' : '' %>
                    >
                      <%= manufacturerModel.model_name %><%= manufacturerModel.model_code ? ` (${manufacturerModel.model_code})` : '' %>
                    </option>
                  <% }) %>
                </optgroup>
              <% } %>
            <% }) %>
          </select>
        <% } %>
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">
          Serial Number
        </label>
        <input
          type="text"
          name="serial_number"
          required
          value="<%= serializedComponent.serial_number || '' %>"
          class="w-full rounded border px-3 py-2 text-sm"
        >
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">
          Part Number
        </label>
        <input
          type="text"
          name="part_number"
          value="<%= serializedComponent.part_number || '' %>"
          class="w-full rounded border px-3 py-2 text-sm"
        >
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">
          Status
        </label>

        <% if (!canEditStatus) { %>
          <div class="w-full rounded border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
            <%= serializedComponent.status || '-' %>
          </div>
          <p class="mt-1 text-xs text-slate-500">
            Locked because install/remove lifecycle state cannot be changed from the Library edit screen.
          </p>
        <% } else { %>
          <select name="status" class="w-full rounded border px-3 py-2 text-sm">
            <% safeStatuses.forEach((statusOption) => { %>
              <option
                value="<%= statusOption %>"
                <%= statusOption === serializedComponent.status ? 'selected' : '' %>
              >
                <%= statusOption %>
              </option>
            <% }) %>
          </select>
          <p class="mt-1 text-xs text-slate-500">
            Only non-lifecycle status changes are allowed here. Install/remove state remains controlled by operational workflows.
          </p>
        <% } %>
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">
          Condition
        </label>
        <input
          type="text"
          name="condition"
          value="<%= serializedComponent.condition || '' %>"
          class="w-full rounded border px-3 py-2 text-sm"
        >
      </div>

      <div class="md:col-span-2">
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">
          Notes
        </label>
        <textarea
          name="notes"
          rows="4"
          class="w-full rounded border px-3 py-2 text-sm"
        ><%= serializedComponent.notes || '' %></textarea>
      </div>

      <div class="md:col-span-2 flex flex-wrap items-center gap-3">
        <button type="submit" class="rounded bg-slate-800 px-4 py-2 text-sm font-bold text-white hover:bg-black">
          Save Serialized Component
        </button>
        <a href="/library/serialized-components" class="text-sm font-semibold text-slate-600 hover:underline">
          Cancel
        </a>
      </div>
    </form>
  </section>

  <section class="mt-8 rounded-xl border bg-white p-6 shadow-sm">
    <div class="mb-6">
      <h2 class="text-lg font-bold text-slate-900">Serialized Life State</h2>
      <p class="mt-1 text-sm text-slate-500">
        LIFE_ADJUSTMENT records update current life values only. They do not install, remove, overhaul, create due calculations, or change aircraft/workpack/compliance state.
      </p>
    </div>

    <div class="grid gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4 md:grid-cols-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">TSN Hours</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.tsn_hours ?? '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">TSO Hours</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.tso_hours ?? '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">CSN Cycles</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.csn_cycles ?? '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">CSO Cycles</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.cso_cycles ?? '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Overhaul Reference</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.overhaul_reference_date ?? '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Calendar Reference</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.calendar_reference_date ?? '-' %></p>
      </div>
    </div>

    <form
      method="POST"
      action="/library/serialized-components/<%= serializedComponent.id %>/life-adjustment?_csrf=<%= encodeURIComponent(csrfToken) %>"
      class="mt-6 grid gap-4 md:grid-cols-2"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Occurred At</label>
        <input type="datetime-local" name="occurred_at" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Source Reference</label>
        <input type="text" name="source_reference" placeholder="Logbook, shop report, invoice, worksheet" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">TSN Hours</label>
        <input type="number" step="0.01" min="0" name="tsn_hours" value="<%= lifeState?.tsn_hours ?? '' %>" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">TSO Hours</label>
        <input type="number" step="0.01" min="0" name="tso_hours" value="<%= lifeState?.tso_hours ?? '' %>" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">CSN Cycles</label>
        <input type="number" step="1" min="0" name="csn_cycles" value="<%= lifeState?.csn_cycles ?? '' %>" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">CSO Cycles</label>
        <input type="number" step="1" min="0" name="cso_cycles" value="<%= lifeState?.cso_cycles ?? '' %>" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Overhaul Reference Date</label>
        <input type="date" name="overhaul_reference_date" value="<%= lifeState?.overhaul_reference_date ?? '' %>" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Calendar Reference Date</label>
        <input type="date" name="calendar_reference_date" value="<%= lifeState?.calendar_reference_date ?? '' %>" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div class="md:col-span-2 grid gap-3 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
        <label class="flex items-start gap-2">
          <input type="checkbox" name="allow_tso_exceeds_tsn" class="mt-1">
          <span>Confirm documented reason if TSO is greater than TSN.</span>
        </label>
        <label class="flex items-start gap-2">
          <input type="checkbox" name="allow_cso_exceeds_csn" class="mt-1">
          <span>Confirm documented reason if CSO is greater than CSN.</span>
        </label>
      </div>

      <div class="md:col-span-2">
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Required Reason</label>
        <textarea name="reason" rows="4" required class="w-full rounded border px-3 py-2 text-sm" placeholder="Explain the document, baseline, correction, or reconciliation basis for this life adjustment."></textarea>
      </div>

      <div class="md:col-span-2">
        <button type="submit" class="rounded bg-blue-700 px-4 py-2 text-sm font-bold text-white hover:bg-blue-800">
          Record Life Adjustment
        </button>
      </div>
    </form>
  </section>

  <section class="mt-8 rounded-xl border bg-white p-6 shadow-sm">
    <div class="mb-6">
      <h2 class="text-lg font-bold text-slate-900">Record Overhaul</h2>
      <p class="mt-1 text-sm text-slate-500">
        OVERHAUL records documented overhaul evidence and selected post-overhaul life values only. It does not install, remove, calculate due status, or change aircraft/workpack/compliance state.
      </p>
    </div>

    <form
      method="POST"
      action="/library/serialized-components/<%= serializedComponent.id %>/overhaul?_csrf=<%= encodeURIComponent(csrfToken) %>"
      class="grid gap-4 md:grid-cols-2"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Overhaul Date</label>
        <input type="date" name="overhaul_date" required class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Overhaul Provider</label>
        <input type="text" name="overhaul_provider" required placeholder="Approved shop, AMO, engineer, or provider" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div class="md:col-span-2">
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Reference / Work Order / Release Number</label>
        <input type="text" name="overhaul_reference" required placeholder="Work order, release certificate, shop report, or logbook reference" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">TSN Hours</label>
        <input type="number" step="0.01" min="0" name="tsn_hours" value="<%= lifeState?.tsn_hours ?? '' %>" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">TSO Hours</label>
        <input type="number" step="0.01" min="0" name="tso_hours" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">CSN Cycles</label>
        <input type="number" step="1" min="0" name="csn_cycles" value="<%= lifeState?.csn_cycles ?? '' %>" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">CSO Cycles</label>
        <input type="number" step="1" min="0" name="cso_cycles" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Overhaul Reference Date</label>
        <input type="date" name="overhaul_reference_date" class="w-full rounded border px-3 py-2 text-sm">
        <p class="mt-1 text-xs text-slate-500">Defaults to overhaul date if left blank.</p>
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Calendar Reference Date</label>
        <input type="date" name="calendar_reference_date" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div class="md:col-span-2">
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Required Notes</label>
        <textarea name="notes" rows="4" required class="w-full rounded border px-3 py-2 text-sm" placeholder="Describe the overhaul evidence, release basis, reset basis, and any post-overhaul life values entered."></textarea>
      </div>

      <div class="md:col-span-2">
        <button type="submit" class="rounded bg-emerald-700 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-800">
          Record Overhaul
        </button>
      </div>
    </form>
  </section>

  <section class="mt-8 rounded-xl border bg-white p-6 shadow-sm">
    <div class="mb-6">
      <h2 class="text-lg font-bold text-slate-900">Record Maintenance Event</h2>
      <p class="mt-1 text-sm text-slate-500">
        Generic maintenance events record non-life-changing evidence only. They do not update TSN, TSO, CSN, CSO, install/remove state, aircraft/workpack/compliance state, or component status.
      </p>
    </div>

    <form
      method="POST"
      action="/library/serialized-components/<%= serializedComponent.id %>/maintenance-events?_csrf=<%= encodeURIComponent(csrfToken) %>"
      class="grid gap-4 md:grid-cols-2"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Event Type</label>
        <select name="event_type" required class="w-full rounded border px-3 py-2 text-sm">
          <option value="">Select event type</option>
          <option value="REPAIR">REPAIR</option>
          <option value="INSPECTION">INSPECTION</option>
          <option value="SHOP_VISIT">SHOP_VISIT</option>
          <option value="TEST">TEST</option>
          <option value="MODIFICATION">MODIFICATION</option>
          <option value="PRESERVATION">PRESERVATION</option>
          <option value="RETURN_TO_SERVICE">RETURN_TO_SERVICE</option>
          <option value="SCRAP">SCRAP</option>
          <option value="UNKNOWN_HISTORY_IMPORT">UNKNOWN_HISTORY_IMPORT</option>
        </select>
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Occurred Date</label>
        <input type="date" name="occurred_at" required class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Provider / Source</label>
        <input type="text" name="provider" required placeholder="Shop, AMO, engineer, owner record, imported source" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div>
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Reference / Work Order / Release</label>
        <input type="text" name="reference" required placeholder="Work order, release, shop report, logbook, import reference" class="w-full rounded border px-3 py-2 text-sm">
      </div>

      <div class="md:col-span-2">
        <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-slate-500">Required Notes</label>
        <textarea name="notes" rows="4" required class="w-full rounded border px-3 py-2 text-sm" placeholder="Record the evidence, finding, result, or source text for this non-life-changing event."></textarea>
      </div>

      <div class="md:col-span-2">
        <button type="submit" class="rounded bg-slate-800 px-4 py-2 text-sm font-bold text-white hover:bg-black">
          Record Maintenance Event
        </button>
      </div>
    </form>
  </section>

  <section class="mt-8 rounded-xl border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900">Recent Maintenance Events</h2>
    <% if (maintenanceEvents.length === 0) { %>
      <p class="mt-3 text-sm text-slate-500">No serialized component maintenance events recorded yet.</p>
    <% } else { %>
      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Type</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Occurred</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% maintenanceEvents.forEach((event) => { %>
              <tr>
                <td class="px-3 py-2 text-sm font-semibold text-slate-900"><%= event.event_type %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= event.occurred_at || '-' %></td>
                <td class="px-3 py-2 whitespace-pre-wrap text-sm text-slate-700"><%= event.notes || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>
