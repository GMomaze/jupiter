<%- include('../../partials/header') %>

<%
  const references = bulletin.AirworthinessDirectiveReferences || bulletin.getDataValue?.('AirworthinessDirectiveReferences') || [];
%>

<main class="max-w-7xl mx-auto py-10 px-6 space-y-8">
  <div>
    <a href="/library/sbs" class="text-sm text-blue-600 hover:underline">Back to Service Bulletins</a>
    <h1 class="mt-3 text-3xl font-bold text-slate-900"><%= bulletin.sb_number || bulletin.reference || 'Service Bulletin' %></h1>
    <p class="mt-2 text-sm text-slate-500">
      Read-only service bulletin record and matched AD source references.
    </p>
  </div>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <div class="grid gap-4 md:grid-cols-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Manufacturer</p>
        <p class="mt-1 text-sm text-slate-900"><%= bulletin.manufacturer || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Reference</p>
        <p class="mt-1 text-sm text-slate-900"><%= bulletin.reference || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Revision</p>
        <p class="mt-1 text-sm text-slate-900"><%= bulletin.revision || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Issue Date</p>
        <p class="mt-1 text-sm text-slate-900"><%= bulletin.issued_on || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Status</p>
        <p class="mt-1 text-sm text-slate-900"><%= bulletin.status || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Category</p>
        <p class="mt-1 text-sm text-slate-900"><%= bulletin.category || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Applicability Make</p>
        <p class="mt-1 text-sm text-slate-900"><%= bulletin.applicability_make || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Applicability Model</p>
        <p class="mt-1 text-sm text-slate-900"><%= bulletin.applicability_model || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Active</p>
        <p class="mt-1 text-sm text-slate-900"><%= bulletin.is_active ? 'Yes' : 'No' %></p>
      </div>
    </div>

    <div class="mt-6 border-t pt-6">
      <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Title</p>
      <p class="mt-1 text-sm text-slate-900"><%= bulletin.title || '-' %></p>
    </div>

    <div class="mt-4">
      <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Description</p>
      <p class="mt-1 whitespace-pre-wrap text-sm text-slate-700"><%= bulletin.description || '-' %></p>
    </div>
  </section>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold text-slate-900">Referenced By Airworthiness Directives</h2>
        <p class="mt-1 text-sm text-slate-500">
          Informational AD source references only. These rows do not establish compliance equivalence.
        </p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-xs font-bold uppercase tracking-widest text-slate-700">
        <%= references.length %> AD References
      </div>
    </div>

    <% if (!references.length) { %>
      <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 px-6 py-10 text-center">
        <p class="text-sm font-semibold text-slate-700">No airworthiness directives currently reference this service bulletin.</p>
      </div>
    <% } else { %>
      <div class="mt-6 overflow-x-auto rounded-lg border">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">AD Number</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Revision</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Subject</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Raw Reference</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Status</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Reason</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% references.forEach((reference) => { %>
              <% const directive = reference.AirworthinessDirective; %>
              <tr>
                <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900">
                  <% if (directive) { %>
                    <a href="/library/ads/<%= directive.id %>" class="text-blue-700 hover:underline">
                      <%= directive.ad_number || '-' %>
                    </a>
                  <% } else { %>
                    -
                  <% } %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700"><%= directive?.revision || '-' %></td>
                <td class="px-3 py-3 align-top text-sm text-slate-700"><%= directive?.subject_heading || directive?.subject || '-' %></td>
                <td class="px-3 py-3 align-top text-sm text-slate-700"><%= reference.raw_reference_text || '-' %></td>
                <td class="px-3 py-3 align-top text-xs text-slate-700"><%= reference.match_status || '-' %></td>
                <td class="px-3 py-3 align-top text-xs text-slate-700"><%= reference.match_reason || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../../partials/footer') %>
