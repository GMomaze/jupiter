<%- include('../../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-6 space-y-8">
  <div class="flex items-center justify-between gap-4">
    <div>
      <a href="/library/sbs/import" class="text-sm text-blue-600 hover:underline">Back to SB Import</a>
      <h1 class="mt-3 text-3xl font-bold text-slate-900">SB Import Preview</h1>
      <p class="mt-2 text-sm text-slate-500">
        Preview generated for <span class="font-semibold text-slate-700"><%= fileName %></span>. No rows have been saved.
      </p>
    </div>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
    <div class="rounded-xl border bg-white p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Adapter Used</div>
      <div class="mt-2 text-lg font-black text-slate-900"><%= preview.adapterUsed %></div>
    </div>
    <div class="rounded-xl border bg-white p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Total Rows</div>
      <div class="mt-2 text-2xl font-black text-slate-900"><%= preview.totalRows %></div>
    </div>
    <div class="rounded-xl border bg-emerald-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-emerald-700">Valid Rows</div>
      <div class="mt-2 text-2xl font-black text-emerald-800"><%= preview.validRowCount %></div>
    </div>
    <div class="rounded-xl border bg-rose-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-rose-700">Invalid Rows</div>
      <div class="mt-2 text-2xl font-black text-rose-800"><%= preview.invalidRowCount %></div>
    </div>
    <div class="rounded-xl border bg-amber-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-amber-700">Unknown Columns</div>
      <div class="mt-2 text-sm font-bold text-amber-800">
        <%= preview.unknownColumns.length ? preview.unknownColumns.join(', ') : 'None' %>
      </div>
    </div>
  </section>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <div>
      <h2 class="text-lg font-bold text-slate-900">Row Preview</h2>
      <p class="mt-1 text-sm text-slate-500">
        Each row shows normalized Service Bulletin values plus validation results. This preview is read-only.
      </p>
    </div>

    <% if (!preview.rows.length) { %>
      <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 px-4 py-6 text-sm text-slate-500">
        No data rows were found after empty rows were ignored.
      </div>
    <% } else { %>
      <div class="mt-4 overflow-x-auto rounded-lg border">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Row</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Manufacturer</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Reference</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Title</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Issue Date</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Status</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Normalized Values</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Validation</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% preview.rows.forEach((row) => { %>
              <tr>
                <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900"><%= row.rowNumber %></td>
                <td class="px-3 py-3 align-top text-sm text-slate-700"><%= row.values.manufacturer || '-' %></td>
                <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900"><%= row.values.reference || '-' %></td>
                <td class="px-3 py-3 align-top text-sm text-slate-700"><%= row.values.title || '-' %></td>
                <td class="px-3 py-3 align-top text-xs text-slate-700"><%= row.values.issue_date || '-' %></td>
                <td class="px-3 py-3 align-top">
                  <% if (row.status === 'VALID') { %>
                    <span class="inline-flex rounded-full bg-emerald-100 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-800">
                      VALID
                    </span>
                  <% } else { %>
                    <span class="inline-flex rounded-full bg-rose-100 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-rose-800">
                      INVALID
                    </span>
                  <% } %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <dl class="grid gap-2 md:grid-cols-2">
                    <div><dt class="font-bold text-slate-500">revision</dt><dd><%= row.values.revision || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">status</dt><dd><%= row.values.status || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">category</dt><dd><%= row.values.category || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">applicability_make</dt><dd><%= row.values.applicability_make || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">applicability_model</dt><dd><%= row.values.applicability_model || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">applicability_product_type</dt><dd><%= row.values.applicability_product_type || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">applicability_notes</dt><dd><%= row.values.applicability_notes || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">summary</dt><dd><%= row.values.summary || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">compliance_requirement</dt><dd><%= row.values.compliance_requirement || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">source_file</dt><dd><%= row.values.source_file || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">source_format</dt><dd><%= row.values.source_format || '-' %></dd></div>
                    <div><dt class="font-bold text-slate-500">is_active</dt><dd><%= row.values.is_active === null ? '-' : row.values.is_active ? 'true' : 'false' %></dd></div>
                    <div class="md:col-span-2"><dt class="font-bold text-slate-500">raw_source_text</dt><dd><%= row.values.raw_source_text || '-' %></dd></div>
                  </dl>
                </td>
                <td class="px-3 py-3 align-top text-xs">
                  <% if (!row.errors.length) { %>
                    <span class="text-emerald-700">No validation errors.</span>
                  <% } else { %>
                    <ul class="space-y-1 text-rose-700">
                      <% row.errors.forEach((error) => { %>
                        <li><%= error %></li>
                      <% }) %>
                    </ul>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="rounded-xl border bg-slate-50 p-6 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-bold text-slate-900">Commit Step</h2>
        <p class="mt-1 text-sm text-slate-500">
          Only rows marked <span class="font-semibold text-emerald-700">VALID</span> will be inserted into <code>service_bulletins</code>. Invalid and duplicate rows will be skipped.
        </p>
      </div>

      <form
        method="POST"
        action="/library/sbs/import/commit?_csrf=<%= encodeURIComponent(csrfToken) %>"
        class="flex flex-col gap-3 sm:items-end"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="file_name" value="<%= fileName %>">
        <input type="hidden" name="preview_payload" value="<%= previewPayload %>">

        <button
          type="submit"
          class="rounded bg-emerald-700 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-800"
        >
          Commit Valid Rows
        </button>
      </form>
    </div>
  </section>
</main>

<%- include('../../partials/footer') %>
