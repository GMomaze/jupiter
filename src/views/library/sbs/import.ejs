<%- include('../../partials/header') %>

<main class="max-w-4xl mx-auto py-10 px-6 space-y-8">
  <% if (messages?.success?.length || messages?.error?.length) { %>
    <section class="space-y-3">
      <% (messages?.success || []).forEach((message) => { %>
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
          <%= message %>
        </div>
      <% }) %>
      <% (messages?.error || []).forEach((message) => { %>
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
          <%= message %>
        </div>
      <% }) %>
    </section>
  <% } %>

  <div>
    <a href="/library" class="text-sm text-blue-600 hover:underline">Back to Library</a>
  </div>

  <section class="bg-white border rounded-xl p-6 shadow-sm space-y-5">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">SB Import Preview</h1>
      <p class="mt-2 text-sm text-slate-500">
        Upload a Service Bulletin CSV and preview normalized rows in memory only. No database writes occur in this phase.
      </p>
    </div>

    <form
      method="POST"
      action="/library/sbs/import/preview?_csrf=<%= encodeURIComponent(csrfToken) %>"
      enctype="multipart/form-data"
      class="space-y-4 rounded-lg border border-slate-200 bg-slate-50 p-5"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label for="adapter" class="text-sm font-semibold text-slate-900">Adapter</label>
        <select
          id="adapter"
          name="adapter"
          class="mt-2 block w-full rounded border bg-white px-3 py-2 text-sm text-slate-700"
        >
          <% adapterOptions.forEach((option) => { %>
            <option
              value="<%= option.key %>"
              <%= selectedAdapter === option.key ? 'selected' : '' %>
              <%= option.enabled ? '' : 'disabled' %>
            >
              <%= option.label %><%= option.enabled ? '' : ' (Placeholder)' %>
            </option>
          <% }) %>
        </select>
        <p class="mt-2 text-xs text-slate-500">
          <% adapterOptions.forEach((option, index) => { %>
            <span><%= option.label %>: <%= option.description %></span><%= index < adapterOptions.length - 1 ? ' | ' : '' %>
          <% }) %>
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <input
          type="file"
          name="sb_file"
          accept=".csv,text/csv"
          required
          class="block w-full rounded border bg-white px-3 py-2 text-sm text-slate-700"
        >
        <button
          type="submit"
          class="rounded bg-slate-800 px-4 py-2 text-sm font-bold text-white hover:bg-black"
        >
          Preview File
        </button>
      </div>

      <ul class="text-xs text-slate-500 space-y-1">
        <li>Piper adapter expects `title`, `reference`, and `date` columns</li>
        <li>Generic adapter accepts flexible headers and maps known columns when possible</li>
        <li>Unknown columns are reported and do not stop preview</li>
        <li>Empty rows are ignored</li>
        <li>Invalid rows are shown clearly and nothing is saved</li>
      </ul>
    </form>
  </section>
</main>

<%- include('../../partials/footer') %>
