<%- include('../../partials/header') %>

<main class="max-w-5xl mx-auto py-10 px-6 space-y-8">
  <div>
    <a href="/library/sbs" class="text-sm text-blue-600 hover:underline">Back to SB Library</a>
    <h1 class="mt-3 text-3xl font-bold text-slate-900">Add New SB / SL / SI</h1>
    <p class="mt-2 text-sm text-slate-500">
      Create one service document using existing Service Bulletin source-data fields.
    </p>
  </div>

  <div class="rounded border border-amber-200 bg-amber-50 p-4 text-sm font-semibold text-amber-800">
    Related AD and ATA linkage will be added in a later phase.
  </div>

  <% if (errors && errors.length) { %>
    <div class="rounded border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700">
      <% errors.forEach((error) => { %>
        <p><%= error %></p>
      <% }) %>
    </div>
  <% } %>

  <form method="POST" action="/library/sbs" class="grid gap-4 rounded-xl border bg-white p-6 shadow-sm md:grid-cols-2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label class="block">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-600">Document Type</span>
      <select name="category" class="mt-1 w-full rounded border px-3 py-2 text-sm">
        <% ['SB', 'SL', 'SI', 'CIL', 'OTHER'].forEach((category) => { %>
          <option value="<%= category %>" <%= (form.category || 'SB') === category ? 'selected' : '' %>><%= category %></option>
        <% }) %>
      </select>
    </label>

    <label class="block">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-600">Reference *</span>
      <input name="reference" value="<%= form.reference || form.sb_number || '' %>" required class="mt-1 w-full rounded border px-3 py-2 text-sm">
    </label>

    <label class="block md:col-span-2">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-600">Title *</span>
      <input name="title" value="<%= form.title || '' %>" required class="mt-1 w-full rounded border px-3 py-2 text-sm">
    </label>

    <label class="block">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-600">Manufacturer *</span>
      <input name="manufacturer" value="<%= form.manufacturer || '' %>" required class="mt-1 w-full rounded border px-3 py-2 text-sm">
    </label>

    <label class="block">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-600">Revision</span>
      <input name="revision" value="<%= form.revision || '' %>" class="mt-1 w-full rounded border px-3 py-2 text-sm">
    </label>

    <label class="block">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-600">Issue Date</span>
      <input type="date" name="issued_on" value="<%= form.issued_on || '' %>" class="mt-1 w-full rounded border px-3 py-2 text-sm">
    </label>

    <label class="block">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-600">Compliance Requirement</span>
      <select name="compliance_type" class="mt-1 w-full rounded border px-3 py-2 text-sm">
        <% ['MANUAL', 'MANDATORY', 'OPTIONAL'].forEach((type) => { %>
          <option value="<%= type %>" <%= (form.compliance_type || 'MANUAL') === type ? 'selected' : '' %>><%= type %></option>
        <% }) %>
      </select>
    </label>

    <label class="block">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-600">Applicability Make</span>
      <input name="applicability_make" value="<%= form.applicability_make || '' %>" class="mt-1 w-full rounded border px-3 py-2 text-sm">
    </label>

    <label class="block">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-600">Applicability Model</span>
      <input name="applicability_model" value="<%= form.applicability_model || '' %>" class="mt-1 w-full rounded border px-3 py-2 text-sm">
    </label>

    <label class="block md:col-span-2">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-600">Source Document / URL</span>
      <input name="document_url" value="<%= form.document_url || '' %>" class="mt-1 w-full rounded border px-3 py-2 text-sm">
    </label>

    <label class="block md:col-span-2">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-600">Summary / Notes</span>
      <textarea name="description" rows="4" class="mt-1 w-full rounded border px-3 py-2 text-sm"><%= form.description || '' %></textarea>
    </label>

    <div class="md:col-span-2 flex justify-end gap-3">
      <a href="/library/sbs" class="rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">Cancel</a>
      <button type="submit" class="rounded bg-slate-800 px-4 py-2 text-sm font-bold text-white hover:bg-black">Create Service Document</button>
    </div>
  </form>
</main>

<%- include('../../partials/footer') %>
