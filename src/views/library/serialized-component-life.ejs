<%- include('../partials/header') %>

<main class="max-w-6xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <% const component = serializedComponent; %>
  <% const model = componentModel; %>
  <% const manufacturer = model?.Manufacturer; %>
  <% const assetType = model?.AssetType; %>
  <% const currentAircraft = currentInstallation?.Aircraft; %>
  <% const safeComplianceVisibility = complianceVisibility || {}; %>
  <% const applicableServiceBulletins = safeComplianceVisibility.applicableServiceBulletins || []; %>
  <%
    const lifeStateDisplayFields = [
      ['tsn_hours', 'TSN'],
      ['tso_hours', 'TSO'],
      ['csn_cycles', 'CSN'],
      ['cso_cycles', 'CSO'],
      ['overhaul_reference_date', 'Overhaul Reference Date'],
      ['calendar_reference_date', 'Calendar Reference Date'],
    ];

    const displayLifeStateValue = (value) => {
      if (value === null || typeof value === 'undefined' || value === '') {
        return '-';
      }

      return value;
    };

    const parseMaintenanceEventNotes = (notes) => {
      const rawNotes = String(notes || '').trim();
      const parsed = {
        textLines: [],
        before: null,
        after: null,
        warnings: [],
      };

      if (!rawNotes) {
        return parsed;
      }

      rawNotes.split(/\r?\n/).forEach((line) => {
        const beforeMatch = line.match(/^Before:\s*(.*)$/);
        const afterMatch = line.match(/^After:\s*(.*)$/);
        const stateMatch = beforeMatch || afterMatch;

        if (!stateMatch) {
          parsed.textLines.push(line);
          return;
        }

        const label = beforeMatch ? 'before' : 'after';
        const payload = stateMatch[1] || '';

        try {
          parsed[label] = JSON.parse(payload);
        } catch (_error) {
          parsed.warnings.push(
            `${beforeMatch ? 'Before' : 'After'} life-state snapshot could not be displayed.`
          );
        }
      });

      return parsed;
    };
  %>

  <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">
        Serialized Component Life
      </h1>
      <p class="mt-2 text-sm text-slate-500">
        Read-only life, installation, and maintenance-event visibility for this serialized component.
      </p>
    </div>

    <div class="flex flex-wrap gap-4 text-sm font-semibold">
      <a href="/library/serialized-components" class="text-blue-600 hover:underline">Back to Serialized Components</a>
      <a href="/library/serialized-components/<%= component.id %>/edit" class="text-blue-600 hover:underline">Edit Component</a>
      <a href="/library" class="text-blue-600 hover:underline">Back to Library</a>
    </div>
  </div>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900">Serialized Component Identity</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Serial Number</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= component.serial_number || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Part Number</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= component.part_number || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Status</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= component.status || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Model Code</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= model?.model_code || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Model Name</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= model?.model_name || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Manufacturer</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= manufacturer?.name || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Asset Type</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= assetType?.code || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Condition</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= component.condition || '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Created</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= component.created_at || component.createdAt || '-' %></p>
      </div>
    </div>
    <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
      <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Notes</p>
      <p class="mt-2 whitespace-pre-wrap text-sm text-slate-700"><%= component.notes || '-' %></p>
    </div>
  </section>

  <section class="mt-8 rounded-xl border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900">Current Installation</h2>
    <% if (!currentInstallation) { %>
      <p class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm font-semibold text-slate-700">Not currently installed</p>
    <% } else { %>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Aircraft Registration</p>
          <p class="mt-1 text-sm font-semibold text-slate-900"><%= currentAircraft?.registration || '-' %></p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Aircraft Serial</p>
          <p class="mt-1 text-sm font-semibold text-slate-900"><%= currentAircraft?.serial_number || '-' %></p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Position</p>
          <p class="mt-1 text-sm font-semibold text-slate-900"><%= currentInstallation.position || '-' %></p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Installed Date</p>
          <p class="mt-1 text-sm font-semibold text-slate-900"><%= currentInstallation.installed_at || '-' %></p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Install TSN</p>
          <p class="mt-1 text-sm font-semibold text-slate-900"><%= currentInstallation.install_tsn ?? '-' %></p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Install TSO</p>
          <p class="mt-1 text-sm font-semibold text-slate-900"><%= currentInstallation.install_tso ?? '-' %></p>
        </div>
      </div>
    <% } %>
  </section>

  <section class="mt-8 rounded-xl border border-blue-200 bg-blue-50 p-6 shadow-sm">
    <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
      <div>
        <h2 class="text-lg font-bold text-slate-900">Compliance Visibility</h2>
        <p class="mt-2 text-sm text-blue-900">
          <%= safeComplianceVisibility.explanation || 'Read-only derived compliance visibility is unavailable.' %>
        </p>
      </div>
      <div class="rounded-full border border-blue-200 bg-white px-3 py-1 text-xs font-bold uppercase tracking-widest text-blue-700">
        Read Only
      </div>
    </div>

    <div class="mt-5 grid gap-4 md:grid-cols-3">
      <div class="rounded-lg border border-blue-200 bg-white p-4">
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Current Aircraft Context</p>
        <% if (currentInstallation && currentAircraft) { %>
          <p class="mt-2 text-sm font-semibold text-slate-900"><%= currentAircraft.registration || '-' %></p>
          <p class="mt-1 text-xs text-slate-600">S/N <%= currentAircraft.serial_number || '-' %></p>
        <% } else { %>
          <p class="mt-2 text-sm font-semibold text-slate-900">Not currently installed</p>
        <% } %>
      </div>
      <div class="rounded-lg border border-blue-200 bg-white p-4">
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Life-Limit Due Status</p>
        <p class="mt-2 text-2xl font-black tracking-tight text-slate-900"><%= dueStatus?.state || 'UNKNOWN' %></p>
        <p class="mt-1 text-xs text-slate-600"><%= dueStatus?.explanation || 'Not available' %></p>
      </div>
      <div class="rounded-lg border border-blue-200 bg-white p-4">
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Supporting History</p>
        <p class="mt-2 text-2xl font-black tracking-tight text-slate-900"><%= safeComplianceVisibility.maintenanceEventCount ?? 0 %></p>
        <p class="mt-1 text-xs text-slate-600">Maintenance events recorded against this serialized component.</p>
      </div>
    </div>

    <div class="mt-6 rounded-lg border border-blue-200 bg-white">
      <div class="flex flex-col gap-1 border-b border-blue-100 bg-white px-4 py-3 md:flex-row md:items-center md:justify-between">
        <h3 class="text-sm font-bold text-slate-900">Applicable Service Bulletins</h3>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
          <%= applicableServiceBulletins.length %> matched by component model
        </p>
      </div>

      <% if (!applicableServiceBulletins || applicableServiceBulletins.length === 0) { %>
        <p class="px-4 py-4 text-sm text-slate-500">No active Service Bulletins are currently linked to this component model through service_bulletin_models.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-blue-100">
            <thead class="bg-blue-50">
              <tr>
                <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">SB Reference</th>
                <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Title</th>
                <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Compliance</th>
                <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Issued</th>
                <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Summary</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-blue-50 bg-white">
              <% applicableServiceBulletins.forEach((bulletin) => { %>
                <tr>
                  <td class="px-3 py-2 text-sm font-semibold text-slate-900"><%= bulletin.sb_number || bulletin.reference || '-' %></td>
                  <td class="px-3 py-2 text-sm text-slate-700"><%= bulletin.title || '-' %></td>
                  <td class="px-3 py-2 text-sm text-slate-700"><%= bulletin.compliance_type || bulletin.compliance_requirement || '-' %></td>
                  <td class="px-3 py-2 text-sm text-slate-700"><%= bulletin.issued_on || bulletin.issue_date || '-' %></td>
                  <td class="px-3 py-2 whitespace-pre-wrap text-sm text-slate-700"><%= bulletin.description || bulletin.summary || '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <p class="mt-4 rounded-lg border border-blue-200 bg-white px-4 py-3 text-sm font-semibold text-blue-900">
      This panel does not mark ADs, SBs, life limits, or inspections complete and does not create compliance, aircraft, or workpack rows.
    </p>
  </section>

  <section class="mt-8 rounded-xl border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900">Installation History</h2>
    <% if (!installationHistory || installationHistory.length === 0) { %>
      <p class="mt-4 text-sm text-slate-500">No installation history recorded.</p>
    <% } else { %>
      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Aircraft</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Position</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Installed</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Removed</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Install TSN</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Install TSO</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Removal TSN</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Removal TSO</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% installationHistory.forEach((installation) => { %>
              <% const aircraft = installation.Aircraft; %>
              <tr>
                <td class="px-3 py-2 text-sm text-slate-700"><%= aircraft?.registration || '-' %><div class="text-xs text-slate-500"><%= aircraft?.serial_number || '-' %></div></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= installation.position || '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= installation.installed_at || '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= installation.removed_at || 'Active' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= installation.install_tsn ?? '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= installation.install_tso ?? '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= installation.removal_tsn ?? '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= installation.removal_tso ?? '-' %></td>
                <td class="px-3 py-2 whitespace-pre-wrap text-sm text-slate-700"><%= installation.notes || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="mt-8 rounded-xl border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900">Current Life State</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">TSN</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.tsn_hours ?? '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">TSO</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.tso_hours ?? '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">CSN</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.csn_cycles ?? '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">CSO</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.cso_cycles ?? '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Overhaul Reference Date</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.overhaul_reference_date ?? '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Calendar Reference Date</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.calendar_reference_date ?? '-' %></p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Updated Date</p>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= lifeState?.updated_at || lifeState?.updatedAt || '-' %></p>
      </div>
    </div>
  </section>

  <section class="mt-8 rounded-xl border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900">Life Adjustment History</h2>
    <% if (!lifeAdjustmentEvents || lifeAdjustmentEvents.length === 0) { %>
      <p class="mt-4 text-sm text-slate-500">No life adjustment events recorded.</p>
    <% } else { %>
      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Occurred</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Recorded By</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% lifeAdjustmentEvents.forEach((event) => { %>
              <% const recorder = event.Recorder; %>
              <% const formattedNotes = parseMaintenanceEventNotes(event.notes); %>
              <tr>
                <td class="px-3 py-2 text-sm text-slate-700"><%= event.occurred_at || '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= recorder?.full_name || recorder?.email || '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700">
                  <% if (formattedNotes.textLines.length > 0) { %>
                    <div class="whitespace-pre-wrap"><%= formattedNotes.textLines.join('\n') %></div>
                  <% } else { %>
                    <div>-</div>
                  <% } %>

                  <% if (formattedNotes.before || formattedNotes.after || formattedNotes.warnings.length > 0) { %>
                    <div class="mt-3 grid gap-3 lg:grid-cols-2">
                      <% if (formattedNotes.before) { %>
                        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                          <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Before</p>
                          <dl class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
                            <% lifeStateDisplayFields.forEach(([key, label]) => { %>
                              <dt class="font-bold text-slate-500"><%= label %></dt>
                              <dd class="font-semibold text-slate-900"><%= displayLifeStateValue(formattedNotes.before[key]) %></dd>
                            <% }) %>
                          </dl>
                        </div>
                      <% } %>

                      <% if (formattedNotes.after) { %>
                        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                          <p class="text-xs font-bold uppercase tracking-widest text-slate-500">After</p>
                          <dl class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
                            <% lifeStateDisplayFields.forEach(([key, label]) => { %>
                              <dt class="font-bold text-slate-500"><%= label %></dt>
                              <dd class="font-semibold text-slate-900"><%= displayLifeStateValue(formattedNotes.after[key]) %></dd>
                            <% }) %>
                          </dl>
                        </div>
                      <% } %>
                    </div>
                  <% } %>

                  <% if (formattedNotes.warnings.length > 0) { %>
                    <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-900">
                      <%= formattedNotes.warnings.join(' ') %>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="mt-8 rounded-xl border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900">Maintenance Events</h2>
    <% if (!maintenanceEvents || maintenanceEvents.length === 0) { %>
      <p class="mt-4 text-sm text-slate-500">No maintenance events recorded.</p>
    <% } else { %>
      <div class="mt-4 space-y-6">
        <% (maintenanceEventGroups || []).forEach((group) => { %>
          <div class="rounded-lg border border-slate-200">
            <div class="flex flex-col gap-1 border-b border-slate-200 bg-slate-50 px-4 py-3 md:flex-row md:items-center md:justify-between">
              <h3 class="text-sm font-bold text-slate-900"><%= group.title %></h3>
              <p class="text-xs font-semibold uppercase tracking-widest text-slate-500"><%= group.events.length %> events</p>
            </div>

            <% if (!group.events || group.events.length === 0) { %>
              <p class="px-4 py-3 text-sm text-slate-500">No events in this group.</p>
            <% } else { %>
              <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                  <thead class="bg-white">
                    <tr>
                      <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Type</th>
                      <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Occurred</th>
                      <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Recorded By</th>
                      <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Notes</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 bg-white">
                    <% group.events.forEach((event) => { %>
                      <% const recorder = event.Recorder; %>
                      <% const formattedNotes = parseMaintenanceEventNotes(event.notes); %>
                      <tr>
                        <td class="px-3 py-2 text-sm font-semibold text-slate-900"><%= event.event_type || '-' %></td>
                        <td class="px-3 py-2 text-sm text-slate-700"><%= event.occurred_at || '-' %></td>
                        <td class="px-3 py-2 text-sm text-slate-700"><%= recorder?.full_name || recorder?.email || '-' %></td>
                        <td class="px-3 py-2 text-sm text-slate-700">
                          <% if (formattedNotes.textLines.length > 0) { %>
                            <div class="whitespace-pre-wrap"><%= formattedNotes.textLines.join('\n') %></div>
                          <% } else { %>
                            <div>-</div>
                          <% } %>

                          <% if (formattedNotes.before || formattedNotes.after || formattedNotes.warnings.length > 0) { %>
                            <div class="mt-3 grid gap-3 lg:grid-cols-2">
                              <% if (formattedNotes.before) { %>
                                <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                                  <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Before</p>
                                  <dl class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
                                    <% lifeStateDisplayFields.forEach(([key, label]) => { %>
                                      <dt class="font-bold text-slate-500"><%= label %></dt>
                                      <dd class="font-semibold text-slate-900"><%= displayLifeStateValue(formattedNotes.before[key]) %></dd>
                                    <% }) %>
                                  </dl>
                                </div>
                              <% } %>

                              <% if (formattedNotes.after) { %>
                                <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                                  <p class="text-xs font-bold uppercase tracking-widest text-slate-500">After</p>
                                  <dl class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
                                    <% lifeStateDisplayFields.forEach(([key, label]) => { %>
                                      <dt class="font-bold text-slate-500"><%= label %></dt>
                                      <dd class="font-semibold text-slate-900"><%= displayLifeStateValue(formattedNotes.after[key]) %></dd>
                                    <% }) %>
                                  </dl>
                                </div>
                              <% } %>
                            </div>
                          <% } %>

                          <% if (formattedNotes.warnings.length > 0) { %>
                            <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-900">
                              <%= formattedNotes.warnings.join(' ') %>
                            </div>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="mt-8 rounded-xl border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900">Component Life Limits</h2>
    <% if (!lifeLimits || lifeLimits.length === 0) { %>
      <p class="mt-4 text-sm text-slate-500">No life limits defined</p>
    <% } else { %>
      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Limit Type</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Basis</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Hours</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Cycles</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Months</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Active</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Description</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% lifeLimits.forEach((limit) => { %>
              <tr>
                <td class="px-3 py-2 text-sm font-semibold text-slate-900"><%= limit.limit_type || '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= limit.basis || '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= limit.limit_hours ?? '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= limit.limit_cycles ?? '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= limit.limit_months ?? '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= limit.is_active ? 'Yes' : 'No' %></td>
                <td class="px-3 py-2 whitespace-pre-wrap text-sm text-slate-700"><%= limit.description || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="mt-8 rounded-xl border border-amber-200 bg-amber-50 p-6 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900">Due Status</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div class="rounded-lg border border-amber-200 bg-white p-4">
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Aggregate Status</p>
        <p class="mt-2 text-2xl font-black tracking-tight text-slate-900"><%= dueStatus.state %></p>
      </div>
      <div class="rounded-lg border border-amber-200 bg-white p-4 md:col-span-2">
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Worst Limiting Item</p>
        <% if (dueStatus.worstLimit) { %>
          <p class="mt-2 text-sm font-semibold text-slate-900">
            <%= dueStatus.worstLimit.limit_type || 'Life limit' %>
            <span class="text-slate-500">(<%= dueStatus.worstLimit.normalized_basis || dueStatus.worstLimit.basis || '-' %>)</span>
          </p>
          <p class="mt-1 text-sm text-slate-700">
            Status <%= dueStatus.worstLimit.status %>
          </p>
        <% } else { %>
          <p class="mt-2 text-sm font-semibold text-slate-900">No limiting item available</p>
        <% } %>
      </div>
    </div>
    <p class="mt-4 text-sm font-semibold text-amber-900"><%= dueStatus.explanation %></p>
    <% if (dueStatus.is_partial) { %>
      <p class="mt-2 rounded-lg border border-amber-300 bg-white px-3 py-2 text-sm font-semibold text-amber-900">
        Partial calculation: at least one active limit could not be calculated from current data.
      </p>
    <% } %>

    <% if (dueStatus.evaluatedLimits && dueStatus.evaluatedLimits.length > 0) { %>
      <div class="mt-5 overflow-x-auto">
        <table class="min-w-full divide-y divide-amber-200">
          <thead class="bg-white">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Limit</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Basis</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Status</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Hours Rem.</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Cycles Rem.</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Calendar Rem.</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Due Date</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Reason</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-amber-100 bg-white">
            <% dueStatus.evaluatedLimits.forEach((limit) => { %>
              <tr>
                <td class="px-3 py-2 text-sm font-semibold text-slate-900"><%= limit.limit_type || '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700">
                  <%= limit.normalized_basis || '-' %>
                  <div class="text-xs text-slate-500"><%= limit.basis || '-' %></div>
                </td>
                <td class="px-3 py-2 text-sm font-semibold text-slate-900"><%= limit.status || 'UNKNOWN' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= limit.remaining_hours ?? '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= limit.remaining_cycles ?? '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= limit.remaining_calendar_days ?? '-' %></td>
                <td class="px-3 py-2 text-sm text-slate-700"><%= limit.due_date || '-' %></td>
                <td class="px-3 py-2 whitespace-pre-wrap text-sm text-slate-700"><%= (limit.missing_reasons || []).join('\\n') || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>
