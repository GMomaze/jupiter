<%- include('../../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-6 space-y-8">
  <div class="flex items-center justify-between gap-4">
    <div>
      <a href="/library" class="text-sm text-blue-600 hover:underline">Back to Library</a>
      <h1 class="mt-3 text-3xl font-bold text-slate-900">Airworthiness Directives</h1>
      <p class="mt-2 text-sm text-slate-500">
        Admin view of AD records stored in <code>airworthiness_directives</code>.
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <a
        href="/library/ads/applicability-review"
        class="rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100"
      >
        Applicability Review
      </a>
      <a
        href="/library/ads/new"
        class="rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100"
      >
        Add New AD
      </a>
      <a
        href="/library/ads/import"
        class="rounded bg-slate-800 px-4 py-2 text-sm font-bold text-white hover:bg-black"
      >
        Import ADs
      </a>
    </div>
  </div>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold text-slate-900">AD Library</h2>
        <p class="mt-1 text-sm text-slate-500">
          Showing directive identity, applicability, status, and created timestamp.
        </p>
      </div>
      <div class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-xs font-bold uppercase tracking-widest text-blue-700">
        <%= directives.length %> AD Records
      </div>
    </div>

    <% if (!directives.length) { %>
      <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 px-6 py-10 text-center">
        <p class="text-sm font-semibold text-slate-700">No airworthiness directives exist yet.</p>
        <p class="mt-2 text-sm text-slate-500">
          Use manual create or the AD import flow to add directive records.
        </p>
      </div>
    <% } else { %>
      <div class="mt-6 overflow-x-auto rounded-lg border">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">AD Number</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Revision</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Subject Heading</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Status</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Effective Date</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Authority</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Make</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Model</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Product Type</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Product Subtype</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">SB References</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Matched</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Unresolved</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Ignored</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Active</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Created</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% directives.forEach((directive) => { %>
              <tr>
                <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900">
                  <%= directive.ad_number || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.revision || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-sm text-slate-700">
                  <%= directive.subject_heading || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.status || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.effective_date || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.authority || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.make || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.model || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.product_type || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.product_subtype || '-' %>
                </td>
                <td class="px-3 py-3 align-top text-xs font-semibold text-slate-900">
                  <%= directive.sb_reference_count || 0 %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.sb_reference_matched_count || 0 %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.sb_reference_unresolved_count || 0 %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.sb_reference_ignored_count || 0 %>
                </td>
                <td class="px-3 py-3 align-top">
                  <% if (directive.is_active) { %>
                    <span class="inline-flex rounded-full bg-emerald-100 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-800">
                      Active
                    </span>
                  <% } else { %>
                    <span class="inline-flex rounded-full bg-slate-200 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-700">
                      Inactive
                    </span>
                  <% } %>
                </td>
                <td class="px-3 py-3 align-top text-xs text-slate-700">
                  <%= directive.created_at ? new Date(directive.created_at).toLocaleString() : '-' %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../../partials/footer') %>
