<%- include('../../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-6 space-y-8">
  <div class="flex items-center justify-between gap-4">
    <div>
      <a href="/library/ads/import" class="text-sm text-blue-600 hover:underline">Import Another AD File</a>
      <h1 class="mt-3 text-3xl font-bold text-slate-900">AD Import Result</h1>
      <p class="mt-2 text-sm text-slate-500">
        Import result for <span class="font-semibold text-slate-700"><%= fileName %></span>.
      </p>
    </div>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-6">
    <div class="rounded-xl border bg-white p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Total Rows</div>
      <div class="mt-2 text-2xl font-black text-slate-900"><%= result.totalRowsProcessed %></div>
    </div>
    <div class="rounded-xl border bg-slate-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Valid Rows</div>
      <div class="mt-2 text-2xl font-black text-slate-900"><%= result.totalValidRows %></div>
    </div>
    <div class="rounded-xl border bg-emerald-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-emerald-700">Inserted ADs</div>
      <div class="mt-2 text-2xl font-black text-emerald-800"><%= result.totalInsertedAds %></div>
    </div>
    <div class="rounded-xl border bg-blue-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-blue-700">Relationship Rows</div>
      <div class="mt-2 text-2xl font-black text-blue-800"><%= result.totalRelationshipRowsInserted %></div>
    </div>
    <div class="rounded-xl border bg-rose-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-rose-700">Skipped Invalid</div>
      <div class="mt-2 text-2xl font-black text-rose-800"><%= result.totalSkippedInvalid %></div>
    </div>
    <div class="rounded-xl border bg-amber-50 p-4 shadow-sm">
      <div class="text-[10px] font-bold uppercase tracking-widest text-amber-700">Skipped Duplicate</div>
      <div class="mt-2 text-2xl font-black text-amber-800"><%= result.totalSkippedDuplicate %></div>
    </div>
  </section>

  <section class="rounded-xl border bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h2 class="text-lg font-bold text-slate-900">Per-Row Results</h2>
        <p class="mt-1 text-sm text-slate-500">
          Invalid rows were skipped. Existing duplicates were not overwritten.
        </p>
      </div>

      <div class="flex flex-col gap-2 sm:flex-row sm:items-end">
        <label class="text-xs font-bold uppercase tracking-widest text-slate-500">
          Find AD number
          <input
            id="ad-import-find-input"
            type="search"
            placeholder="Find AD number..."
            class="mt-1 w-full rounded border px-3 py-2 text-sm normal-case tracking-normal text-slate-900 sm:w-64"
          >
        </label>
        <button
          id="ad-import-find-button"
          type="button"
          class="rounded bg-slate-800 px-4 py-2 text-sm font-bold text-white hover:bg-slate-900"
        >
          Find
        </button>
      </div>
    </div>
    <p id="ad-import-find-message" class="mt-3 hidden text-sm font-semibold text-rose-700">No matching AD found.</p>

    <% if (!result.rows.length) { %>
      <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 px-4 py-6 text-sm text-slate-500">
        No rows were processed.
      </div>
    <% } else { %>
      <div class="mt-4 overflow-x-auto rounded-lg border">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Row</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">AD Number</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Subject</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Result</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Relationship Rows</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Reason</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% result.rows.forEach((row) => { %>
              <tr id="ad-import-row-<%= row.rowNumber %>" data-ad-number="<%= row.adNumber || '' %>">
                <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900"><%= row.rowNumber %></td>
                <td class="px-3 py-3 align-top text-sm font-semibold text-slate-900"><%= row.adNumber || '-' %></td>
                <td class="px-3 py-3 align-top text-sm text-slate-700"><%= row.subject || '-' %></td>
                <td class="px-3 py-3 align-top text-xs font-bold">
                  <% if (row.status === 'INSERTED') { %>
                    <span class="text-emerald-700"><%= row.status %></span>
                  <% } else if (row.status === 'SKIPPED - DUPLICATE') { %>
                    <span class="text-amber-700"><%= row.status %></span>
                  <% } else { %>
                    <span class="text-rose-700"><%= row.status %></span>
                  <% } %>
                </td>
                <td class="px-3 py-3 align-top text-sm text-slate-700"><%= row.relationshipRowsInserted %></td>
                <td class="px-3 py-3 align-top text-xs text-slate-700"><%= row.reason %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<script>
  (() => {
    const input = document.getElementById('ad-import-find-input');
    const button = document.getElementById('ad-import-find-button');
    const message = document.getElementById('ad-import-find-message');
    const rows = Array.from(document.querySelectorAll('[data-ad-number]'));

    if (!input || !button || !message || !rows.length) {
      return;
    }

    let highlightedRow = null;

    const clearHighlight = () => {
      if (!highlightedRow) {
        return;
      }
      highlightedRow.classList.remove('bg-blue-50', 'ring-2', 'ring-blue-300');
      highlightedRow = null;
    };

    const findRow = () => {
      const query = input.value.trim().toLowerCase();
      clearHighlight();
      message.classList.add('hidden');

      if (!query) {
        return;
      }

      const match = rows.find((row) =>
        String(row.dataset.adNumber || '').toLowerCase().includes(query)
      );

      if (!match) {
        message.classList.remove('hidden');
        return;
      }

      highlightedRow = match;
      highlightedRow.classList.add('bg-blue-50', 'ring-2', 'ring-blue-300');
      highlightedRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    button.addEventListener('click', findRow);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        findRow();
      }
    });
  })();
</script>

<%- include('../../partials/footer') %>
