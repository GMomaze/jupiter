<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <% const summary = report.summary || {}; %>
  <% const categoryCounts = report.category_counts || {}; %>
  <% const warnings = Array.isArray(report.warnings) ? report.warnings : []; %>
  <% const blockers = Array.isArray(report.blockers) ? report.blockers : []; %>

  <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">
        Read-Only Report
      </p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">
        Migration Dry Run
      </h1>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">
        Previews legacy aircraft component migration candidates using the unsaved dry-run engine.
        This page is GET-only and does not persist batches, ledger rows, lifecycle records, or target records.
      </p>
    </div>
    <a href="/library" class="inline-flex items-center justify-center rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">
      Back to Library
    </a>
  </div>

  <section class="mb-6 rounded border border-amber-200 bg-amber-50 p-4">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.25em] text-amber-700">
          Read-Only Boundary
        </p>
        <p class="mt-1 text-sm font-semibold text-amber-900">
          Mode: <%= report.mode || 'UNSAVED_DRY_RUN' %>
        </p>
      </div>
      <p class="text-xs font-bold text-amber-800">
        Generated at <%= report.generated_at || '-' %>
      </p>
    </div>
    <form method="post" action="/library/serialized-components/migration-dry-run/save" class="mt-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="aircraft_id" value="<%= filters.aircraft_id %>">
      <input type="hidden" name="category" value="<%= filters.category %>">
      <input type="hidden" name="readiness" value="<%= filters.readiness %>">
      <% if (filters.include_removed) { %>
        <input type="hidden" name="include_removed" value="on">
      <% } %>
      <% if (filters.include_quarantined) { %>
        <input type="hidden" name="include_quarantined" value="on">
      <% } %>
      <% if (filters.include_historical) { %>
        <input type="hidden" name="include_historical" value="on">
      <% } %>
      <button type="submit" class="inline-flex rounded border border-amber-300 bg-white px-4 py-2 text-sm font-bold text-amber-900 hover:bg-amber-100">
        Save Dry Run
      </button>
    </form>
  </section>

  <section class="mb-6 rounded border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-4">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">GET Filters</p>
      <h2 class="mt-1 text-xl font-black text-slate-900">Report Scope</h2>
    </div>

    <form method="get" class="grid grid-cols-1 gap-4 lg:grid-cols-6">
      <label class="block">
        <span class="text-xs font-black uppercase tracking-[0.18em] text-slate-500">Aircraft ID</span>
        <input name="aircraft_id" value="<%= filters.aircraft_id %>" class="mt-1 w-full rounded border border-slate-300 px-3 py-2 text-sm text-slate-800" placeholder="Optional aircraft id">
      </label>

      <label class="block">
        <span class="text-xs font-black uppercase tracking-[0.18em] text-slate-500">Category</span>
        <select name="category" class="mt-1 w-full rounded border border-slate-300 px-3 py-2 text-sm text-slate-800">
          <option value="">All categories</option>
          <% categoryOptions.forEach((category) => { %>
            <option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option>
          <% }) %>
        </select>
      </label>

      <label class="block">
        <span class="text-xs font-black uppercase tracking-[0.18em] text-slate-500">Readiness</span>
        <select name="readiness" class="mt-1 w-full rounded border border-slate-300 px-3 py-2 text-sm text-slate-800">
          <option value="">All readiness</option>
          <% readinessOptions.forEach((option) => { %>
            <option value="<%= option %>" <%= filters.readiness === option ? 'selected' : '' %>><%= option %></option>
          <% }) %>
        </select>
      </label>

      <label class="flex items-end gap-2 rounded border border-slate-200 bg-slate-50 px-3 py-2">
        <input type="checkbox" name="include_removed" <%= filters.include_removed ? 'checked' : '' %>>
        <span class="text-sm font-semibold text-slate-700">Include removed</span>
      </label>

      <label class="flex items-end gap-2 rounded border border-slate-200 bg-slate-50 px-3 py-2">
        <input type="checkbox" name="include_quarantined" <%= filters.include_quarantined ? 'checked' : '' %>>
        <span class="text-sm font-semibold text-slate-700">Include quarantined</span>
      </label>

      <label class="flex items-end gap-2 rounded border border-slate-200 bg-slate-50 px-3 py-2">
        <input type="checkbox" name="include_historical" <%= filters.include_historical ? 'checked' : '' %>>
        <span class="text-sm font-semibold text-slate-700">Include historical</span>
      </label>

      <div class="lg:col-span-6 flex flex-wrap gap-3">
        <button type="submit" class="inline-flex rounded border border-slate-300 bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-slate-700">
          Apply Filters
        </button>
        <a href="/library/serialized-components/migration-dry-run" class="inline-flex rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">
          Clear Filters
        </a>
      </div>
    </form>
  </section>

  <section class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Source Rows</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= summary.source_rows_evaluated || 0 %></p>
      <p class="mt-1 text-xs text-slate-500">Displayed: <%= rows.length %> of <%= totalRows %></p>
    </article>
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Readiness Score</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= report.readiness_score || 0 %>%</p>
      <p class="mt-1 text-xs text-slate-500">AUTO_MIGRATE share excluding SKIP</p>
    </article>
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Warnings</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= warnings.length %></p>
      <p class="mt-1 text-xs text-slate-500">Preview warnings</p>
    </article>
    <article class="rounded border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Blockers</p>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= blockers.length %></p>
      <p class="mt-1 text-xs text-slate-500">Rows needing resolution</p>
    </article>
  </section>

  <section class="mb-6 rounded border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-4">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">Category Counts</p>
      <h2 class="mt-1 text-xl font-black text-slate-900">Dry Run Categories</h2>
    </div>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
      <% categoryOptions.forEach((category) => { %>
        <div class="rounded border border-slate-200 bg-slate-50 p-3">
          <p class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500"><%= category %></p>
          <p class="mt-2 text-2xl font-black text-slate-900"><%= categoryCounts[category] || 0 %></p>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="mb-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
    <article class="rounded border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">Warnings Summary</p>
      <% if (warnings.length === 0) { %>
        <p class="mt-3 text-sm font-semibold text-slate-600">No warnings reported.</p>
      <% } else { %>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
          <% warnings.slice(0, 10).forEach((item) => { %>
            <li class="rounded border border-slate-100 bg-slate-50 p-2">
              <span class="font-bold"><%= item.source_row_id %>:</span> <%= item.warning %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </article>

    <article class="rounded border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">Blockers Summary</p>
      <% if (blockers.length === 0) { %>
        <p class="mt-3 text-sm font-semibold text-slate-600">No blockers reported.</p>
      <% } else { %>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
          <% blockers.slice(0, 10).forEach((item) => { %>
            <li class="rounded border border-slate-100 bg-slate-50 p-2">
              <span class="font-bold"><%= item.source_row_id %>:</span> <%= item.blocker %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </article>
  </section>

  <section class="rounded border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 p-5">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-slate-500">Detailed Rows</p>
      <h2 class="mt-1 text-xl font-black text-slate-900">Source Rows and Proposed Preview Actions</h2>
    </div>

    <% if (rows.length === 0) { %>
      <div class="p-6 text-sm font-semibold text-slate-600">
        No legacy aircraft component rows matched this dry-run scope.
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Source</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Component</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Install</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Life State</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Event</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Category</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Warnings / Blockers</th>
              <th class="px-3 py-3 text-left text-xs font-black uppercase tracking-[0.18em] text-slate-500">Idempotency</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% rows.forEach((row) => { %>
              <% const source = row.source || {}; %>
              <tr>
                <td class="px-3 py-3 text-slate-700">
                  <div class="font-bold text-slate-900"><%= source.aircraft_registration || '-' %></div>
                  <div>ID: <%= source.id || '-' %></div>
                  <div>Status: <%= source.current_status || '-' %></div>
                  <div>Position: <%= source.position_code || '-' %></div>
                </td>
                <td class="px-3 py-3 text-slate-700">
                  <div class="font-bold"><%= row.proposed_serialized_component?.action || 'NONE' %></div>
                  <div><%= source.model_code || '-' %></div>
                  <div><%= source.model_name || '-' %></div>
                  <div>Serial: <%= source.serial_number || '-' %></div>
                </td>
                <td class="px-3 py-3 text-slate-700">
                  <div class="font-bold"><%= row.proposed_installation?.action || 'NONE' %></div>
                  <div>Installed: <%= row.proposed_installation?.installed_at || '-' %></div>
                  <div>Removed: <%= row.proposed_installation?.removed_at || '-' %></div>
                  <div>TSN/TSO: <%= row.proposed_installation?.install_tsn ?? '-' %> / <%= row.proposed_installation?.install_tso ?? '-' %></div>
                </td>
                <td class="px-3 py-3 text-slate-700">
                  <div class="font-bold"><%= row.proposed_life_state?.action || 'NONE' %></div>
                  <div>TSN: <%= row.proposed_life_state?.tsn_hours ?? '-' %></div>
                  <div>TSO: <%= row.proposed_life_state?.tso_hours ?? '-' %></div>
                  <div>CSN/CSO: <%= row.proposed_life_state?.csn_cycles ?? '-' %> / <%= row.proposed_life_state?.cso_cycles ?? '-' %></div>
                </td>
                <td class="px-3 py-3 text-slate-700">
                  <div class="font-bold"><%= row.proposed_maintenance_event?.action || 'NONE' %></div>
                  <div><%= row.proposed_maintenance_event?.event_type || '-' %></div>
                </td>
                <td class="px-3 py-3">
                  <span class="inline-flex rounded bg-slate-100 px-2 py-1 text-xs font-black text-slate-700">
                    <%= row.migration_category %>
                  </span>
                  <div class="mt-2 text-xs font-semibold text-slate-500">Confidence: <%= row.confidence || 'NONE' %></div>
                </td>
                <td class="px-3 py-3 text-slate-700">
                  <% if (Array.isArray(row.warnings) && row.warnings.length > 0) { %>
                    <div class="font-bold text-amber-700">Warnings</div>
                    <div><%= row.warnings.join('; ') %></div>
                  <% } %>
                  <% if (Array.isArray(row.blockers) && row.blockers.length > 0) { %>
                    <div class="mt-2 font-bold text-red-700">Blockers</div>
                    <div><%= row.blockers.join('; ') %></div>
                  <% } %>
                  <% if ((!Array.isArray(row.warnings) || row.warnings.length === 0) && (!Array.isArray(row.blockers) || row.blockers.length === 0)) { %>
                    -
                  <% } %>
                </td>
                <td class="px-3 py-3 text-slate-700">
                  <div><%= row.idempotency?.status || '-' %></div>
                  <% if (row.reconciliation) { %>
                    <div class="mt-2 text-xs text-slate-500">
                      Reconciliation: <%= row.reconciliation.bucket || '-' %>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>
