<%- include('../partials/header') %>

<main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-10">
    <h1 class="text-4xl font-black text-slate-900 tracking-tight">
      Maintenance Library
    </h1>
    <p class="text-xs font-bold text-slate-500 tracking-[0.2em] uppercase mt-2">
      Reference Data & Regulatory Documentation
    </p>
  </div>

  <section class="mb-8 rounded-xl border border-slate-200 bg-slate-50 p-6">
    <h2 class="text-sm font-black uppercase tracking-[0.2em] text-slate-700">
      Component Management
    </h2>
    <p class="mt-2 text-sm text-slate-500">
      Restore direct visibility for component manufacturers, models, and serialized component records.
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <a href="/library/manufacturers" class="inline-flex rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">
        Component Manufacturers / Models
      </a>
      <a href="/library/models/import" class="inline-flex rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">
        Generic Model Import
      </a>
      <a href="/library/serialized-components" class="inline-flex rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">
        Serialized Components
      </a>
      <a href="/library/serialized-components/reconciliation" class="inline-flex rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">
        Serialized Reconciliation
      </a>
      <a href="/library/serialized-components/migration-dry-run" class="inline-flex rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">
        Migration Dry Run
      </a>
      <a href="/library/serialized-components/create" class="inline-flex rounded border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 hover:bg-slate-100">
        Create Serialized Component
      </a>
    </div>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">

    <!-- AIRWORTHINESS DIRECTIVES (ADs) -->
    <section class="bg-white p-6 border-t-4 border-blue-500 rounded shadow-sm hover:shadow-md transition-shadow">
      <h2 class="font-black mb-2 text-slate-900 uppercase text-sm tracking-tight">
        Airworthiness Directives
      </h2>
      <p class="text-xs text-slate-600 mb-4 leading-relaxed">
        FAA-issued mandatory safety requirements. May apply to aircraft, engines, propellers, or components.
      </p>
      
      <!-- Status Placeholder -->
      <div class="bg-blue-50 border border-blue-200 rounded p-3 mb-4 text-center">
        <p class="text-xs font-bold text-blue-700 uppercase tracking-wider">
          0 directives loaded
        </p>
        <p class="text-[10px] text-blue-600 mt-1">
          Ready to import
        </p>
      </div>
      
      <div class="space-y-2">
        <a href="/library/ads/import" class="block w-full py-2 px-3 text-center text-xs font-bold uppercase bg-blue-50 text-blue-700 border border-blue-200 rounded hover:bg-blue-100 transition-colors">
          Import ADs
        </a>
        <a href="/library/ads" class="block w-full py-2 px-3 text-center text-xs font-bold uppercase bg-blue-50 text-blue-700 border border-blue-200 rounded hover:bg-blue-100 transition-colors">
          View ADs
        </a>
        <button class="w-full py-2 px-3 text-xs font-bold uppercase bg-blue-50 text-blue-700 border border-blue-200 rounded hover:bg-blue-100 transition-colors disabled:opacity-50 cursor-not-allowed" disabled>
          Manage ADs
        </button>
      </div>
    </section>

    <!-- SERVICE BULLETINS (SBs) -->
    <section class="bg-white p-6 border-t-4 border-green-500 rounded shadow-sm hover:shadow-md transition-shadow">
      <h2 class="font-black mb-2 text-slate-900 uppercase text-sm tracking-tight">
        Service Bulletins
      </h2>
      <p class="text-xs text-slate-600 mb-4 leading-relaxed">
        Manufacturer-issued service instructions. Vary by manufacturer and aircraft/component model.
      </p>
      
      <!-- Status Placeholder -->
      <div class="bg-green-50 border border-green-200 rounded p-3 mb-4 text-center">
        <p class="text-xs font-bold text-green-700 uppercase tracking-wider">
          0 bulletins loaded
        </p>
        <p class="text-[10px] text-green-600 mt-1">
          Ready to import
        </p>
      </div>
      
      <div class="space-y-2">
        <a href="/library/sbs/import" class="block w-full py-2 px-3 text-center text-xs font-bold uppercase bg-green-50 text-green-700 border border-green-200 rounded hover:bg-green-100 transition-colors">
          Import SBs
        </a>
        <a href="/library/sbs" class="block w-full py-2 px-3 text-center text-xs font-bold uppercase bg-green-50 text-green-700 border border-green-200 rounded hover:bg-green-100 transition-colors">
          View SBs
        </a>
        <a href="/library/sbs/import-issues/unallocated-models" class="block w-full py-2 px-3 text-center text-xs font-bold uppercase bg-green-50 text-green-700 border border-green-200 rounded hover:bg-green-100 transition-colors">
          SB Import Issues
        </a>
      </div>
    </section>

    <!-- COMPLIANCE PROJECTIONS -->
    <section class="bg-white p-6 border-t-4 border-slate-500 rounded shadow-sm hover:shadow-md transition-shadow">
      <h2 class="font-black mb-2 text-slate-900 uppercase text-sm tracking-tight">
        Compliance Items
      </h2>
      <p class="text-xs text-slate-600 mb-4 leading-relaxed">
        Read-only view of projected operational compliance records derived from AD and SB source data.
      </p>
      
      <div class="bg-slate-50 border border-slate-200 rounded p-3 mb-4 text-center">
        <p class="text-xs font-bold text-slate-700 uppercase tracking-wider">
          Projection visibility only
        </p>
        <p class="text-[10px] text-slate-600 mt-1">
          Read-only compliance list
        </p>
      </div>
      
      <div class="space-y-2">
        <a href="/library/compliance" class="block w-full py-2 px-3 text-center text-xs font-bold uppercase bg-slate-50 text-slate-700 border border-slate-200 rounded hover:bg-slate-100 transition-colors">
          View Compliance
        </a>
        <button class="w-full py-2 px-3 text-xs font-bold uppercase bg-slate-50 text-slate-700 border border-slate-200 rounded hover:bg-slate-100 transition-colors disabled:opacity-50 cursor-not-allowed" disabled>
          Read-Only List
        </button>
        <button class="w-full py-2 px-3 text-xs font-bold uppercase bg-slate-50 text-slate-700 border border-slate-200 rounded hover:bg-slate-100 transition-colors disabled:opacity-50 cursor-not-allowed" disabled>
          No Actions Here
        </button>
      </div>
    </section>

    <!-- SUPPLEMENTAL INSPECTION DOCUMENTS (SIDs) -->
    <section class="bg-white p-6 border-t-4 border-purple-500 rounded shadow-sm hover:shadow-md transition-shadow">
      <h2 class="font-black mb-2 text-slate-900 uppercase text-sm tracking-tight">
        Supplemental Inspection Documents
      </h2>
      <p class="text-xs text-slate-600 mb-4 leading-relaxed">
        Structured inspection requirements. May apply across model variants and component types.
      </p>
      
      <!-- Status Placeholder -->
      <div class="bg-purple-50 border border-purple-200 rounded p-3 mb-4 text-center">
        <p class="text-xs font-bold text-purple-700 uppercase tracking-wider">
          0 documents loaded
        </p>
        <p class="text-[10px] text-purple-600 mt-1">
          Ready to import
        </p>
      </div>
      
      <div class="space-y-2">
        <button class="w-full py-2 px-3 text-xs font-bold uppercase bg-purple-50 text-purple-700 border border-purple-200 rounded hover:bg-purple-100 transition-colors disabled:opacity-50 cursor-not-allowed" disabled>
          Import SIDs
        </button>
        <a href="/library/sids" class="block w-full py-2 px-3 text-center text-xs font-bold uppercase bg-purple-50 text-purple-700 border border-purple-200 rounded hover:bg-purple-100 transition-colors">
          View SIDs
        </a>
        <button class="w-full py-2 px-3 text-xs font-bold uppercase bg-purple-50 text-purple-700 border border-purple-200 rounded hover:bg-purple-100 transition-colors disabled:opacity-50 cursor-not-allowed" disabled>
          Manage SIDs
        </button>
      </div>
    </section>

    <!-- TASK TEMPLATES -->
    <section class="bg-white p-6 border-t-4 border-orange-500 rounded shadow-sm hover:shadow-md transition-shadow">
      <h2 class="font-black mb-2 text-slate-900 uppercase text-sm tracking-tight">
        Task Templates
      </h2>
      <p class="text-xs text-slate-600 mb-4 leading-relaxed">
        Reusable maintenance tasks. Build workpacks using standardized procedures.
      </p>
      
      <!-- Status Placeholder -->
      <div class="bg-orange-50 border border-orange-200 rounded p-3 mb-4 text-center">
        <p class="text-xs font-bold text-orange-700 uppercase tracking-wider">
          0 templates available
        </p>
        <p class="text-[10px] text-orange-600 mt-1">
          Ready to import
        </p>
      </div>
      
      <div class="space-y-2">
        <a href="/library/tasks/import" class="block w-full py-2 px-3 text-center text-xs font-bold uppercase bg-orange-50 text-orange-700 border border-orange-200 rounded hover:bg-orange-100 transition-colors">
          Import Templates
        </a>
        <a href="/library/tasks" class="block w-full py-2 px-3 text-center text-xs font-bold uppercase bg-orange-50 text-orange-700 border border-orange-200 rounded hover:bg-orange-100 transition-colors">
          View Templates
        </a>
        <button class="w-full py-2 px-3 text-xs font-bold uppercase bg-orange-50 text-orange-700 border border-orange-200 rounded hover:bg-orange-100 transition-colors disabled:opacity-50 cursor-not-allowed" disabled>
          Manage Templates
        </button>
      </div>
    </section>

  </div>

</main>

<%- include('../partials/footer') %>
