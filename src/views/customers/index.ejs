<%- include('../partials/header') %>

<main class="max-w-6xl mx-auto py-10 px-6">
  <div class="mb-8 flex items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-black text-slate-900">Customers</h1>
      <p class="mt-2 text-sm text-slate-500">
        Maintain customer master records before linking aircraft ownership.
      </p>
    </div>
    <a
      href="/customers/create"
      class="rounded bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700"
    >
      + Add Customer
    </a>
  </div>

  <% if (messages && messages.success && messages.success.length) { %>
    <div class="mb-6 rounded border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      <%= messages.success[0] %>
    </div>
  <% } %>

  <div class="overflow-hidden rounded-lg bg-white shadow">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Customer</th>
          <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Contact Person</th>
          <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Email</th>
          <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Phone</th>
          <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-widest text-slate-500">Status</th>
          <th class="px-6 py-3 text-right text-xs font-bold uppercase tracking-widest text-slate-500">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        <% if (!customers || customers.length === 0) { %>
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-sm text-slate-500">
              No customers have been created yet.
            </td>
          </tr>
        <% } %>

        <% customers.forEach((customer) => { %>
          <tr class="hover:bg-slate-50">
            <td class="px-6 py-4 text-sm font-semibold text-slate-900">
              <%= customer.name %>
            </td>
            <td class="px-6 py-4 text-sm text-slate-700">
              <%= customer.contact_person %>
            </td>
            <td class="px-6 py-4 text-sm text-slate-700">
              <%= customer.email %>
            </td>
            <td class="px-6 py-4 text-sm text-slate-700">
              <%= customer.phone %>
            </td>
            <td class="px-6 py-4 text-sm">
              <span class="rounded-full px-3 py-1 text-xs font-bold uppercase tracking-widest <%= customer.status === 'ACTIVE' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-200 text-slate-600' %>">
                <%= customer.status %>
              </span>
            </td>
            <td class="px-6 py-4 text-right">
              <a
                href="/customers/<%= customer.id %>/edit"
                class="text-sm font-bold text-blue-600 hover:underline"
              >
                Edit
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>

<%- include('../partials/footer') %>
